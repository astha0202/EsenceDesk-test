    transform:scale(.82) !important;
  }
  .hero-art .m1{left:-3% !important}
  .hero-art .m2{right:-3% !important}
  .hero-art .m3{left:1% !important;bottom:1% !important}
}

@media(max-width:520px){
  .hero-art{
    height:410px !important;
    min-height:410px !important;
  }
  .hero-art .floating-mini{transform:scale(.72) !important}
  .hero-art .m1{left:-7% !important}
  .hero-art .m2{right:-7% !important}
}


/* =========================================================
   GLOBAL LANGUAGE SELECTOR — 40 LANGUAGES
   ========================================================= */
.language-selector{
  position:relative !important;
  z-index:9999 !important;
  margin-right:22px !important;
}

.language-current{
  height:50px !important;
  min-width:105px !important;
  padding:0 14px !important;
  display:flex !important;
  align-items:center !important;
  justify-content:space-between !important;
  gap:9px !important;
  border:1px solid #d7e2ec !important;
  border-radius:12px !important;
  background:#fff !important;
  color:#0b1b2b !important;
  box-shadow:0 6px 20px rgba(20,55,90,.04) !important;
  font:500 11px "DM Mono",monospace !important;
  letter-spacing:.08em !important;
  cursor:pointer !important;
}

.current-lang-flag{
  font-family:"Segoe UI Emoji","Apple Color Emoji",sans-serif !important;
  font-size:17px !important;
  line-height:1 !important;
}

.language-current .lang-code{color:#0b1b2b !important}
.language-current b{color:#537089 !important;font-size:12px !important}

.language-current:hover{
  border-color:#9dbfe1 !important;
  background:#f8fbff !important;
}

.language-menu{
  position:absolute !important;
  top:calc(100% + 8px) !important;
  right:0 !important;
  width:190px !important;
  max-height:420px !important;
  overflow-y:auto !important;
  display:none !important;
  flex-direction:column !important;
  padding:6px !important;
  border:1px solid #d7e2ec !important;
  border-radius:14px !important;
  background:rgba(255,255,255,.98) !important;
  box-shadow:0 24px 60px rgba(15,45,75,.16) !important;
  backdrop-filter:blur(18px) !important;
  scrollbar-width:thin !important;
}

.language-selector.open .language-menu{
  display:flex !important;
}

.language-menu button{
  width:100% !important;
  min-height:38px !important;
  border:0 !important;
  border-radius:8px !important;
  background:transparent !important;
  color:#17334d !important;
  display:flex !important;
  align-items:center !important;
  gap:10px !important;
  padding:7px 10px !important;
  text-align:left !important;
  font:500 11px "DM Mono",monospace !important;
  letter-spacing:.04em !important;
  cursor:pointer !important;
}

.language-menu button:hover{
  background:#edf5ff !important;
  color:#155eef !important;
}

.lang-flag-emoji{
  width:24px !important;
  flex:0 0 24px !important;
  font-family:"Segoe UI Emoji","Apple Color Emoji",sans-serif !important;
  font-size:17px !important;
  line-height:1 !important;
}

.language-menu button span:last-child{
  flex:1 !important;
}

/* Google Translate generated UI stays invisible */
#google_translate_element,
.goog-te-banner-frame,
.goog-te-balloon-frame,
.goog-tooltip{
  display:none !important;
}

body{top:0 !important}

@media(max-width:1050px){
  .language-selector{margin-right:10px !important}
}


/* =========================================================
   eSENCE DESK — RESTORED GLOBAL GLOBE / NETWORK VISUAL
   Final override: full globe, visible logo, animated routes.
   ========================================================= */
.hero-art{position:relative!important;height:620px!important;min-height:620px!important;overflow:visible!important;perspective:1400px!important;isolation:isolate!important}
.hero-art .glow{position:absolute!important;z-index:0!important;width:620px!important;height:620px!important;left:50%!important;top:50%!important;transform:translate(-50%,-50%)!important;background:radial-gradient(circle,rgba(40,120,220,.16),rgba(40,120,220,.05) 42%,transparent 70%)!important;filter:blur(18px)!important}
.hero-art .world-panel{position:absolute!important;z-index:10!important;left:3%!important;right:3%!important;top:6%!important;bottom:8%!important;height:auto!important;overflow:hidden!important;border:1px solid #d3e0ec!important;border-radius:3px!important;background:linear-gradient(145deg,#fbfdff,#eef5fb)!important;box-shadow:0 32px 80px rgba(20,65,105,.14),inset 0 1px rgba(255,255,255,.96)!important;transform:rotateY(-3deg) rotateX(1deg)!important}
.hero-art .world-panel:before{content:""!important;position:absolute!important;inset:0!important;z-index:1!important;opacity:1!important;background:repeating-linear-gradient(90deg,transparent 0,transparent 79px,rgba(40,110,190,.028) 80px),repeating-linear-gradient(0deg,transparent 0,transparent 79px,rgba(40,110,190,.028) 80px)!important;pointer-events:none!important}
.hero-art .world-panel:after{content:""!important;position:absolute!important;inset:0!important;z-index:45!important;pointer-events:none!important;background:linear-gradient(110deg,transparent 32%,rgba(255,255,255,.72) 45%,transparent 58%)!important;transform:translateX(-120%)!important;animation:esenceDeskSweep 7s ease-in-out infinite!important;opacity:.7!important}
@keyframes esenceDeskSweep{0%,38%{transform:translateX(-120%)}62%,100%{transform:translateX(120%)}}
.hero-art .world-top,.hero-art .world-bottom{position:absolute!important;left:0!important;right:0!important;height:48px!important;z-index:50!important;display:flex!important;align-items:center!important;justify-content:space-between!important;padding:0 18px!important;box-sizing:border-box!important;background:rgba(248,251,254,.9)!important;color:#315676!important;border-color:#d6e2ed!important;font:500 8px "DM Mono",monospace!important;letter-spacing:.14em!important}
.hero-art .world-top{top:0!important;bottom:auto!important;border-bottom:1px solid #d6e2ed!important}
.hero-art .world-bottom{bottom:0!important;top:auto!important;border-top:1px solid #d6e2ed!important;border-bottom:0!important;justify-content:space-around!important}
.hero-art .world-top span,.hero-art .world-bottom span{color:#315676!important;opacity:1!important}
.hero-art .world-top .live{color:#1769e0!important;display:flex!important;align-items:center!important;gap:7px!important}
.hero-art .world-top .live i{width:5px!important;height:5px!important;border-radius:50%!important;background:#59c78a!important;box-shadow:0 0 10px rgba(89,199,138,.45)!important}
.hero-art .world-bottom strong{color:#1769e0!important;opacity:1!important}
.hero-art .world-map{position:absolute!important;left:0!important;right:0!important;top:48px!important;bottom:48px!important;width:auto!important;height:auto!important;overflow:hidden!important;isolation:isolate!important;background:radial-gradient(circle at 50% 50%,rgba(50,130,220,.15),transparent 48%),linear-gradient(145deg,#fafdff,#edf5fb)!important;box-shadow:inset 0 0 90px rgba(40,110,190,.055)!important}
/* Full globe */
.hero-art .world-map:before{content:""!important;position:absolute!important;width:min(64%,430px)!important;height:min(86%,430px)!important;aspect-ratio:1!important;left:50%!important;top:50%!important;transform:translate(-50%,-50%)!important;border-radius:50%!important;background:radial-gradient(circle at 33% 28%,#fff 0%,#e1f1ff 33%,#b7daf6 55%,#75afe2 72%,#4a8dca 100%)!important;border:1px solid rgba(55,125,205,.25)!important;box-shadow:inset -28px -24px 55px rgba(28,91,160,.18),inset 18px 14px 34px rgba(255,255,255,.92),0 12px 55px rgba(35,105,180,.13)!important;z-index:1!important}
/* latitude + longitude rings */
.hero-art .world-map:after{content:""!important;position:absolute!important;width:min(64%,430px)!important;height:min(86%,430px)!important;aspect-ratio:1!important;left:50%!important;top:50%!important;transform:translate(-50%,-50%)!important;border-radius:50%!important;background:repeating-radial-gradient(ellipse at 50% 50%,transparent 0,transparent 18px,rgba(35,115,200,.13) 19px,transparent 20px),repeating-linear-gradient(90deg,transparent 0,transparent 45px,rgba(35,115,200,.055) 46px,transparent 47px)!important;opacity:.9!important;z-index:2!important;pointer-events:none!important}
.hero-art .map-lines{position:absolute!important;inset:0!important;z-index:8!important;background-image:linear-gradient(rgba(35,115,200,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(35,115,200,.045) 1px,transparent 1px)!important;background-size:42px 42px!important;mask-image:radial-gradient(circle at center,#000 0 55%,transparent 78%)!important;opacity:.9!important}
.hero-art .routes{position:absolute!important;inset:0!important;width:100%!important;height:100%!important;z-index:12!important;overflow:visible!important}
.hero-art .routes path{fill:none!important;stroke:#2b78d2!important;stroke-width:1.35!important;stroke-dasharray:5 9!important;stroke-linecap:round!important;opacity:.72!important;animation:esenceRouteFlow 7s linear infinite!important}
.hero-art .routes path:nth-child(2){animation-duration:9s!important;animation-direction:reverse!important}
.hero-art .routes path:nth-child(3){animation-duration:6s!important}
@keyframes esenceRouteFlow{to{stroke-dashoffset:-280}}
.hero-art .node{position:absolute!important;z-index:16!important;width:6px!important;height:6px!important;background:#2474d3!important;border-radius:50%!important;box-shadow:0 0 0 5px rgba(36,116,211,.1),0 0 18px rgba(36,116,211,.35)!important;animation:esenceNodePulse 2.5s ease-in-out infinite!important}
@keyframes esenceNodePulse{50%{box-shadow:0 0 0 8px rgba(36,116,211,.04),0 0 24px rgba(36,116,211,.5)}}
.hero-art .city{position:absolute!important;z-index:17!important;color:#3a78b3!important;font:500 7px "DM Mono",monospace!important;letter-spacing:.08em!important;opacity:.9!important}
/* Logo stays fully inside globe */
.hero-art .center-orb{position:absolute!important;left:50%!important;top:50%!important;transform:translate(-50%,-50%)!important;width:126px!important;height:126px!important;z-index:30!important;display:grid!important;place-items:center!important;overflow:visible!important;background:rgba(255,255,255,.97)!important;border:1px solid #c8dceb!important;border-radius:50%!important;box-shadow:0 12px 34px rgba(21,94,159,.18),0 0 0 7px rgba(255,255,255,.68),0 0 0 9px rgba(45,125,210,.09)!important;animation:esenceOrbFloat 5s ease-in-out infinite!important}
@keyframes esenceOrbFloat{50%{transform:translate(-50%,-54%)}}
.hero-art .center-orb img{display:block!important;width:92px!important;height:92px!important;object-fit:contain!important;opacity:1!important;visibility:visible!important;filter:none!important}
.hero-art .floating-mini{position:absolute!important;z-index:80!important;min-width:112px!important;padding:15px 16px!important;background:rgba(255,255,255,.98)!important;color:#0b1b2d!important;border:1px solid #d5e0eb!important;border-radius:2px!important;box-shadow:0 18px 40px rgba(11,42,70,.1)!important;opacity:1!important;visibility:visible!important}
.hero-art .floating-mini b{display:block!important;color:#1769e0!important;font:700 22px/1 Manrope,sans-serif!important;letter-spacing:-.04em!important}
.hero-art .floating-mini b span{color:#1769e0!important;font-size:9px!important}
.hero-art .floating-mini>span{display:block!important;margin-top:5px!important;color:#526b83!important;font:500 7px/1.35 "DM Mono",monospace!important;letter-spacing:.1em!important}
.hero-art .m1{left:-1%!important;top:17%!important}.hero-art .m2{right:-1%!important;top:34%!important}.hero-art .m3{left:4%!important;bottom:4%!important}
@media(max-width:1100px){.hero-art{height:560px!important;min-height:560px!important}.hero-art .world-panel{left:4%!important;right:4%!important}.hero-art .world-map:before,.hero-art .world-map:after{width:min(68%,390px)!important;height:min(82%,390px)!important}}
@media(max-width:700px){.hero-art{height:470px!important;min-height:470px!important}.hero-art .world-panel{left:2%!important;right:2%!important;top:5%!important;bottom:7%!important;transform:none!important}.hero-art .center-orb{width:98px!important;height:98px!important}.hero-art .center-orb img{width:70px!important;height:70px!important}.hero-art .floating-mini{min-width:92px!important;padding:11px 12px!important;transform:scale(.82)!important}.hero-art .m1{left:-3%!important}.hero-art .m2{right:-3%!important}.hero-art .m3{left:1%!important;bottom:1%!important}}
@media(max-width:520px){.hero-art{height:420px!important;min-height:420px!important}.hero-art .floating-mini{transform:scale(.72)!important}.hero-art .m1{left:-7%!important}.hero-art .m2{right:-7%!important}}

/* 15-language selector */
.language-selector{position:relative!important;z-index:9999!important}
.language-current{height:50px!important;min-width:105px!important;padding:0 14px!important;display:flex!important;align-items:center!important;justify-content:space-between!important;gap:9px!important;border:1px solid #d7e2ec!important;border-radius:12px!important;background:#fff!important;color:#0b1b2b!important;box-shadow:0 6px 20px rgba(20,55,90,.04)!important;font:500 11px "DM Mono",monospace!important;cursor:pointer!important}
.language-current .flag-img{width:19px!important;height:13px!important;object-fit:cover!important;border-radius:2px!important}.language-current .lang-code{color:#0b1b2b!important}.language-current b{color:#537089!important}
.language-menu{position:absolute!important;top:calc(100% + 8px)!important;right:0!important;width:190px!important;max-height:420px!important;overflow-y:auto!important;display:none!important;flex-direction:column!important;padding:6px!important;border:1px solid #d7e2ec!important;border-radius:14px!important;background:rgba(255,255,255,.98)!important;box-shadow:0 24px 60px rgba(15,45,75,.16)!important;backdrop-filter:blur(18px)!important}
.language-selector.open .language-menu{display:flex!important}.language-menu button{width:100%!important;min-height:38px!important;border:0!important;border-radius:8px!important;background:transparent!important;color:#17334d!important;display:flex!important;align-items:center!important;gap:10px!important;padding:7px 10px!important;text-align:left!important;font:500 11px "DM Mono",monospace!important;cursor:pointer!important}.language-menu button:hover{background:#edf5ff!important;color:#155eef!important}.language-menu .lang-flag-img{width:24px!important;height:16px!important;object-fit:cover!important;border-radius:2px!important;flex:0 0 24px!important}

/* =========================================================
   ABOUT HERO — RIGHT COLUMN VISIBILITY
   ========================================================= */
.hero .hero-side{
  color:#17324d !important;
  opacity:1 !important;
  visibility:visible !important;
  position:relative !important;
  z-index:8 !important;
}
.hero .hero-side .eyebrow,
.hero .hero-side h3,
.hero .hero-side p{
  opacity:1 !important;
  visibility:visible !important;
  -webkit-text-fill-color:currentColor !important;
}
.hero .hero-side .eyebrow{color:#55718d !important}
.hero .hero-side h3{color:#0b1b2d !important}
.hero .hero-side p{color:#536b83 !important}


/* Global locale typography / RTL */
html[lang="ar"] body{direction:rtl;}
html[lang="ar"] .nav,html[lang="ar"] .hero,html[lang="ar"] .reviews-page,html[lang="ar"] .contact-page,html[lang="ar"] .services-page{direction:rtl;}
html[lang="ar"] .nav nav{direction:rtl;}
html[lang="ar"] .language-menu{direction:ltr;}

/* =========================================================
   FINAL A-Z CONSOLIDATION — eSenceDesk
   Fixes asset paths, workflow flow, light-section contrast,
   and keeps the service/photo cards stable across breakpoints.
   ========================================================= */

/* Service image assets: keep both root and /images references valid. */
.service-grid-photo .service-photo::before{
  background-size:cover !important;
  background-position:center !important;
}

/* HOW WE WORK — clean horizontal flow, no floating-ball UI. */
.process-grid{
  position:relative !important;
  display:grid !important;
  grid-template-columns:repeat(4,minmax(0,1fr)) !important;
  gap:0 !important;
  border-top:0 !important;
  border-bottom:0 !important;
  overflow:visible !important;
}
.process-grid > div{
  position:relative !important;
  min-height:235px !important;
  padding:28px 34px 20px !important;
  border:0 !important;
  border-top:1px solid rgba(11,12,15,.18) !important;
  border-bottom:1px solid rgba(11,12,15,.18) !important;
  background:transparent !important;
  transform:none !important;
  box-shadow:none !important;
}
.process-grid > div:not(:last-child)::after{
  content:"→" !important;
  position:absolute !important;
  right:-12px !important;
  top:50% !important;
  transform:translateY(-50%) !important;
  width:24px !important;
  height:24px !important;
  display:grid !important;
  place-items:center !important;
  color:#1769e0 !important;
  background:#e9e8e1 !important;
  font:500 22px/1 Arial,sans-serif !important;
  z-index:4 !important;
}
.process-grid > div > span{
  display:block !important;
  color:#58708a !important;
  font:500 10px "DM Mono",monospace !important;
  letter-spacing:.12em !important;
}
.process-grid > div > b{
  display:flex !important;
  align-items:center !important;
  gap:14px !important;
  margin-top:44px !important;
  color:#0b0c0f !important;
  font:700 18px/1 Manrope,sans-serif !important;
  letter-spacing:.01em !important;
}
.process-grid > div > b::before{
  content:"" !important;
  width:34px !important;
  height:34px !important;
  flex:0 0 34px !important;
  border:1px solid #8da3b8 !important;
  border-radius:50% !important;
  background:radial-gradient(circle at 34% 28%,#fff 0,#dbe8f3 38%,#91a7ba 62%,#182635 100%) !important;
  box-shadow:0 5px 14px rgba(20,55,85,.16) !important;
}
.process-grid > div > p{
  margin:28px 0 0 48px !important;
  color:#52647b !important;
  font-size:12px !important;
  line-height:1.7 !important;
  max-width:210px !important;
}
.process-grid > div:hover{
  background:rgba(255,255,255,.22) !important;
}

/* Light review/about sections: never let headings become white/invisible. */
.reviews-teaser,
.reviews-teaser-inner,
.reviews-teaser h2,
.reviews-teaser p{
  opacity:1 !important;
  visibility:visible !important;
}
.reviews-teaser h2{
  color:#0b1b2e !important;
  -webkit-text-fill-color:#0b1b2e !important;
}
.reviews-teaser h2 i{
  color:#2367e8 !important;
  -webkit-text-fill-color:#2367e8 !important;
}
.reviews-teaser p{color:#52647b !important;-webkit-text-fill-color:#52647b !important}

/* About page light copy stays readable in every locale. */
.about,
.about-content,
.about-content h2,
.about-content p{
  opacity:1 !important;
  visibility:visible !important;
}
.about-content h2{color:#0b1b2e !important;-webkit-text-fill-color:#0b1b2e !important}
.about-content h2 em{color:#687889 !important;-webkit-text-fill-color:#687889 !important}
.about-content p{color:#52647b !important;-webkit-text-fill-color:#52647b !important}

/* Keep the sticky contact buttons above every section. */
.float-actions{z-index:9998 !important}

@media(max-width:900px){
  .process-grid{grid-template-columns:repeat(2,minmax(0,1fr)) !important}
  .process-grid > div:nth-child(2)::after{display:none !important}
  .process-grid > div:nth-child(1),
  .process-grid > div:nth-child(2){border-bottom:1px solid rgba(11,12,15,.18) !important}
  .process-grid > div:nth-child(3),
  .process-grid > div:nth-child(4){border-top:0 !important}
}
@media(max-width:520px){
  .process-grid{grid-template-columns:1fr !important}
  .process-grid > div{min-height:160px !important;border-bottom:1px solid rgba(11,12,15,.18) !important;border-top:0 !important;padding:24px 8px !important}
  .process-grid > div:first-child{border-top:1px solid rgba(11,12,15,.18) !important}
  .process-grid > div:not(:last-child)::after{
    content:"↓" !important;
    right:auto !important;
    left:50% !important;
    top:auto !important;
    bottom:-12px !important;
    transform:translateX(-50%) !important;
  }
  .process-grid > div > b{margin-top:28px !important}
  .process-grid > div > p{margin:20px 0 0 48px !important}
}

/* =========================================================
   FINAL INDEX LANGUAGE SWITCHER VISIBILITY FIX
   ========================================================= */
header.nav > .language-selector {
  display: flex !important;
  position: relative !important;
  flex: 0 0 auto !important;
  align-items: center !important;
  margin: 0 12px 0 24px !important;
  z-index: 10050 !important;
}
header.nav > .language-selector .language-current {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  min-width: 104px !important;
  height: 48px !important;
  opacity: 1 !important;
  visibility: visible !important;
}
header.nav > .language-selector .language-menu {
  z-index: 10060 !important;
}
@media (max-width: 1100px) {
  header.nav > .language-selector { margin-left: 12px !important; margin-right: 8px !important; }
  header.nav > .language-selector .language-current { min-width: 92px !important; }
}
@media (max-width: 700px) {
  header.nav > .language-selector {
    display: flex !important;
    margin-left: auto !important;
    margin-right: 8px !important;
  }
  header.nav > .language-selector .language-current {
    min-width: 78px !important;
    height: 44px !important;
    padding: 0 10px !important;
  }
  header.nav > .language-selector .language-menu {
    width: 190px !important;
    right: 0 !important;
    max-height: 70vh !important;
  }
}

/* =========================================================
   MODERN SERVICE CARDS — light rounded capability grid
   ========================================================= */
.capabilities { background:#fff9f9 !important; color:#0d1830 !important; }
.capabilities .section-tag { color:#6a7485 !important; }
.capabilities .section-head h2 { color:#0d1830 !important; }
.capabilities .section-head h2 i { color:#6c7788 !important; }
.capabilities .section-head > p { color:#53637b !important; }

.service-grid-modern {
  display:grid !important;
  grid-template-columns:repeat(4,minmax(0,1fr)) !important;
  gap:24px !important;
  background:transparent !important;
  border:0 !important;
}

.service-modern-card {
  position:relative !important;
  min-height:270px !important;
  padding:34px 32px 72px !important;
  border-radius:22px !important;
  background:#f1eef2 !important;
  color:#0d1830 !important;
  border:1px solid rgba(13,24,48,.035) !important;
  box-shadow:none !important;
  overflow:hidden !important;
  transition:transform .28s ease,box-shadow .28s ease,background .28s ease !important;
}
.service-modern-card:hover {
  transform:translateY(-6px) !important;
  background:#efebf0 !important;
  box-shadow:0 18px 40px rgba(15,24,44,.08) !important;
  z-index:2 !important;
}
.service-modern-index {
  position:absolute;
  top:22px;
  right:24px;
  font:500 10px/1 "DM Mono",monospace;
  letter-spacing:.12em;
  color:#8992a0;
}
.service-modern-icon {
  display:flex;
  width:44px;
  height:44px;
  align-items:center;
  justify-content:flex-start;
  color:#2f3643;
  margin-bottom:18px;
}
.service-modern-icon svg {
  width:38px;
  height:38px;
  fill:none;
  stroke:currentColor;
  stroke-width:1.35;
  stroke-linecap:round;
  stroke-linejoin:round;
}
.service-modern-card h3 {
  margin:0 0 12px !important;
  color:#0d1830 !important;
  font:800 24px/1.05 Manrope,Inter,Arial,sans-serif !important;
  letter-spacing:-.035em !important;
}
.service-modern-card p {
  margin:0 !important;
  max-width:285px;
  color:#50627d !important;
  font:400 14px/1.5 Inter,Arial,sans-serif !important;
}
.service-modern-plus {
  position:absolute;
  right:16px;
  bottom:14px;
  width:34px;
  height:34px;
  display:grid;
  place-items:center;
  padding:0;
  border:0;
  border-radius:50%;
  background:#ef2626;
  color:#fff;
  font:500 25px/1 Arial,sans-serif;
  cursor:pointer;
  transition:transform .25s ease,background .25s ease;
}
.service-modern-card:hover .service-modern-plus {
  transform:rotate(90deg) scale(1.06);
  background:#d91e1e;
}
.service-modern-card:nth-child(9),
.service-modern-card:nth-child(10) { min-height:250px !important; }

@media (max-width:1200px){
  .service-grid-modern{grid-template-columns:repeat(3,minmax(0,1fr)) !important}
}
@media (max-width:850px){
  .service-grid-modern{grid-template-columns:repeat(2,minmax(0,1fr)) !important;gap:16px !important}
  .service-modern-card{min-height:245px !important;padding:28px 24px 66px !important}
}
@media (max-width:560px){
  .service-grid-modern{grid-template-columns:1fr !important}
}

/* Premium corporate service cards — final pass */
.service-grid-modern {
  display:grid !important;
  grid-template-columns:repeat(3,minmax(0,1fr)) !important;
  gap:18px !important;
  background:transparent !important;
  border:0 !important;
}

.service-modern-card {
  position:relative !important;
  min-height:330px !important;
  padding:34px 34px 76px !important;
  border-radius:24px !important;
  background:linear-gradient(180deg,#ffffff 0%,#fbfcfe 100%) !important;
  color:#0b1c33 !important;
  border:1px solid #dce4ef !important;
  box-shadow:0 8px 30px rgba(12,33,58,.045) !important;
  overflow:hidden !important;
  transition:transform .35s cubic-bezier(.2,.7,.2,1),box-shadow .35s ease,border-color .35s ease !important;
}

.service-modern-card::before {
  content:"";
  position:absolute;
  left:0;
  right:0;
  top:0;
  height:3px;
  background:linear-gradient(90deg,#2167e8,#79a9ff);
  opacity:.75;
  transform:scaleX(.28);
  transform-origin:left;
  transition:transform .45s ease,opacity .35s ease;
}

.service-modern-card:hover {
  transform:translateY(-8px) !important;
  background:#fff !important;
  border-color:#c7d7ec !important;
  box-shadow:0 24px 56px rgba(12,33,58,.11) !important;
  z-index:2 !important;
}

.service-modern-card:hover::before {
  transform:scaleX(1);
  opacity:1;
}

/* Remove decorative card numbering completely */
.service-modern-index {
  display:none !important;
}

.service-modern-icon {
  display:flex;
  width:50px;
  height:50px;
  align-items:center;
  justify-content:center;
  color:#2167e8 !important;
  margin:0 0 34px !important;
  border:1px solid #d9e5f5;
  border-radius:14px;
  background:#f7faff;
}

.service-modern-icon svg {
  width:30px !important;
  height:30px !important;
  fill:none;
  stroke:currentColor;
  stroke-width:1.45;
  stroke-linecap:round;
  stroke-linejoin:round;
}

.service-modern-card h3 {
  margin:0 0 14px !important;
  color:#0a1b31 !important;
  font:750 28px/1.08 Manrope,Inter,Arial,sans-serif !important;
  letter-spacing:-.045em !important;
}

.service-modern-card p {
  margin:0 !important;
  max-width:410px !important;
  color:#5b6d84 !important;
  font:400 15px/1.7 Inter,Arial,sans-serif !important;
}

/* Corporate blue — no red accents */
.service-modern-plus {
  position:absolute;
  right:24px;
  bottom:22px;
  width:38px;
  height:38px;
  display:grid;
  place-items:center;
  padding:0;
  border:1px solid #b9d0f0 !important;
  border-radius:50%;
  background:#ffffff !important;
  color:#2167e8 !important;
  font:500 23px/1 Arial,sans-serif;
  cursor:pointer;
  transition:transform .3s ease,background .3s ease,color .3s ease,border-color .3s ease,box-shadow .3s ease;
}

.service-modern-card:hover .service-modern-plus {
  transform:rotate(90deg) !important;
  background:#2167e8 !important;
  color:#fff !important;
  border-color:#2167e8 !important;
  box-shadow:0 8px 18px rgba(33,103,232,.22);
}

.service-modern-card:nth-child(9),
.service-modern-card:nth-child(10) {
  min-height:330px !important;
}

@media (max-width:1100px){
  .service-grid-modern{grid-template-columns:repeat(2,minmax(0,1fr)) !important}
}

@media (max-width:700px){
  .service-grid-modern{grid-template-columns:1fr !important;gap:14px !important}
  .service-modern-card,
  .service-modern-card:nth-child(9),
  .service-modern-card:nth-child(10){min-height:300px !important;padding:30px 28px 70px !important}
  .service-modern-card h3{font-size:25px !important}
}


/* =========================================================
   PREMIUM CORPORATE SERVICES — UI/UX FINAL PASS
   - No section/card numbering
   - Editorial enterprise grid
   - Restrained radius, stronger hierarchy
   - Brand blue accents only
   ========================================================= */
.services {
  max-width: 1440px !important;
  margin: 0 auto !important;
  padding: 118px clamp(28px,5vw,88px) 130px !important;
  background: #fff !important;
}

.services .section-title {
  display:grid !important;
  grid-template-columns:minmax(0,1.15fr) minmax(300px,.55fr) !important;
  gap:70px !important;
  align-items:end !important;
  margin-bottom:64px !important;
  padding-bottom:28px !important;
  border-bottom:1px solid #dfe7f0 !important;
}
.services .section-title .kicker,
.services .section-title .section-kicker,
.services .section-title .eyebrow,
.services .kicker {
  color:#54708b !important;
  font-size:11px !important;
  letter-spacing:.18em !important;
  font-weight:700 !important;
}
.services .section-title h2 {
  margin:12px 0 0 !important;
  font:700 clamp(46px,5.4vw,78px)/.95 Manrope,Inter,Arial,sans-serif !important;
  letter-spacing:-.06em !important;
  color:#071b31 !important;
}
.services .section-title h2 em {
  color:#1769e0 !important;
}
.services .section-title > p {
  margin:0 0 4px !important;
  max-width:470px !important;
  color:#5a6f83 !important;
  font:400 15.5px/1.8 Inter,Arial,sans-serif !important;
}

.service-cards-grid {
  display:grid !important;
  grid-template-columns:repeat(3,minmax(0,1fr)) !important;
  gap:1px !important;
  background:#d9e2ec !important;
  border:1px solid #d9e2ec !important;
}

.service-cards-grid .service {
  position:relative !important;
  min-height:385px !important;
  display:flex !important;
  flex-direction:column !important;
  padding:38px 36px 34px !important;
  margin:0 !important;
  border:0 !important;
  border-radius:0 !important;
  background:#fff !important;
  color:#0b2036 !important;
  box-shadow:none !important;
  overflow:hidden !important;
  transition:background .28s ease, transform .28s ease, box-shadow .28s ease !important;
}

.service-cards-grid .service::before {
  content:"" !important;
  position:absolute !important;
  left:0 !important;
  top:0 !important;
  width:100% !important;
  height:2px !important;
  background:#1769e0 !important;
  transform:scaleX(0) !important;
  transform-origin:left !important;
  transition:transform .35s ease !important;
}
.service-cards-grid .service:hover {
  z-index:2 !important;
  transform:translateY(-4px) !important;
  background:#fbfdff !important;
  box-shadow:0 18px 42px rgba(11,32,54,.10) !important;
}
.service-cards-grid .service:hover::before { transform:scaleX(1) !important; }

.service-cards-grid .service > div:first-of-type {
  flex:1 1 auto !important;
}
.service-cards-grid .service h3 {
  margin:0 0 15px !important;
  font:720 clamp(25px,2.1vw,34px)/1.02 Manrope,Inter,Arial,sans-serif !important;
  letter-spacing:-.045em !important;
  color:#081d33 !important;
}
.service-cards-grid .service h3 span { color:#1769e0 !important; }
.service-cards-grid .service p {
  margin:0 !important;
  max-width:520px !important;
  color:#526b82 !important;
  font:400 14.5px/1.75 Inter,Arial,sans-serif !important;
}

.service-cards-grid .pillrow {
  display:flex !important;
  flex-wrap:wrap !important;
  gap:7px !important;
  margin-top:22px !important;
}
.service-cards-grid .pill {
  display:inline-flex !important;
  align-items:center !important;
  min-height:27px !important;
  padding:5px 9px !important;
  border:1px solid #d8e2ed !important;
  border-radius:999px !important;
  background:#f7faff !important;
  color:#49657e !important;
  font:600 9px/1 Inter,Arial,sans-serif !important;
  letter-spacing:.10em !important;
  text-transform:uppercase !important;
}

.service-cards-grid .scope {
  margin-top:25px !important;
  padding-top:18px !important;
  border-top:1px solid #e2e8ef !important;
}
.service-cards-grid .scope strong {
  display:block !important;
  margin-bottom:11px !important;
  color:#15304a !important;
  font:700 10px/1 Inter,Arial,sans-serif !important;
  letter-spacing:.14em !important;
  text-transform:uppercase !important;
}
.service-cards-grid .scope ul {
  display:grid !important;
  grid-template-columns:1fr 1fr !important;
  gap:6px 14px !important;
  margin:0 !important;
  padding:0 !important;
  list-style:none !important;
}
.service-cards-grid .scope li {
  position:relative !important;
  padding-left:13px !important;
  color:#667b90 !important;
  font:400 12px/1.45 Inter,Arial,sans-serif !important;
}
.service-cards-grid .scope li::before {
  content:"" !important;
  position:absolute !important;
  left:0 !important;
  top:.55em !important;
  width:5px !important;
  height:5px !important;
  border-radius:50% !important;
  background:#1769e0 !important;
}

.service-plus {
  position:absolute !important;
  right:27px !important;
  bottom:25px !important;
  width:34px !important;
  height:34px !important;
  display:grid !important;
  place-items:center !important;
  border:1px solid #bfd4ef !important;
  border-radius:50% !important;
  background:#fff !important;
  color:#1769e0 !important;
  font:400 21px/1 Arial,sans-serif !important;
  transition:all .28s ease !important;
}
.service-cards-grid .service:hover .service-plus {
  color:#fff !important;
  background:#1769e0 !important;
  border-color:#1769e0 !important;
  transform:rotate(90deg) !important;
  box-shadow:0 8px 20px rgba(23,105,224,.20) !important;
}

/* Make the newly added capabilities feel like first-class corporate services. */
.service-feature { background:#fafdff !important; }
.service-feature::after {
  content:"CAPABILITY" !important;
  position:absolute !important;
  top:23px !important;
  right:30px !important;
  color:#8aa0b5 !important;
  font:700 8px/1 Inter,Arial,sans-serif !important;
  letter-spacing:.18em !important;
}

.partners {
  padding:100px clamp(28px,5vw,88px) !important;
  background:#f7fafd !important;
  border-top:1px solid #dce5ef !important;
}
.partners .kicker { color:#54708b !important; }

@media (max-width:1100px){
  .services .section-title { grid-template-columns:1fr !important; gap:22px !important; }
  .service-cards-grid { grid-template-columns:repeat(2,minmax(0,1fr)) !important; }
}
@media (max-width:700px){
  .services { padding:85px 18px 90px !important; }
  .services .section-title { margin-bottom:40px !important; padding-bottom:22px !important; }
  .services .section-title h2 { font-size:46px !important; }
  .service-cards-grid { grid-template-columns:1fr !important; }
  .service-cards-grid .service { min-height:350px !important; padding:30px 26px 30px !important; }
  .service-cards-grid .scope ul { grid-template-columns:1fr !important; }
}

/* =========================================================
   GLOBAL CORPORATE VISIBILITY / TYPOGRAPHY PASS
   ========================================================= */

/* Section numbering stays in the source for i18n, but is never shown. */
.section-tag,
.mega-kicker {
  font-size: 12px !important;
  line-height: 1.35 !important;
  letter-spacing: .16em !important;
  font-weight: 700 !important;
}

/* Light sections: stronger contrast and larger supporting copy. */
.manifesto,
.capabilities,
.languages,
.about,
.partners {
  color: #081b31 !important;
}

.manifesto { background: #f8fafc !important; }
.capabilities { background: #f6f9fd !important; }
.about { background: #f8fafc !important; }
.partners { background: #f4f7fb !important; }

.manifesto .section-tag,
.about .section-tag,
.capabilities .section-tag,
.languages .section-tag,
.partners .section-tag {
  color: #385a79 !important;
}

.manifesto-text .kicker,
.manifesto .muted,
.section-head > p,
.about p,
.about .big-p,
.service-modern-card p,
.language-big + p,
.partners p {
  color: #314a63 !important;
}

.manifesto .muted {
  font-size: 17px !important;
  line-height: 1.82 !important;
}

.manifesto-text .kicker {
  font-size: 13px !important;
  font-weight: 700 !important;
}

.stats small {
  color: #3f5b74 !important;
  font-size: 12px !important;
  font-weight: 700 !important;
}

.section-head > p {
  font-size: 17px !important;
  line-height: 1.8 !important;
  color: #314a63 !important;
}

.capabilities .section-head h2 {
  color: #071b31 !important;
}
.capabilities .section-head h2 i {
  color: #52677c !important;
}

.service-modern-card {
  background: #ffffff !important;
  border: 1px solid #d5dfeb !important;
  box-shadow: 0 10px 34px rgba(8, 27, 49, .055) !important;
}
.service-modern-card:hover {
  box-shadow: 0 22px 52px rgba(8, 27, 49, .12) !important;
  border-color: #bbcee5 !important;
}
.service-modern-card h3 {
  font-size: 30px !important;
  color: #071b31 !important;
}
.service-modern-card p {
  font-size: 16px !important;
  line-height: 1.72 !important;
  color: #35516a !important;
}
.service-modern-icon {
  color: #1769e0 !important;
  background: #f1f6fd !important;
  border-color: #cfdef0 !important;
}
.service-modern-plus {
  background: #fff !important;
  color: #1769e0 !important;
  border-color: #a9c5e8 !important;
}
.service-modern-card:hover .service-modern-plus {
  background: #1769e0 !important;
  color: #fff !important;
  border-color: #1769e0 !important;
}

/* Bigger readable microcopy without turning it into display text. */
.language-big span {
  font-size: clamp(30px, 4vw, 64px) !important;
}
.language-big span:nth-child(even) {
  color: #36516a !important;
}

.about p,
.about .big-p {
  color: #27435d !important;
  font-size: 17px !important;
  line-height: 1.82 !important;
}
.about .big-p { font-size: 20px !important; }
.under { font-size: 12px !important; font-weight: 800 !important; }

/* Dark sections: remove washed-out gray text. */
.media,
.contact {
  color: #f4f7fb !important;
}
.media .section-tag,
.contact .section-tag {
  color: #b8d0ea !important;
}
.media-title p,
.contact-grid > div > p,
.media-list span {
  color: #b4c2d2 !important;
  font-size: 15px !important;
}

.media-title h2 {
  color: #f7f9fc !important;
}
.media-title h2 span { color: #4f8fec !important; }

/* Language selector: visually EN-only and non-interactive for now. */
.language-menu {
  display: none !important;
  visibility: hidden !important;
  opacity: 0 !important;
  pointer-events: none !important;
}
.language-current {
  cursor: default !important;
  pointer-events: none !important;
}
.language-current b { display: none !important; }
.language-current .current-lang-flag { display: none !important; }
.language-selector {
  min-width: 82px !important;
}
.language-selector .lang-code {
  font-size: 13px !important;
  font-weight: 800 !important;
  letter-spacing: .08em !important;
}

/* Remove numeric prefixes visually everywhere, while preserving translation keys. */
.section-tag,
.mega-kicker { text-indent: 0 !important; }

/* Responsive readability */
@media (max-width: 700px) {
  .section-tag,
  .mega-kicker { font-size: 11px !important; }
  .section-head > p,
  .manifesto .muted,
  .about p { font-size: 16px !important; }
  .service-modern-card h3 { font-size: 27px !important; }
  .service-modern-card p { font-size: 15px !important; }
}

/* FINAL FIX — Index About CTA: keep visible on light background */
.about a.under,
.about a.under:link,
.about a.under:visited {
  color: #10243d !important;
  background: transparent !important;
  border: 1px solid #10243d !important;
  border-radius: 999px !important;
  padding: 12px 18px !important;
  display: inline-flex !important;
  align-items: center !important;
  gap: 8px !important;
  text-decoration: none !important;
  opacity: 1 !important;
  visibility: visible !important;
  box-shadow: none !important;
}

.about a.under:hover,
.about a.under:focus-visible,
.about a.under:active {
  color: #ffffff !important;
  background: #1769e0 !important;
  border-color: #1769e0 !important;
  opacity: 1 !important;
  visibility: visible !important;
  text-decoration: none !important;
}
