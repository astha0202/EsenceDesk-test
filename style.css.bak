.steps-grid > *::after {
    position: absolute;

    top: 72px;
    left: 50%;

    transform: translate(-50%, -50%);

    color: #eaf3ff;
    font-size: 10px;
    letter-spacing: .12em;

    z-index: 3;
}

/* TEXT */
.process-grid > * p,
.workflow-grid > * p,
.steps-grid > * p {
    margin: 125px auto 0 !important;

    max-width: 190px;

    text-align: center;

    color: rgba(220,228,240,.72) !important;

