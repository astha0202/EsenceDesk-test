}
/* South Korea 🇰🇷 */
.flag-kr {
    background: #fff;
    position: relative;
}

.flag-kr::before {
    content: "";
    position: absolute;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    background: linear-gradient(
        to bottom,
        #cd2e3a 0 50%,
        #0047a0 50% 100%
    );
}
.flag-img {
    width: 22px;
    height: 15px;
    object-fit: cover;
    display: block;
    flex-shrink: 0;
    border-radius: 2px;
}
/* =========================================================
   LIGHT CORPORATE REDESIGN — ESENCEDESK
   Premium enterprise / global agency look
   ========================================================= */
:root{
  --corp-bg:#ffffff;
  --corp-soft:#f6f8fb;
  --corp-soft2:#eef3f8;
  --corp-ink:#0b1b2b;
  --corp-muted:#5e6b78;
  --corp-line:#e3e8ee;
  --corp-blue:#1769e0;
  --corp-blue2:#4c9aff;
  --corp-shadow:0 18px 50px rgba(15,35,55,.08);
}

html,body{
  background:var(--corp-bg) !important;
  color:var(--corp-ink) !important;
}
body{font-family:Inter,Arial,sans-serif !important;}
.noise,.luxury-grain{display:none !important;}
body:before{display:none !important;}

/* NAV */
.nav{
  height:82px !important;
  padding:0 5vw !important;
  background:rgba(255,255,255,.94) !important;
  border-bottom:1px solid var(--corp-line) !important;
  box-shadow:0 4px 24px rgba(20,40,60,.04) !important;
  backdrop-filter:blur(18px) !important;
}
.brand{color:var(--corp-ink) !important;}
.brand img{width:40px !important;height:40px !important;}
.brand-word{font-size:22px !important;color:var(--corp-ink) !important;}
.nav nav{color:var(--corp-muted) !important;}
.nav nav a,.nav-links a{color:#526170 !important;}
.nav nav a:hover,.nav-links a:hover{color:var(--corp-blue) !important;}
.nav .cta,.nav-cta{color:#fff !important;background:var(--corp-ink);padding:12px 18px;border-radius:5px;}
.nav .cta:hover{background:var(--corp-blue) !important;}

/* LANGUAGE */
.language-current{
  background:#fff !important;
  color:var(--corp-ink) !important;
  border:1px solid var(--corp-line) !important;
  box-shadow:none !important;
}
.language-menu{
  background:#fff !important;
  border:1px solid var(--corp-line) !important;
  box-shadow:0 20px 50px rgba(15,35,55,.13) !important;
}
.language-menu button{color:#344454 !important;background:#fff !important;}
.language-menu button:hover{background:#f3f7fb !important;color:var(--corp-blue) !important;}

/* GLOBAL HERO */
.hero,
.contact-hero{
  background:
    radial-gradient(circle at 82% 24%,rgba(45,126,255,.10),transparent 32%),
    linear-gradient(135deg,#fff 0%,#fbfcfe 58%,#f2f7fc 100%) !important;
  color:var(--corp-ink) !important;
}
.hero-grid{opacity:.35 !important;background-image:linear-gradient(rgba(20,60,100,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(20,60,100,.045) 1px,transparent 1px) !important;}
.hero h1,.contact-hero h1{color:var(--corp-ink) !important;}
.hero h1 span,.contact-hero h1 em,.hero h1 em{color:var(--corp-blue) !important;}
.hero-lead,.hero-intro,.contact-hero p{color:var(--corp-muted) !important;}
.eyebrow,.section-tag,.kicker{color:#617486 !important;}
.pulse{background:var(--corp-blue) !important;box-shadow:0 0 18px rgba(23,105,224,.35) !important;}
.hero-foot{border-color:var(--corp-line) !important;color:#7b8996 !important;}
.hero-trust{color:#687786 !important;}

.btn-light{background:var(--corp-ink) !important;color:#fff !important;box-shadow:0 10px 25px rgba(11,27,43,.12);}
.btn-light:hover{background:var(--corp-blue) !important;transform:translateY(-2px);}
.text-link{color:#344554 !important;}
.text-link span{color:var(--corp-blue) !important;}

/* HERO WORLD PANEL */
.world-panel,.language-card,.floating-mini{
  background:rgba(255,255,255,.90) !important;
  color:var(--corp-ink) !important;
  border:1px solid var(--corp-line) !important;
  box-shadow:var(--corp-shadow) !important;
  backdrop-filter:blur(16px) !important;
}
.world-top,.world-bottom{color:#71808d !important;border-color:var(--corp-line) !important;}
.world-map{background:linear-gradient(145deg,#f7fbff,#edf4fa) !important;}
.center-orb{background:#fff !important;border:1px solid #d9e5f0 !important;box-shadow:0 10px 35px rgba(25,80,130,.10) !important;}
.city{color:#58748d !important;}
.routes path{stroke:rgba(23,105,224,.34) !important;}
.node{background:var(--corp-blue) !important;box-shadow:0 0 0 5px rgba(23,105,224,.10) !important;}
.live{color:var(--corp-blue) !important;}

/* WHITE / SOFT SECTIONS */
.manifesto,.about,.partners,.services,.services-detail,.values,.contact-section,.contact-cta{
  background:var(--corp-bg) !important;
  color:var(--corp-ink) !important;
}
.manifesto{border-top:1px solid var(--corp-line);border-bottom:1px solid var(--corp-line);}
.manifesto h2,.about h2,.section-head h2,.media-title h2,.partner-head h2,.values-head h2,.contact-info h2,.contact-cta h2{color:var(--corp-ink) !important;}
.manifesto h2 i,.section-head h2 i,.about h2 i{color:#687683 !important;}
.muted,.section-head>p,.about p,.about-content p,.partner-head p,.contact-description{color:var(--corp-muted) !important;}
.stats div,.partner-grid,.values-grid{border-color:var(--corp-line) !important;}
.stats strong{color:var(--corp-ink) !important;}
.stats small{color:#72808c !important;}

/* SERVICES */
.capabilities{background:#f6f8fb !important;color:var(--corp-ink) !important;}
.service-grid{background:var(--corp-line) !important;border-color:var(--corp-line) !important;box-shadow:var(--corp-shadow);}
.service,.service.dark,.service.featured,.service-photo{
  background:#fff !important;
  color:var(--corp-ink) !important;
}
.service:hover,.service.dark:hover{background:#f7fbff !important;}
.service.featured{box-shadow:inset 4px 0 0 var(--corp-blue) !important;}
.service h3{color:var(--corp-ink) !important;}
.service p,.featured p{color:var(--corp-muted) !important;}
.num,.service.featured .num{color:#738291 !important;}
.chips b{border-color:#dce4ec !important;color:#5c6b79 !important;background:#f8fafc;}
.icon,.arrow{color:var(--corp-blue) !important;}

/* SERVICES PAGE */
.services .service{border-color:var(--corp-line) !important;background:#fff !important;box-shadow:0 10px 35px rgba(20,45,70,.05);}
.services .service:hover{background:#f8fbff !important;box-shadow:0 18px 45px rgba(20,45,70,.09);}
.scope{color:var(--corp-muted) !important;}
.pill{border-color:#dce5ed !important;color:#536575 !important;background:#f8fafc !important;}
.services-detail .service-detail-card{background:#fff !important;border-color:var(--corp-line) !important;box-shadow:0 12px 40px rgba(20,45,70,.05);color:var(--corp-ink) !important;}
.services-detail .service-detail-card:hover{box-shadow:0 20px 55px rgba(20,45,70,.10) !important;}
.service-detail-content p,.service-detail-tag{color:var(--corp-muted) !important;}
.service-detail-number{color:var(--corp-blue) !important;}
.language-box{background:#f5f9fd !important;border-color:#dce7f1 !important;}

/* MEDIA */
.media{background:#f4f7fa !important;color:var(--corp-ink) !important;}
.media-title p,.media-list span{color:var(--corp-muted) !important;}
.media-list{border-color:var(--corp-line) !important;}
.media-list span{border-color:var(--corp-line) !important;}
.pill{background:#fff !important;}
.media-bg-card{border-color:#dfe6ed !important;box-shadow:0 30px 80px rgba(20,45,70,.10) !important;}

/* LANGUAGES */
.languages{background:#0d5fbd !important;color:#fff !important;}
.languages .section-tag{color:rgba(255,255,255,.68) !important;}
.language-big span{color:#fff !important;}

/* ABOUT */
.about-image{background:#eef4f8 !important;border-color:var(--corp-line) !important;box-shadow:var(--corp-shadow);}
.about-image img{filter:brightness(.96) saturate(.88) contrast(1.02) !important;}
.about-image:after{background:linear-gradient(180deg,transparent,rgba(7,24,40,.55)) !important;}
.image-label{color:#fff !important;}
.value{background:#fff !important;border-color:var(--corp-line) !important;}
.value:hover{background:#f5f9fd !important;}
.value-number{color:var(--corp-blue) !important;}
.value h3{color:var(--corp-ink) !important;}
.value p{color:var(--corp-muted) !important;}

/* PARTNERS */
.partner{background:#fff !important;border-color:var(--corp-line) !important;color:var(--corp-ink) !important;}
.partner:hover{background:#f5f9fd !important;color:var(--corp-blue) !important;}
.partner small{color:#71808d !important;}

/* CONTACT */
.contact-section{border-top:1px solid var(--corp-line) !important;}
.contact-grid{border-color:var(--corp-line) !important;}
.contact-info h2 span,.contact-cta h2 em{color:var(--corp-blue) !important;}
.contact-label,.contact-item small{color:#60788d !important;}
.contact-item{border-color:var(--corp-line) !important;}
.contact-icon{background:#f3f7fb !important;border-color:#dce6ef !important;color:var(--corp-blue) !important;}
.contact-item a{color:#304353 !important;}
.contact-item a:hover{color:var(--corp-blue) !important;}
.contact-item p{color:var(--corp-muted) !important;}
.contact-item strong{color:var(--corp-ink) !important;}
.contact-form-wrap{background:#fff !important;border:1px solid var(--corp-line) !important;box-shadow:0 20px 60px rgba(20,45,70,.08) !important;}
.form-top{border-color:var(--corp-line) !important;color:#60788d !important;}
.form-field label{color:#60788d !important;}
.form-field input,.form-field textarea,.form-field select{color:var(--corp-ink) !important;border-color:#d8e1e9 !important;}
.form-field input:focus,.form-field textarea:focus,.form-field select:focus{border-color:var(--corp-blue) !important;}
.form-field input::placeholder,.form-field textarea::placeholder{color:#9aa7b3 !important;}
.form-field select option{background:#fff !important;color:var(--corp-ink) !important;}
.contact-submit{background:var(--corp-blue) !important;border-color:var(--corp-blue) !important;color:#fff !important;}
.contact-submit:hover{background:var(--corp-ink) !important;border-color:var(--corp-ink) !important;}
.contact-cta{border-color:var(--corp-line) !important;}
.cta-button{color:var(--corp-ink) !important;border-color:#d6e0e8 !important;background:#fff !important;}
.cta-button:hover{color:var(--corp-blue) !important;border-color:var(--corp-blue) !important;}

/* FOOTERS */
.footer,.site-footer{background:#f7f9fb !important;color:#687785 !important;border-color:var(--corp-line) !important;}
.footer a,.site-footer a{color:#536574 !important;}
.footer a:hover,.site-footer a:hover{color:var(--corp-blue) !important;}

/* FLOATING BUTTONS */
.float-action,.floating-contact a{background:#fff !important;color:var(--corp-ink) !important;border:1px solid var(--corp-line) !important;box-shadow:0 10px 30px rgba(15,35,55,.12) !important;}
.float-action:hover,.floating-contact a:hover{color:var(--corp-blue) !important;transform:translateY(-2px);}

/* PRELOADER */
.preloader{background:#fff !important;color:var(--corp-ink) !important;}
.preloader-meta{color:#657686 !important;}
.preloader-line{background:#dfe7ee !important;}
.preloader-line i{background:var(--corp-blue) !important;}

/* RESPONSIVE POLISH */
@media(max-width:900px){
  .nav{padding:0 5% !important;}
  .nav nav{gap:16px !important;}
  .nav .cta{display:none !important;}
  .hero{grid-template-columns:1fr !important;padding-top:125px !important;}
  .hero-art{min-height:480px !important;}
  .manifesto,.about-grid,.contact-grid{grid-template-columns:1fr !important;}
  .service-grid,.partner-grid,.values-grid{grid-template-columns:1fr 1fr !important;}
}
@media(max-width:620px){
  .nav{height:72px !important;}
  .brand-word{font-size:18px !important;}
  .nav nav{display:none !important;}
  .hero{padding:110px 6% 70px !important;}
  .hero h1,.contact-hero h1{font-size:clamp(48px,15vw,76px) !important;}
  .hero-art{min-height:390px !important;transform:scale(.88);transform-origin:center;}
  .manifesto,.capabilities,.media,.languages,.about,.partners,.services,.services-detail,.values,.contact-section,.contact-cta{padding-left:6% !important;padding-right:6% !important;}
  .service-grid,.partner-grid,.values-grid{grid-template-columns:1fr !important;}
  .contact-grid{gap:50px !important;}
  .contact-form-wrap{padding:25px !important;}
}

/* =========================================================
   eSenceDesk — CORPORATE EDITION
   Clean enterprise / global localization aesthetic
   Inspired by modern B2B language-service websites.
   ========================================================= */
:root{
  --corp-blue:#155eef;
  --corp-blue-dark:#0b3b9e;
  --corp-navy:#0c1b2a;
  --corp-text:#17212b;
  --corp-muted:#667085;
  --corp-bg:#ffffff;
  --corp-soft:#f5f8fc;
  --corp-line:#e4eaf1;
  --corp-shadow:0 18px 55px rgba(16,42,67,.10);
}

html{scroll-behavior:smooth;background:#fff!important}
body{
  background:#fff!important;
  color:var(--corp-text)!important;
  font-family:Inter,Manrope,Arial,sans-serif!important;
  overflow-x:hidden;
}
.luxury-grain,.noise{display:none!important}

/* NAV */
.nav{
  position:sticky!important;
  top:0!important;
  z-index:1000!important;
  height:82px!important;
  padding:0 5vw!important;
  background:rgba(255,255,255,.96)!important;
  border-bottom:1px solid var(--corp-line)!important;
  box-shadow:0 2px 18px rgba(16,42,67,.04)!important;
  backdrop-filter:blur(16px);
}
.brand{color:var(--corp-navy)!important;gap:11px!important}
.brand img{width:38px!important;height:38px!important}
.brand-word{font-family:Manrope,sans-serif!important;font-weight:800!important;letter-spacing:-.045em!important;color:var(--corp-navy)!important}
.brand-word span{color:var(--corp-blue)!important}
.nav nav{gap:30px!important;align-items:center!important}
.nav nav>a{
  color:#344054!important;
  font-size:13px!important;
  font-weight:600!important;
  text-decoration:none!important;
  transition:.2s ease;
}
.nav nav>a:hover{color:var(--corp-blue)!important}
.nav .cta{
  background:var(--corp-blue)!important;
  color:#fff!important;
  border:1px solid var(--corp-blue)!important;
  border-radius:4px!important;
  padding:13px 19px!important;
  font-size:12px!important;
  font-weight:700!important;
  box-shadow:none!important;
}
.nav .cta:hover{background:var(--corp-blue-dark)!important;transform:none!important}

/* LANGUAGE */
.language-selector{position:relative!important}
.language-current{
  display:flex!important;align-items:center!important;gap:7px!important;
  height:36px!important;padding:0 10px!important;
  background:#fff!important;color:#344054!important;
  border:1px solid var(--corp-line)!important;border-radius:4px!important;
  cursor:pointer!important;font:600 11px Inter,sans-serif!important;
}
.language-current b{font-size:13px!important;color:#667085!important}
.language-menu{
  position:absolute!important;right:0!important;top:45px!important;
  min-width:170px!important;max-height:360px!important;overflow:auto!important;
  padding:7px!important;background:#fff!important;
  border:1px solid var(--corp-line)!important;border-radius:8px!important;
  box-shadow:0 20px 50px rgba(16,42,67,.14)!important;
  opacity:0;visibility:hidden;transform:translateY(-6px);pointer-events:none;
  transition:.18s ease!important;
}
.language-selector.open .language-menu{opacity:1;visibility:visible;transform:none;pointer-events:auto}
.language-menu button{
  width:100%!important;display:flex!important;align-items:center!important;gap:10px!important;
  padding:9px 10px!important;border:0!important;border-radius:5px!important;
  background:#fff!important;color:#344054!important;font:600 11px Inter,sans-serif!important;
  text-align:left!important;cursor:pointer!important;
}
.language-menu button:hover{background:#f2f6fb!important;color:var(--corp-blue)!important}
.flag-img,.language-current .flag{width:18px!important;height:13px!important;object-fit:cover!important;border-radius:2px!important;flex:none}

/* HERO — large white corporate layout */
.hero{
  min-height:690px!important;
  padding:110px 5vw 70px!important;
  background:#fff!important;
  display:grid!important;
  grid-template-columns:minmax(0,1.02fr) minmax(430px,.98fr)!important;
  align-items:center!important;
  gap:6vw!important;
  position:relative!important;
  overflow:hidden!important;
}
.hero:before{
  content:"";position:absolute;right:-180px;top:-180px;width:620px;height:620px;
  border-radius:50%;background:#eef5ff;z-index:0;pointer-events:none;
}
.hero-grid,.hero-orbit{display:none!important}
.hero-copy{position:relative!important;z-index:2;max-width:680px!important}
.hero-copy:before{
  content:"GLOBAL LANGUAGE • MEDIA • DIGITAL";
  display:block;margin-bottom:24px;
  color:var(--corp-blue);font:700 10px/1 Inter,sans-serif;
  letter-spacing:.17em;
}
.hero h1{
  color:var(--corp-navy)!important;
  font-family:Manrope,Inter,sans-serif!important;
  font-size:clamp(56px,6.4vw,92px)!important;
  line-height:.98!important;letter-spacing:-.065em!important;
  max-width:760px!important;margin:0!important;
}
.hero h1 span{
  color:var(--corp-blue)!important;
  background:none!important;-webkit-text-fill-color:initial!important;
}
.hero-lead{
  max-width:580px!important;margin:30px 0 32px!important;
  color:#667085!important;font-size:17px!important;line-height:1.75!important;
}
.hero-actions{display:flex!important;gap:18px!important;align-items:center!important}
.btn.btn-light{
  background:var(--corp-blue)!important;color:#fff!important;
  border:1px solid var(--corp-blue)!important;border-radius:4px!important;
  padding:15px 21px!important;font-weight:700!important;
  box-shadow:none!important;
}
.btn.btn-light:hover{background:var(--corp-blue-dark)!important;transform:none!important}
.text-link{color:var(--corp-navy)!important;font-weight:700!important}
.hero-trust{margin-top:45px!important;color:#98a2b3!important;font-size:9px!important;letter-spacing:.12em!important}
.hero-trust b{background:#d0d5dd!important}

/* Turn the existing visual into a premium image-led panel */
.hero-art{
  position:relative!important;z-index:2!important;height:560px!important;
  min-height:0!important;filter:none!important;
}
.hero-art:before{
  content:"";position:absolute;inset:0 0 45px 35px;
  background:linear-gradient(135deg,rgba(21,94,239,.08),transparent 45%),url('5.png') center/cover;
  border-radius:2px!important;
  box-shadow:var(--corp-shadow);
}
.world-panel{
  position:absolute!important;inset:38px 30px 85px 70px!important;
  border:1px solid rgba(255,255,255,.24)!important;
  background:linear-gradient(135deg,rgba(5,20,38,.62),rgba(7,19,32,.18))!important;
  box-shadow:0 30px 70px rgba(8,29,53,.20)!important;
  backdrop-filter:blur(2px)!important;
}
.world-panel:before{display:none!important}
.world-map{opacity:.7!important}
.world-bottom,.world-top{color:#fff!important}
.center-orb{box-shadow:0 0 0 1px rgba(255,255,255,.2),0 20px 50px rgba(0,0,0,.25)!important}
.floating-mini{background:#fff!important;color:var(--corp-navy)!important;border:1px solid var(--corp-line)!important;box-shadow:var(--corp-shadow)!important}
.floating-mini b{color:var(--corp-blue)!important}
.hero-foot{display:none!important}

/* INTRO */
.manifesto{
  background:var(--corp-soft)!important;color:var(--corp-text)!important;
  padding:105px 8vw!important;border-top:1px solid var(--corp-line)!important;
}
.section-tag{color:var(--corp-blue)!important;font-weight:700!important;letter-spacing:.15em!important}
.manifesto h2,.section-head h2,.media-title h2,.process-head h2,.about h2,.contact h2{
  color:var(--corp-navy)!important;letter-spacing:-.055em!important;
}
.manifesto h2 i,.section-head h2 i{color:var(--corp-blue)!important}
.manifesto .muted,.section-head p,.about p{color:var(--corp-muted)!important}
.stats{border-color:var(--corp-line)!important}
.stats strong{color:var(--corp-navy)!important}
.stats small{color:var(--corp-muted)!important}
.stats>div:before{background:var(--corp-blue)!important;box-shadow:none!important}

/* MARQUEE — restrained corporate strip */
.marquee{
  background:var(--corp-navy)!important;color:#fff!important;
  transform:none!important;box-shadow:none!important;border:0!important;
}
.marquee span{color:#fff!important;letter-spacing:.06em!important;font-size:11px!important}
.marquee b{color:#7daeff!important}

/* SERVICES */
.capabilities,.services,.services-detail,.about,.contact-section,.media,.languages,.partners,.values{
  background:#fff!important;color:var(--corp-text)!important;
}
.capabilities{padding-top:110px!important;padding-bottom:110px!important}
.section-head{align-items:end!important;margin-bottom:48px!important}
.section-head h2{font-size:clamp(42px,5vw,72px)!important}
.section-head p{font-size:15px!important;line-height:1.8!important}
.service-grid{
  background:transparent!important;border:0!important;box-shadow:none!important;
  display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:22px!important;
}
.service.service-photo{
  min-height:430px!important;border-radius:2px!important;
  border:1px solid var(--corp-line)!important;
  background-color:#0e1d2c!important;
  box-shadow:none!important;
  overflow:hidden!important;
}
.service.service-photo:after{
  content:"";position:absolute;inset:0;
  background:linear-gradient(180deg,rgba(5,20,35,.04) 15%,rgba(5,20,35,.88) 100%);
  pointer-events:none;
}
.service.service-photo:hover{transform:translateY(-5px)!important;box-shadow:var(--corp-shadow)!important}
.service-content{position:relative!important;z-index:2!important}
.service h3{font-size:27px!important;letter-spacing:-.045em!important;color:#fff!important}
.service p{color:rgba(255,255,255,.78)!important}
.service .num{color:rgba(255,255,255,.7)!important}
.chips b{background:rgba(255,255,255,.12)!important;color:#fff!important;border-color:rgba(255,255,255,.2)!important}
.service-top .icon{border-color:rgba(255,255,255,.4)!important}

/* MEDIA */
.media{padding-top:110px!important;padding-bottom:110px!important;background:var(--corp-soft)!important}
.media-bg-card{margin:0 5vw!important;border:0!important;border-radius:2px!important;box-shadow:var(--corp-shadow)!important}
.media-bg-card:after{background:linear-gradient(90deg,rgba(5,20,35,.85),rgba(5,20,35,.15))!important}

/* ABOUT / VALUES */
.about{padding-top:110px!important;padding-bottom:80px!important}
.about-grid{gap:7vw!important}
.about-content h2{font-size:clamp(42px,5vw,70px)!important}
.about-image{border-radius:2px!important;box-shadow:var(--corp-shadow)!important}
.values{background:var(--corp-soft)!important;padding-top:95px!important;padding-bottom:95px!important}
.value{background:#fff!important;border:1px solid var(--corp-line)!important;box-shadow:none!important}
.value:hover{box-shadow:var(--corp-shadow)!important;transform:translateY(-4px)!important}
.value-number{color:var(--corp-blue)!important}
.value h3{color:var(--corp-navy)!important}
.value p{color:var(--corp-muted)!important}

/* CONTACT */
.contact-hero,.contact-section,.contact-cta{background:#fff!important;color:var(--corp-text)!important}
.contact-hero{padding-top:100px!important;padding-bottom:75px!important}
.contact-hero h1{color:var(--corp-navy)!important;font-size:clamp(56px,7vw,100px)!important;letter-spacing:-.07em!important}
.contact-hero h1 span,.contact h2 span{color:var(--corp-blue)!important}
.contact-grid{border-top:1px solid var(--corp-line)!important}
.contact-label,.contact-item strong{color:var(--corp-navy)!important}
.contact-description,.contact-item p{color:var(--corp-muted)!important}
.contact-form-wrap{
  background:#fff!important;border:1px solid var(--corp-line)!important;
  border-radius:3px!important;box-shadow:var(--corp-shadow)!important;
}
.form-field label{color:#344054!important;font-weight:700!important}
.form-field input,.form-field textarea,.form-field select{
  background:#fff!important;color:var(--corp-text)!important;
  border:1px solid #d0d5dd!important;border-radius:3px!important;
  box-shadow:none!important;
}
.form-field input:focus,.form-field textarea:focus,.form-field select:focus{border-color:var(--corp-blue)!important;box-shadow:0 0 0 3px rgba(21,94,239,.10)!important}
.contact-submit{background:var(--corp-blue)!important;border-color:var(--corp-blue)!important;color:#fff!important;border-radius:3px!important}
.contact-submit:hover{background:var(--corp-blue-dark)!important}
.contact-cta{border-top:1px solid var(--corp-line)!important}
.cta-button{background:var(--corp-blue)!important;color:#fff!important;border-color:var(--corp-blue)!important;border-radius:3px!important}

/* FOOTER */
.footer,.site-footer{
  background:var(--corp-navy)!important;color:#b8c2cf!important;
  border-top:0!important;
}
.footer a,.site-footer a{color:#d8e0e9!important}
.footer a:hover,.site-footer a:hover{color:#7daeff!important}

/* FLOATING CONTACT */
.float-action,.floating-contact a{
  background:#fff!important;color:var(--corp-navy)!important;
  border:1px solid var(--corp-line)!important;
  box-shadow:0 12px 35px rgba(16,42,67,.13)!important;
}
.float-action:hover,.floating-contact a:hover{color:var(--corp-blue)!important}

/* PRELOADER */
.preloader{background:#fff!important;color:var(--corp-navy)!important}
.preloader-meta{color:#667085!important}
.preloader-line{background:#e4eaf1!important}
.preloader-line i{background:var(--corp-blue)!important}

/* RESPONSIVE */
@media(max-width:1050px){
  .nav nav{gap:18px!important}
  .hero{grid-template-columns:1fr!important;min-height:auto!important;padding-top:80px!important}
  .hero-copy{max-width:800px!important}
  .hero-art{height:520px!important;margin-top:10px!important}
  .service-grid{grid-template-columns:1fr 1fr!important}
}
@media(max-width:760px){
  .nav{height:72px!important}
  .nav nav{display:none!important}
  .nav .cta{display:none!important}
  .hero{padding:75px 6% 65px!important}
  .hero h1{font-size:clamp(48px,15vw,76px)!important}
  .hero-lead{font-size:15px!important}
  .hero-art{height:390px!important}
  .hero-art:before{inset:0 0 30px 0!important}
  .world-panel{inset:25px 15px 55px 25px!important}
  .floating-mini{transform:scale(.82)!important}
  .manifesto,.capabilities,.media,.about,.values,.contact-section{padding-left:6%!important;padding-right:6%!important}
  .service-grid{grid-template-columns:1fr!important}
  .service.service-photo{min-height:390px!important}
  .media-bg-card{margin:0!important;min-height:520px!important}
}


/* =========================================================
   FINAL CORPORATE NAV / MEGA MENU / CONTRAST FIX
   ========================================================= */
:root{
  --corp-navy:#0b1b2b;
  --corp-blue:#155eef;
  --corp-blue-dark:#0b4fce;
  --corp-text:#172536;
  --corp-muted:#667085;
  --corp-line:#dbe3eb;
  --corp-soft:#f5f8fb;
}

body{background:#fff!important;color:var(--corp-text)!important}
.nav{
  position:fixed!important;top:0;left:0;right:0;height:82px!important;
  padding:0 4.2vw!important;background:rgba(255,255,255,.94)!important;
  border-bottom:1px solid #e7edf3!important;backdrop-filter:blur(18px)!important;
  -webkit-backdrop-filter:blur(18px)!important;z-index:1000!important;
  color:var(--corp-text)!important;
}
.nav.is-scrolled{box-shadow:0 8px 28px rgba(15,39,64,.07)!important}
.nav .brand{color:var(--corp-navy)!important;flex:0 0 auto}
.nav .brand img{width:38px!important;height:38px!important}
.nav .brand-word{font-size:21px!important;color:var(--corp-navy)!important}
.nav .brand-word span{color:#55708b!important}
.main-nav{display:flex!important;align-items:center!important;gap:0!important;margin-left:auto!important;margin-right:30px!important;height:100%!important}
.main-nav>.nav-link,.main-nav>.nav-item>.nav-link{
  height:100%;display:flex;align-items:center;gap:6px;padding:0 16px!important;
  color:#344454!important;font:700 11px/1 Inter,Arial,sans-serif!important;
  letter-spacing:.08em!important;text-transform:uppercase!important;position:relative;
}
.main-nav>.nav-link:hover,.main-nav>.nav-item:hover>.nav-link,.main-nav>.nav-item>.nav-link:hover{color:var(--corp-blue)!important}
.nav-chevron{font-size:12px;line-height:1;color:#8796a5;transition:transform .2s}
.nav-item:hover .nav-chevron{transform:rotate(180deg)}
.nav-item{position:static!important;height:100%;display:flex;align-items:center}

/* Full corporate mega menu: opaque enough that white text never disappears. */
.mega-menu{
  position:absolute!important;top:81px!important;left:0!important;right:0!important;
  opacity:0;visibility:hidden;pointer-events:none;transform:translateY(-8px);
  transition:opacity .22s ease,transform .22s ease,visibility .22s ease;
  background:rgba(10,25,42,.985)!important;color:#fff!important;
  border-top:1px solid rgba(255,255,255,.09)!important;
  border-bottom:1px solid rgba(255,255,255,.12)!important;
  box-shadow:0 28px 60px rgba(7,25,43,.22)!important;
  z-index:9999!important;
}
.nav-item:hover>.mega-menu,.nav-item.mega-open>.mega-menu{
  opacity:1;visibility:visible;pointer-events:auto;transform:none;
}
.mega-inner{
  width:min(1380px,92vw);margin:0 auto;min-height:390px;padding:44px 0 42px;
  display:grid;grid-template-columns:260px 1fr 230px;gap:54px;
}
.mega-intro{border-right:1px solid rgba(255,255,255,.12);padding-right:35px}
.mega-kicker{display:block;font:700 10px/1.2 "DM Mono",monospace;letter-spacing:.16em;color:#8fb9e8;margin-bottom:22px}
.mega-intro h3{font:700 34px/1.02 Manrope,Arial,sans-serif;letter-spacing:-.045em;margin:0 0 18px;color:#fff}
.mega-intro h3 em{font-style:normal;color:#8bb8e9;font-weight:400}
.mega-intro p{font:400 13px/1.7 Inter,Arial,sans-serif;color:#b7c5d3;margin:0 0 24px}
.mega-view{display:inline-flex!important;align-items:center;gap:10px;color:#fff!important;font:700 10px/1 Inter,Arial,sans-serif!important;text-transform:uppercase;letter-spacing:.08em;border-bottom:1px solid rgba(255,255,255,.45);padding-bottom:8px}
.mega-view b{font-size:15px;color:#8fb9e8}
.mega-cols{display:grid;grid-template-columns:repeat(3,minmax(150px,1fr));gap:35px}
.mega-col h4{font:700 10px/1.2 Inter,Arial,sans-serif;letter-spacing:.1em;color:#fff;margin:2px 0 18px}
.mega-col a{display:block!important;color:#c6d1dc!important;font:500 13px/1.35 Inter,Arial,sans-serif!important;padding:7px 0!important;text-transform:none!important;letter-spacing:0!important}
.mega-col a:hover{color:#fff!important;transform:translateX(3px)}
.mega-feature{border-left:1px solid rgba(255,255,255,.12);padding-left:30px;display:flex;flex-direction:column;justify-content:center}
.mega-feature>span{font:700 9px/1.2 "DM Mono",monospace;letter-spacing:.14em;color:#8fb9e8;margin-bottom:15px}
.mega-feature strong{font:700 28px/1.05 Manrope,Arial,sans-serif;letter-spacing:-.04em;color:#fff}
.mega-feature a{display:inline-flex!important;width:max-content;margin-top:25px;background:#fff;color:var(--corp-navy)!important;padding:11px 14px!important;font:700 10px/1 Inter,Arial,sans-serif!important;text-transform:uppercase!important;letter-spacing:.08em!important}
.mega-feature a:hover{background:#dfeeff!important;color:var(--corp-blue)!important}
.mega-feature-blue{background:linear-gradient(135deg,rgba(21,94,239,.28),rgba(21,94,239,.06));border-left:0;padding:26px;border:1px solid rgba(130,181,255,.18)}

.nav .cta{
  flex:0 0 auto!important;background:var(--corp-blue)!important;color:#fff!important;
  padding:13px 17px!important;border-radius:3px!important;font:700 10px/1 Inter,Arial,sans-serif!important;
  letter-spacing:.08em!important;text-transform:uppercase!important;white-space:nowrap;
}
.nav .cta:hover{background:var(--corp-blue-dark)!important}

/* Language dropdown — real images + working click target */
.language-selector{position:relative!important;height:100%;display:flex;align-items:center;margin-left:4px}
.language-current{
  height:40px!important;min-width:74px!important;padding:0 11px!important;
  display:flex!important;align-items:center!important;justify-content:center!important;gap:8px!important;
  border:1px solid #d5dee7!important;background:#fff!important;color:#344454!important;
  border-radius:3px!important;cursor:pointer!important;font:700 10px/1 Inter,Arial,sans-serif!important;
}
.language-current:hover{border-color:#9eb4ca!important;color:var(--corp-blue)!important}
.language-current .flag-img,.language-menu .flag-img{width:19px!important;height:13px!important;object-fit:cover!important;border-radius:2px!important;display:block!important}
.language-current b{font-size:12px!important;font-weight:700!important;color:#7a8998!important;transition:transform .2s}
.language-selector.open .language-current b{transform:rotate(180deg)}
.language-menu{
  position:absolute!important;right:0!important;top:calc(100% + 9px)!important;width:172px!important;
  padding:7px!important;display:grid!important;grid-template-columns:1fr 1fr!important;gap:2px!important;
  background:#fff!important;border:1px solid #dbe3eb!important;border-radius:4px!important;
  box-shadow:0 18px 45px rgba(15,39,64,.16)!important;opacity:0!important;visibility:hidden!important;
  pointer-events:none!important;transform:translateY(-5px)!important;transition:.18s ease!important;z-index:10000!important;
}
.language-selector.open .language-menu{opacity:1!important;visibility:visible!important;pointer-events:auto!important;transform:none!important}
.language-menu button{
  min-height:34px!important;border:0!important;background:#fff!important;color:#344454!important;
  display:flex!important;align-items:center!important;gap:8px!important;padding:7px 8px!important;
  border-radius:2px!important;cursor:pointer!important;font:700 10px/1 Inter,Arial,sans-serif!important;
}
.language-menu button:hover{background:#eef5fc!important;color:var(--corp-blue)!important}
#google_translate_element{display:none!important}
.goog-te-banner-frame,.goog-te-balloon-frame{display:none!important}
body{top:0!important}

/* Contrast fixes: sections that were white-on-white in the redesign. */
.manifesto,.about,.partners,.contact-hero,.contact-section,.contact-cta,.values,.capabilities,.services,.services-detail{color:var(--corp-text)!important}
.manifesto h2,.about h2,.section-head h2,.contact-hero h1,.contact h2{color:var(--corp-navy)!important}
.manifesto h2 i,.about h2 i,.section-head h2 i{color:#667085!important}
.section-head>p,.muted,.about p,.contact-description,.contact-item p{color:#667085!important}
.capabilities,.services,.services-detail{background:#fff!important}
.section-tag,.kicker,.eyebrow{color:#64748b!important}
.service-grid{background:#e3eaf1!important}
.service.service-photo{border:1px solid #dbe3eb!important}
.media{background:#f4f7fa!important;color:var(--corp-text)!important}
.media .media-kicker,.media .media-label{color:#155eef!important}
.media-title h2,.media-card-copy h2{color:var(--corp-navy)!important}
.media-title p,.media-card-copy p{color:#667085!important}
.languages{background:#eaf3ff!important;color:var(--corp-navy)!important}
.language-big span{color:var(--corp-navy)!important}
.language-big span:nth-child(even){color:#55708b!important}

/* Make the first viewport read like a serious enterprise website. */
.hero{padding-top:150px!important;background:#fff!important;color:var(--corp-navy)!important}
.hero h1{color:var(--corp-navy)!important}
.hero h1 span{color:var(--corp-blue)!important}
.hero-lead{color:#5d6b79!important}
.hero-grid{opacity:.45!important;background-image:linear-gradient(rgba(16,52,84,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(16,52,84,.055) 1px,transparent 1px)!important}
.hero-foot{color:#718096!important;border-color:#dce5ed!important}
.btn-light{background:var(--corp-blue)!important;color:#fff!important}
.text-link{color:var(--corp-navy)!important}
.text-link span{color:var(--corp-blue)!important}
.world-panel{border-color:#d7e2ec!important;background:linear-gradient(145deg,#f8fbfe,#edf4fa)!important;color:var(--corp-navy)!important;box-shadow:0 30px 80px rgba(19,55,90,.12)!important}
.world-top,.world-bottom{color:#5f7183!important;border-color:#d7e2ec!important}
.center-orb{background:#fff!important;box-shadow:0 18px 45px rgba(21,94,239,.15)!important}

/* Hover affordance stays on top of page content. */
@media(min-width:761px){
  .nav-item.has-mega:hover::after{content:"";position:absolute;left:0;right:0;top:81px;height:8px}
}

@media(max-width:1050px){
  .main-nav>.nav-link,.main-nav>.nav-item>.nav-link{padding:0 9px!important}
  .main-nav{margin-right:12px!important}
  .mega-inner{width:94vw;grid-template-columns:210px 1fr;gap:28px}
  .mega-feature{display:none}
}
@media(max-width:760px){
  .nav{height:72px!important;padding:0 5%!important}
  .nav .brand-word{font-size:18px!important}
  .main-nav{display:none!important}
  .nav .cta{display:none!important}
}


/* =========================================================
   FINAL UX / READABILITY POLISH — 26 AUG 2026
   ========================================================= */

/* Global type scale */
body{font-size:16px!important;color:var(--corp-text)!important}
p{font-size:16px}

/* CTA wording + softer corporate controls */
.nav .cta,
.cta-button,
.contact-submit,
.btn,
.btn-light,
.mega-feature a{
  border-radius:10px!important;
}
.nav .cta{padding:13px 20px!important;font-size:12px!important}
.btn,.btn-light{padding:15px 22px!important}

/* HERO: never use white body text on the white corporate layout */
.hero,
.hero-copy,
.hero-copy *{color:var(--corp-navy)}
.hero h1{font-size:clamp(60px,6.8vw,98px)!important}
.hero-lead,
.hero p,
.hero-copy p{color:#526476!important;font-size:18px!important;line-height:1.75!important;text-shadow:none!important}
.hero-trust{color:#66788a!important;font-size:10px!important}
.hero-trust b{background:#b8c7d5!important}
.text-link{font-size:13px!important}

/* Services page: its long-form cards sit on white, so use dark readable type. */
.services .service{
  background:#fff!important;
  color:var(--corp-text)!important;
  border-top:1px solid var(--corp-line)!important;
  border-bottom:1px solid var(--corp-line)!important;
  border-left:1px solid var(--corp-line)!important;
  border-right:1px solid var(--corp-line)!important;
  box-shadow:0 10px 35px rgba(16,42,67,.045)!important;
}
.services .service:hover{background:#fbfdff!important;transform:none!important}
.services .service h3,
.services .service h3 span{
  color:var(--corp-navy)!important;
  text-shadow:none!important;
}
.services .service h3{font-size:34px!important;line-height:1.1!important}
.services .service h3 span{color:var(--corp-blue)!important}
.services .service p,
.services .service .scope,
.services .service .scope li,
.services .service .scope strong{
  color:#526476!important;
}
.services .service p{font-size:16px!important;line-height:1.8!important}
.services .service .scope{font-size:15px!important;line-height:1.7!important}
.services .service .scope strong{font-weight:700!important;color:var(--corp-navy)!important}
.services .service .scope li:before{color:var(--corp-blue)!important}
.services .service .number{color:var(--corp-blue)!important;font-size:13px!important;font-weight:700!important}
.services .pill,
.services .pillrow .pill{
  background:#f2f6fa!important;
  color:#355069!important;
  border:1px solid #dbe5ee!important;
  border-radius:999px!important;
  font-size:11px!important;
  padding:7px 11px!important;
}
.services .section-title h2{font-size:clamp(46px,5.3vw,78px)!important;color:var(--corp-navy)!important}
.services .section-title p{font-size:17px!important;color:#526476!important;line-height:1.8!important}
.services .kicker{color:var(--corp-blue)!important}

/* Home service cards: preserve their images, but make every text layer readable. */
.service-photo h3{font-size:30px!important}
.service-photo p{font-size:16px!important;line-height:1.7!important}

/* About / content-heavy sections */
.about p,.about-content p,.values .value p,
.contact-description,.contact-item p{font-size:16px!important;line-height:1.8!important;color:#526476!important}
.about h2,.values h2,.contact h2{font-size:clamp(46px,5.5vw,76px)!important}
.value h3{font-size:22px!important}

/* Language area should not create pale-on-pale text. */
.languages{background:#eef5fc!important;color:var(--corp-navy)!important}
.languages p,.languages .muted{color:#526476!important}
.language-big span{font-size:clamp(24px,3vw,42px)!important;color:var(--corp-navy)!important}

/* Mega menu: visible on hover, no click needed to open. */
@media(min-width:761px){
  .nav-item.has-mega:hover>.mega-menu,
  .nav-item.has-mega:focus-within>.mega-menu,
  .nav-item.has-mega.mega-open>.mega-menu{
    opacity:1!important;visibility:visible!important;pointer-events:auto!important;transform:none!important;
  }
  .nav-item.has-mega>.nav-link{cursor:pointer!important}
}

/* Make hover menus slightly roomier / more readable. */
.mega-inner{min-height:410px!important;padding:48px 0!important}
.mega-intro h3{font-size:37px!important}
.mega-intro p,.mega-col a{font-size:14px!important}
.mega-col a{padding:8px 0!important}
.mega-col h4{font-size:11px!important}
.mega-feature strong{font-size:30px!important}
.mega-feature a{border-radius:9px!important}

/* Language dropdown: larger hit targets + rounded UI. */
.language-current{border-radius:10px!important;height:42px!important;min-width:78px!important}
.language-menu{border-radius:12px!important;padding:8px!important;width:190px!important}
.language-menu button{border-radius:8px!important;min-height:38px!important;font-size:11px!important}

/* All ordinary buttons/inputs get the same softer radius. */
button,input,textarea,select,.cta-button,.contact-form-wrap{border-radius:10px!important}

/* Keep tiny labels intentionally small, but readable. */
.section-tag,.kicker,.eyebrow,.mega-kicker{font-size:11px!important}

/* Mobile */
@media(max-width:760px){
  .hero h1{font-size:clamp(48px,14vw,76px)!important}
  .hero-lead,.hero p{font-size:16px!important}
  .services .service h3{font-size:28px!important}
  .services .service p{font-size:15px!important}
  .services .section-title p{font-size:16px!important}
}


/* =========================================================
   GOOGLE REVIEWS — HOME PAGE
   ========================================================= */
.google-reviews{
  padding:110px clamp(28px,6vw,96px) 120px;
  background:#f8f8fb;
  border-top:1px solid #e8eaf0;
  overflow:hidden;
}
.google-reviews .section-tag{margin-bottom:28px}
.reviews-head{
  display:grid;
  grid-template-columns:minmax(0,1fr) auto;
  gap:50px;
  align-items:end;
  max-width:1380px;
  margin:0 auto 48px;
}
.reviews-head h2{
  margin:0 0 18px;
  color:#0b1b2e;
  font-size:clamp(42px,5vw,78px);
  line-height:.98;
  letter-spacing:-.045em;
}
.reviews-head h2 i{color:#2367e8;font-weight:400}
.reviews-head p{
  max-width:680px;
  margin:0;
  color:#52647b;
  font-size:18px;
  line-height:1.7;
}
.reviews-rating{
  min-width:260px;
  padding:25px 28px;
  border:1px solid #dfe4ec;
  border-radius:18px;
  background:#fff;
  color:#0b1b2e;
  text-decoration:none;
  display:flex;
  flex-direction:column;
  gap:6px;
  box-shadow:0 16px 45px rgba(20,35,55,.06);
}
.reviews-rating strong{font-size:40px;line-height:1}
.review-stars{color:#f4b400;letter-spacing:2px;font-size:18px}
.reviews-rating small{color:#6c7a8e;font-size:13px}
.reviews-rating b{color:#2367e8;font-size:13px;margin-top:8px}
.reviews-track{
  max-width:1380px;
  margin:0 auto;
  display:grid;
  grid-template-columns:repeat(5,minmax(270px,1fr));
  gap:18px;
}
.review-card{
  min-height:300px;
  padding:24px;
  border:1px solid #e1e5eb;
  border-radius:18px;
  background:#fff;
  box-shadow:0 12px 35px rgba(20,35,55,.05);
  display:flex;
  flex-direction:column;
}
.review-top{display:flex;align-items:center;gap:12px}
.review-avatar{
  width:42px;height:42px;border-radius:50%;
  display:grid;place-items:center;
  background:#edf3ff;color:#2367e8;font-weight:700;font-size:13px;
  flex:none;
}
.review-top div{min-width:0;flex:1}
.review-top strong{display:block;color:#15263a;font-size:15px}
.review-top small{display:block;color:#8290a2;font-size:11px;margin-top:3px}
.google-g{font-size:18px;font-weight:800;color:#4285f4}
.review-card>.review-stars{margin:20px 0 12px;font-size:16px}
.review-card p{margin:0;color:#52647b;font-size:15px;line-height:1.7}
.reviews-note{
  max-width:1380px;margin:28px auto 0;
  color:#8995a5;font-size:12px;
}
.reviews-note a{color:#2367e8;text-decoration:none}
@media(max-width:1100px){
  .reviews-track{display:flex;overflow-x:auto;padding-bottom:12px;scroll-snap-type:x mandatory}
  .review-card{min-width:330px;scroll-snap-align:start}
}
@media(max-width:720px){
  .google-reviews{padding:80px 20px}
  .reviews-head{grid-template-columns:1fr;gap:28px}
  .reviews-rating{min-width:0}
  .review-card{min-width:290px}
}

/* =========================================================
   REVIEWS NAV + DEDICATED REVIEWS PAGE
   ========================================================= */
.nav-reviews-link{white-space:nowrap}
.reviews-teaser{padding:105px clamp(28px,6vw,96px);background:#f5f7fb;border-top:1px solid #e6eaf1}
.reviews-teaser-inner{max-width:1380px;margin:0 auto;display:flex;align-items:end;justify-content:space-between;gap:40px}
.reviews-teaser h2{margin:0 0 16px;color:#0b1b2e;font-size:clamp(42px,5vw,76px);line-height:.98;letter-spacing:-.045em}
.reviews-teaser h2 i{color:#2367e8;font-weight:400}
.reviews-teaser p{max-width:650px;color:#52647b;font-size:18px;line-height:1.7;margin:0}
.btn-dark{background:#0b1b2e!important;color:#fff!important;border-color:#0b1b2e!important;border-radius:12px!important}
.reviews-page{background:#f8f9fc;min-height:100vh}
.reviews-hero{padding:125px clamp(28px,6vw,96px) 70px;background:#fff;border-bottom:1px solid #e5e9f0}
.reviews-page-head{max-width:1380px;margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:70px;align-items:end}
.reviews-page-head h1{font-size:clamp(58px,7vw,110px);line-height:.92;letter-spacing:-.055em;color:#0b1b2e;margin:0 0 28px}
.reviews-page-head h1 i{font-weight:400;color:#2367e8}
.reviews-page-head p{max-width:720px;color:#52647b;font-size:20px;line-height:1.7;margin:0}
.reviews-rating-large{min-width:280px;padding:30px;border-radius:22px}
.reviews-all{padding:80px clamp(28px,6vw,96px) 120px}
.reviews-grid{max-width:1380px;margin:0 auto;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
.review-card-large{min-height:340px;padding:30px;border-radius:20px}
.review-card-large p{font-size:16px;line-height:1.75}
.reviews-page-note{max-width:1380px;margin:28px auto 0;color:#7c899a;font-size:13px;line-height:1.6}
.reviews-page-actions{max-width:1380px;margin:35px auto 0;display:flex;align-items:center;gap:25px}
@media(max-width:1000px){.reviews-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.reviews-page-head{grid-template-columns:1fr}.reviews-teaser-inner{align-items:flex-start;flex-direction:column}}
@media(max-width:650px){.reviews-grid{grid-template-columns:1fr}.reviews-page-head h1{font-size:52px}.reviews-page-actions{flex-direction:column;align-items:flex-start}.reviews-rating-large{min-width:0;width:100%}}


/* =========================================================
   eSenceDesk V7 — shared header, footer, privacy & reviews
   ========================================================= */
:root{--corp-navy:#0b1220;--corp-blue:#2367e8;--corp-red:#e72c2c;--corp-ink:#102038;--corp-muted:#607086;--corp-bg:#f7f9fc;--corp-line:#dfe6ef}
.nav{z-index:1000!important}
.nav .brand img{object-fit:contain}.nav .nav-link,.nav .cta,.language-current{font-weight:700}
.nav .nav-link{transition:color .2s ease}.nav .nav-link:hover{color:var(--corp-blue)!important}
.mega-menu{z-index:1005!important}
.cta,.btn,.contact-submit,.mega-view{border-radius:12px!important}

.corporate-footer{background:#0b1220!important;color:#fff!important;padding:72px clamp(28px,6vw,96px) 26px!important;border-top:1px solid rgba(255,255,255,.08)!important}
.footer-main{max-width:1400px;margin:0 auto;display:grid;grid-template-columns:1.6fr repeat(3,1fr);gap:50px}
.footer-brand img{width:42px;height:42px;object-fit:contain;display:block;margin-bottom:16px;filter:brightness(0) invert(1)}
.footer-brand strong{display:block;font:800 28px/1 Manrope,sans-serif;letter-spacing:-.05em;color:#fff}
.footer-brand p{max-width:330px;color:#aab6c7;font:400 14px/1.7 Inter,sans-serif;margin:16px 0}
.footer-location{color:#d8e1ee!important;text-decoration:none;font-size:12px}.footer-location:hover{color:#79aaff!important}
.footer-col h4{margin:0 0 18px;font:700 10px/1 "DM Mono",monospace;letter-spacing:.16em;color:#7daeff}
.footer-col a{display:block;color:#dce5f0!important;text-decoration:none;font:500 13px/1.35 Inter,sans-serif;margin:0 0 13px;transition:transform .2s,color .2s}.footer-col a:hover{color:#fff!important;transform:translateX(3px)}
.footer-bottom{max-width:1400px;margin:55px auto 0;padding-top:20px;border-top:1px solid rgba(255,255,255,.12);display:flex;justify-content:space-between;gap:20px;color:#8795a8;font:500 10px "DM Mono",monospace;letter-spacing:.08em;text-transform:uppercase}

.privacy-consent{display:flex!important;align-items:flex-start;gap:11px!important;margin:2px 0 3px!important;font:500 12px/1.5 Inter,sans-serif!important;color:#53647a!important;text-transform:none!important;letter-spacing:0!important;cursor:pointer}
.privacy-consent input{width:17px!important;height:17px!important;min-width:17px;margin:1px 0 0!important;accent-color:var(--corp-blue);border:1px solid #c8d2df!important}
.privacy-consent a{color:var(--corp-blue)!important;text-decoration:underline!important}

.legal-page{background:#f7f9fc!important;color:var(--corp-ink)!important}
.legal-content{padding:150px 6vw 90px;background:linear-gradient(180deg,#fff 0,#f7f9fc 100%)}
.legal-wrap{max-width:980px;margin:0 auto}.legal-wrap .section-tag{color:#5b6c82}.legal-wrap h1{font:800 clamp(58px,8vw,112px)/.88 Manrope,sans-serif;letter-spacing:-.07em;margin:25px 0;color:#0b1b2e}.legal-wrap h1 i{font-weight:400;color:#2367e8}.legal-lead{max-width:780px;font:400 21px/1.7 Inter,sans-serif;color:#53647a}.legal-updated{font:600 11px "DM Mono",monospace;letter-spacing:.1em;text-transform:uppercase;color:#7d8a9a;margin:28px 0 70px}.legal-wrap section{padding:34px 0;border-top:1px solid #dfe6ef}.legal-wrap h2{font:800 24px/1.1 Manrope,sans-serif;color:#102038;margin:0 0 15px}.legal-wrap p{max-width:850px;font:400 16px/1.8 Inter,sans-serif;color:#53647a;margin:0}.legal-wrap a{color:#2367e8}.legal-wrap strong{color:#102038}

.review-avatar-link{display:grid!important;place-items:center;text-decoration:none!important;cursor:pointer}.review-avatar-link:hover{transform:scale(1.05)}
.review-top .google-g{font-family:Arial,sans-serif}

@media(max-width:900px){.footer-main{grid-template-columns:1fr 1fr}.footer-brand{grid-column:1/-1}.footer-bottom{flex-wrap:wrap}.legal-content{padding-top:120px}}
@media(max-width:600px){.corporate-footer{padding:55px 24px 22px!important}.footer-main{grid-template-columns:1fr;gap:32px}.footer-brand{grid-column:auto}.footer-bottom{display:grid;grid-template-columns:1fr;gap:10px;margin-top:35px}.legal-content{padding:105px 24px 60px}.legal-wrap h1{font-size:54px}.legal-lead{font-size:18px}}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#08090c;color:#f6f6f2;font-family:Inter,Arial,sans-serif;overflow-x:hidden}.noise{position:fixed;inset:0;pointer-events:none;opacity:.035;z-index:20;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.55'/%3E%3C/svg%3E")}.nav{position:fixed;z-index:50;top:0;left:0;right:0;height:92px;display:flex;align-items:center;padding:0 5vw;border-bottom:1px solid rgba(255,255,255,.09);background:rgba(8,9,12,.55);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}.brand{display:flex;align-items:center;gap:12px;color:#fff;text-decoration:none}.brand img{width:42px;height:42px;object-fit:contain}.brand-word{font:800 23px Manrope,sans-serif;letter-spacing:-1.4px}.brand-word span{font-weight:500}.nav nav{display:flex;gap:34px;margin:auto;font-size:12px;text-transform:uppercase;letter-spacing:.12em}.nav nav a{color:#a7a8ac;text-decoration:none;transition:.25s}.nav nav a:hover{color:#fff}.nav-cta{display:flex;gap:16px;align-items:center;color:#fff;text-decoration:none;font-size:12px;text-transform:uppercase;letter-spacing:.1em}.nav-cta b{font-size:20px;font-weight:400}.menu{display:none;background:none;border:0}.hero{min-height:100vh;position:relative;display:grid;grid-template-columns:54% 46%;align-items:center;padding:150px 5vw 90px;overflow:hidden;background:radial-gradient(circle at 75% 44%,#17213a 0,#0b0d14 28%,#08090c 58%)}.hero-grid{position:absolute;inset:0;opacity:.18;background-image:linear-gradient(rgba(255,255,255,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.06) 1px,transparent 1px);background-size:80px 80px;mask-image:linear-gradient(90deg,#000,transparent 85%)}.hero-copy{position:relative;z-index:3;max-width:750px}.eyebrow,.section-tag{font:500 10px "DM Mono",monospace;letter-spacing:.16em;text-transform:uppercase;color:#a5a8ae}.eyebrow{display:flex;align-items:center;gap:12px;margin-bottom:28px}.eyebrow em{font-style:normal;color:#5e626a;margin-left:15px}.pulse{width:7px;height:7px;border-radius:50%;background:#73b5ff;box-shadow:0 0 20px #4a9cff}.hero h1{font:800 clamp(68px,8.4vw,140px)/.86 Manrope,sans-serif;letter-spacing:-.075em;margin:0 0 36px}.hero h1 span{color:#5ca7ff}.hero-lead{max-width:510px;color:#a7a9af;font-size:17px;line-height:1.7;margin:0 0 38px}.hero-actions{display:flex;align-items:center;gap:30px}.btn{padding:18px 23px;border-radius:3px;text-decoration:none;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.08em}.btn-light{background:#f4f4ef;color:#08090c}.btn-light span{margin-left:20px;font-size:18px}.text-link{color:#d5d5d2;text-decoration:none;font-size:12px;text-transform:uppercase;letter-spacing:.1em}.text-link span{margin-left:12px;color:#5ca7ff}.hero-art{height:620px;position:relative}.glow{position:absolute;width:520px;height:520px;left:50%;top:50%;transform:translate(-50%,-50%);background:radial-gradient(circle,#3f85ff30 0,#2659a915 35%,transparent 68%);filter:blur(15px)}.sphere{position:absolute;width:310px;height:310px;border-radius:50%;left:50%;top:50%;transform:translate(-50%,-50%);background:radial-gradient(circle at 30% 25%,#9fd1ff,#377fd3 32%,#101c32 70%,#07090e);box-shadow:inset -35px -25px 70px #0008,0 0 100px #4d9bff22;display:grid;place-items:center}.sphere:before,.sphere:after{content:"";position:absolute;border:1px solid #7ebaff55;border-radius:50%;width:135%;height:42%;transform:rotate(-22deg)}.sphere:after{transform:rotate(22deg);width:120%;height:65%}.sphere-inner{font:800 100px Manrope;color:#fff;letter-spacing:-.15em;margin-left:-13px;text-shadow:0 10px 30px #000}.radar{position:absolute;width:520px;height:520px;border:1px solid #5b9fff22;border-radius:50%;left:50%;top:50%;transform:translate(-50%,-50%);animation:spin 25s linear infinite}.radar:before{content:"";position:absolute;inset:45px;border:1px dashed #5b9fff20;border-radius:50%}@keyframes spin{to{transform:translate(-50%,-50%) rotate(360deg)}}.language-card{position:absolute;z-index:4;width:125px;padding:15px;background:#11141aee;border:1px solid #ffffff16;box-shadow:0 20px 40px #0006;backdrop-filter:blur(12px)}.language-card small{font:500 9px "DM Mono";color:#5ca7ff}.language-card strong{display:block;font:700 19px Manrope;margin:5px 0}.language-card span{font-size:9px;color:#777b83}.c1{left:3%;top:19%}.c2{right:3%;top:11%}.c3{right:2%;bottom:18%}.c4{left:7%;bottom:8%}.hero-foot{position:absolute;bottom:25px;left:5vw;right:5vw;border-top:1px solid #ffffff14;padding-top:14px;display:flex;justify-content:space-between;font:500 9px "DM Mono";color:#555960;letter-spacing:.15em}.manifesto,.capabilities,.media,.languages,.about,.partners,.contact{padding:150px 8vw}.manifesto{display:grid;grid-template-columns:15% 55% 30%;gap:4%;background:#f2f1eb;color:#0b0c0f}.manifesto .section-tag,.about .section-tag{color:#71736f}.manifesto-text .kicker{font:500 12px "DM Mono";text-transform:uppercase;letter-spacing:.12em}.manifesto h2{font:700 clamp(38px,4.6vw,74px)/1.02 Manrope;letter-spacing:-.055em;margin:25px 0}.manifesto h2 i,.about h2 i{font-weight:400;color:#777}.muted{font-size:16px;line-height:1.8;color:#6c6e6a;max-width:660px}.stats{display:flex;flex-direction:column;justify-content:flex-end;gap:30px}.stats div{border-top:1px solid #0002;padding-top:12px}.stats strong{display:block;font:700 46px Manrope;letter-spacing:-.05em}.stats strong span{font-size:20px}.stats small{color:#777;font-size:11px;text-transform:uppercase;letter-spacing:.1em}.capabilities{background:#0b0c10}.section-head{display:grid;grid-template-columns:1fr 1fr;gap:10%;align-items:end;margin-bottom:80px}.section-head h2,.media-title h2{font:700 clamp(50px,6vw,92px)/.92 Manrope;letter-spacing:-.065em;margin:25px 0 0}.section-head h2 i{font-weight:400;color:#777}.section-head>p{max-width:470px;color:#777b83;line-height:1.8;margin:0}.service-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#24262c;border:1px solid #24262c}.service{min-height:390px;padding:32px;background:#0d0f13;position:relative;transition:transform .35s,background .35s}.service:hover{transform:translateY(-6px);background:#11151c;z-index:2}.service.featured{background:#e9e9e2;color:#0b0c0f}.service.dark{background:#151a24}.num{font:500 10px "DM Mono";color:#71757e}.service.featured .num{color:#74756f}.service-top{display:flex;justify-content:space-between;margin:45px 0 85px}.icon{font:600 28px Manrope}.arrow{font-size:22px}.service h3{font:700 29px/1 Manrope;letter-spacing:-.04em;margin:0 0 16px}.service p{font-size:13px;line-height:1.7;color:#858992;max-width:390px}.featured p{color:#666963}.chips{display:flex;gap:7px;flex-wrap:wrap;margin-top:22px}.chips b{font:500 8px "DM Mono";padding:6px 8px;border:1px solid #0002;text-transform:uppercase}.dark .chips b,.service:not(.featured) .chips b{border-color:#fff1;color:#aaa}.media{background:#111319}.media-top{display:flex;justify-content:space-between;align-items:center}.pill{font:500 9px "DM Mono";border:1px solid #ffffff16;border-radius:100px;padding:10px 13px;color:#9b9da4;text-transform:uppercase}.media-title{display:grid;grid-template-columns:1.2fr .8fr;gap:8%;align-items:end;margin:45px 0 75px}.media-title h2{margin:0}.media-title h2 span{color:#5ca7ff}.media-title p{color:#7d8189;line-height:1.8;margin:0}.screen{height:520px;border:1px solid #30333a;background:#090b0e;position:relative;overflow:hidden;box-shadow:0 30px 100px #0008}.screen:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 48% 48%,#26558a55,transparent 45%),linear-gradient(135deg,#172238,#090b0e 60%)}.screen-bar{position:absolute;top:0;left:0;right:0;padding:18px 22px;display:flex;justify-content:space-between;border-bottom:1px solid #ffffff12;font:500 8px "DM Mono";color:#777b84;z-index:2}.screen-content{height:100%;display:grid;place-items:center;position:relative}.play{width:74px;height:74px;border:1px solid #ffffff55;border-radius:50%;display:grid;place-items:center;font-size:15px;padding-left:3px;background:#ffffff0b;backdrop-filter:blur(8px)}.subtitle{position:absolute;bottom:82px;left:50%;transform:translateX(-50%);width:max-content;max-width:90%;text-align:center;font-size:17px;color:#fff;text-shadow:0 2px 10px #000}.subtitle span,.subtitle strong{display:block}.subtitle strong{font-weight:700}.timeline{position:absolute;bottom:0;left:0;right:0;height:38px;display:flex;align-items:center;gap:3px;padding:0 15px;background:#07080a;border-top:1px solid #fff1}.timeline i{height:3px;flex:1;background:#31343a}.timeline i:first-child{background:#5ca7ff}.media-list{display:grid;grid-template-columns:repeat(3,1fr);margin-top:45px;border-top:1px solid #ffffff14}.media-list span{padding:17px 0;border-bottom:1px solid #ffffff14;font:500 10px "DM Mono";color:#777b83;text-transform:uppercase}.languages{background:#5a9eff;color:#07101c;overflow:hidden}.language-big{display:flex;flex-wrap:wrap;gap:12px 20px;margin-top:50px}.language-big span{font:700 clamp(28px,4.5vw,72px)/1.05 Manrope;letter-spacing:-.06em}.language-big span:nth-child(even){font-weight:400}.about{background:#efeee8;color:#0b0c0f}.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:10%;margin-top:60px}.about h2{font:700 clamp(55px,7vw,110px)/.88 Manrope;letter-spacing:-.07em;margin:0}.about p{color:#6f716c;line-height:1.8}.about .big-p{font-size:22px;line-height:1.5;color:#3f403d;margin-top:0}.under{display:inline-block;color:#0b0c0f;text-decoration:none;border-bottom:1px solid #0b0c0f;padding-bottom:8px;margin-top:28px;font:600 11px "DM Mono";text-transform:uppercase}.partners{background:#efeee8;color:#0b0c0f;padding-top:0}.partner-row{margin-top:35px;padding-top:25px;border-top:1px solid #0002;display:flex;flex-wrap:wrap;gap:25px 50px}.partner-row span{font:600 11px "DM Mono";color:#777;text-transform:uppercase}.contact{position:relative;background:#090a0d;overflow:hidden}.contact-glow{position:absolute;width:700px;height:700px;right:-250px;top:-150px;background:radial-gradient(circle,#2469d633,transparent 65%);filter:blur(30px)}.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:12%;margin-top:55px;position:relative}.contact h2{font:700 clamp(60px,7vw,110px)/.88 Manrope;letter-spacing:-.07em;margin:0 0 25px}.contact h2 i{font-weight:400;color:#777}.contact-grid>div>p{color:#777b83}.contact-links{margin-top:80px;display:flex;flex-direction:column;gap:14px}.contact-links a{color:#f4f4ef;text-decoration:none;font:500 14px "DM Mono"}.contact form{display:flex;flex-direction:column;gap:27px}.contact label{font:500 9px "DM Mono";text-transform:uppercase;color:#777;letter-spacing:.12em}.contact input,.contact textarea{display:block;width:100%;margin-top:10px;border:0;border-bottom:1px solid #ffffff20;background:transparent;color:#fff;padding:13px 0;font:500 16px Inter;outline:0}.contact textarea{height:90px;resize:vertical}.contact input:focus,.contact textarea:focus{border-color:#5ca7ff}.contact button{border:0;background:#f4f4ef;color:#08090c;padding:19px 22px;text-align:left;font:700 11px "DM Mono";text-transform:uppercase;cursor:pointer;margin-top:8px}.contact button span{float:right;font-size:18px}.office{position:relative;margin-top:100px;padding-top:18px;border-top:1px solid #ffffff12;display:flex;justify-content:space-between;gap:40px}.office span{font:500 9px "DM Mono";color:#5e626a}.office strong{font:500 12px Inter;color:#999da4;max-width:600px;text-align:right;line-height:1.7}footer{padding:40px 5vw;background:#07080a;border-top:1px solid #ffffff10;display:flex;align-items:center;gap:25px;color:#5d6168;font-size:10px}.brand-foot{display:flex;align-items:center;gap:9px;color:#eee;font:700 15px Manrope}.brand-foot img{width:28px}.brand-foot span{letter-spacing:-.5px}.brand-foot+ p{margin-right:auto}.float-wa{position:fixed;right:25px;bottom:25px;z-index:40;width:185px;padding:13px 15px;background:#f3f3ee;color:#0b0c0f;text-decoration:none;display:grid;grid-template-columns:10px 1fr 22px;grid-template-rows:1fr 1fr;column-gap:8px;box-shadow:0 15px 45px #0008}.float-wa .wa-dot{width:7px;height:7px;border-radius:50%;background:#29b86a;grid-row:1/3;align-self:center}.float-wa b{font-size:11px}.float-wa small{font-size:9px;color:#777}.float-wa i{grid-row:1/3;grid-column:3;align-self:center;font-style:normal;font-size:18px}.float-mail{position:fixed;right:25px;bottom:125px;z-index:40;width:46px;height:46px;border:1px solid #ffffff20;background:#11141a;color:#fff;text-decoration:none;display:grid;place-items:center;font-size:17px;box-shadow:0 12px 35px #0008}@media(max-width:900px){.nav{height:76px;padding:0 5vw}.nav nav,.nav-cta{display:none}.menu{display:block;margin-left:auto}.menu i{display:block;width:24px;height:1px;background:#fff;margin:6px}.hero{grid-template-columns:1fr;padding-top:130px}.hero-art{height:430px;grid-row:2}.hero h1{font-size:17vw}.hero-foot{display:none}.manifesto,.section-head,.media-title,.about-grid,.contact-grid{grid-template-columns:1fr}.manifesto,.capabilities,.media,.languages,.about,.partners,.contact{padding:90px 6vw}.stats{margin-top:50px;display:grid;grid-template-columns:repeat(3,1fr)}.service-grid{grid-template-columns:1fr}.service{min-height:330px}.section-head>p{margin-top:25px}.media-title{gap:30px}.screen{height:360px}.media-list{grid-template-columns:1fr 1fr}.contact-links{margin-top:45px}.contact form{margin-top:50px}.office{flex-direction:column}.office strong{text-align:left}.float-wa{right:14px;bottom:14px}.float-mail{right:14px;bottom:80px}.cursor,.cursor-dot{display:none}}@media(max-width:520px){.brand-word{font-size:19px}.hero h1{font-size:18vw}.language-card{transform:scale(.8)}.c1{left:-4%}.c3{right:-4%}.sphere{width:245px;height:245px}.radar{width:350px;height:350px}.service-top{margin-bottom:55px}.stats{grid-template-columns:1fr}.language-big{gap:8px 12px}.language-big span{font-size:31px}.partner-row{gap:20px 30px}footer{flex-wrap:wrap}.brand-foot+p{width:100%;order:3}}
/* V3 visual system */
.hero-art{perspective:1200px}
.world-panel{position:absolute;inset:9% 3% 9% 3%;border:1px solid rgba(255,255,255,.13);background:linear-gradient(145deg,rgba(24,31,45,.88),rgba(8,11,17,.92));box-shadow:0 40px 100px rgba(0,0,0,.5),inset 0 1px rgba(255,255,255,.08);transform:rotateY(-8deg) rotateX(3deg);overflow:hidden;backdrop-filter:blur(18px)}
.world-top,.world-bottom{height:48px;display:flex;align-items:center;justify-content:space-between;padding:0 18px;border-bottom:1px solid rgba(255,255,255,.08);font:500 8px "DM Mono";letter-spacing:.14em;color:#727883}
.world-bottom{position:absolute;bottom:0;left:0;right:0;border-top:1px solid rgba(255,255,255,.08);border-bottom:0;justify-content:space-around}
.live{color:#71b4ff}.live i{display:inline-block;width:5px;height:5px;background:#64c98a;border-radius:50%;margin-right:5px;box-shadow:0 0 12px #64c98a}
.world-map{position:absolute;left:0;right:0;top:48px;bottom:48px;background:radial-gradient(circle at 55% 45%,rgba(78,151,255,.12),transparent 40%),linear-gradient(180deg,transparent 49.8%,rgba(91,159,255,.08) 50%,transparent 50.2%)}
.world-map:before,.world-map:after{content:"";position:absolute;inset:13% 8%;border:1px solid rgba(91,159,255,.07);border-radius:50%}
.world-map:after{inset:26% 16%;transform:rotate(20deg)}
.map-lines{position:absolute;inset:0;background-image:linear-gradient(rgba(91,159,255,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(91,159,255,.055) 1px,transparent 1px);background-size:42px 42px;mask-image:radial-gradient(circle,#000,transparent 76%)}
.routes{position:absolute;inset:0;width:100%;height:100%;overflow:visible}.routes path{fill:none;stroke:#5ca7ff;stroke-width:1.2;stroke-dasharray:5 8;opacity:.45;animation:dash 9s linear infinite}@keyframes dash{to{stroke-dashoffset:-260}}
.city{position:absolute;z-index:3;font:500 7px "DM Mono";color:#727d8c}.c-delhi{left:26%;top:55%}.c-london{left:50%;top:35%}.c-tokyo{right:13%;top:43%}.c-paris{left:48%;top:43%}.c-ny{left:19%;top:34%}
.node{position:absolute;width:6px;height:6px;background:#67afff;border-radius:50%;box-shadow:0 0 0 5px rgba(103,175,255,.09),0 0 20px #67afff;z-index:5}.n1{left:25%;top:54%}.n2{left:50%;top:34%}.n3{right:12%;top:42%}.n4{left:19%;top:33%}.n5{left:72%;top:68%}
.center-orb{position:absolute;left:50%;top:49%;transform:translate(-50%,-50%);width:116px;height:116px;border-radius:50%;display:grid;place-content:center;text-align:center;background:radial-gradient(circle at 35% 25%,#8bc8ff,#1c5ca8 38%,#0a1424 72%);box-shadow:0 0 70px rgba(82,160,255,.24),inset -15px -18px 30px rgba(0,0,0,.4);border:1px solid rgba(255,255,255,.25);animation:orbFloat 5s ease-in-out infinite}.center-orb span{font:800 42px Manrope;letter-spacing:-.15em;margin-left:-6px}.center-orb b{font:500 7px "DM Mono";letter-spacing:.25em;margin-top:4px;color:#d7e9ff}@keyframes orbFloat{50%{transform:translate(-50%,-54%)}}
.floating-mini{position:absolute;z-index:7;padding:13px 14px;background:rgba(13,16,22,.9);border:1px solid rgba(255,255,255,.14);box-shadow:0 18px 45px rgba(0,0,0,.4);backdrop-filter:blur(12px);min-width:110px}.floating-mini b{display:block;font:700 23px Manrope;letter-spacing:-.05em}.floating-mini b span{font-size:10px;color:#6faeff}.floating-mini>span{font:500 7px "DM Mono";color:#686e79;letter-spacing:.1em}.m1{left:-1%;top:15%}.m2{right:-2%;top:31%}.m3{left:5%;bottom:4%}
.marquee{overflow:hidden;background:#5ca7ff;color:#07101b;border-top:1px solid #0002;border-bottom:1px solid #0002;padding:18px 0;white-space:nowrap}.marquee>div{display:flex;align-items:center;gap:28px;width:max-content;animation:marquee 22s linear infinite}.marquee span{font:800 18px Manrope;letter-spacing:-.03em}.marquee b{font-size:12px}@keyframes marquee{to{transform:translateX(-50%)}}
.process{padding:130px 8vw;background:#e9e8e1;color:#0b0c0f}.process-head{display:grid;grid-template-columns:1fr 1fr;gap:10%;align-items:end;margin:45px 0 70px}.process-head h2{font:700 clamp(50px,6vw,88px)/.9 Manrope;letter-spacing:-.065em;margin:0}.process-head h2 i{font-weight:400;color:#777}.process-head p{color:#70726d;line-height:1.8;max-width:450px}.process-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid #0002}.process-grid>div{padding:28px 25px 10px;border-right:1px solid #0002;min-height:220px}.process-grid>div:last-child{border-right:0}.process-grid span{font:500 10px "DM Mono";color:#858780}.process-grid b{display:block;margin-top:70px;font:700 18px Manrope}.process-grid p{font-size:12px;color:#777;line-height:1.6;max-width:190px}
.float-actions{position:fixed;right:24px;bottom:24px;z-index:60;display:flex;flex-direction:column;gap:10px}.float-action{width:54px;height:54px;border-radius:50%;display:grid;place-items:center;text-decoration:none;position:relative;box-shadow:0 15px 35px rgba(0,0,0,.35);transition:transform .25s,box-shadow .25s}.float-action:hover{transform:translateY(-4px) scale(1.06);box-shadow:0 20px 45px rgba(0,0,0,.5)}.float-icon{font-size:21px;font-weight:500}.float-label{position:absolute;right:68px;opacity:0;transform:translateX(8px);white-space:nowrap;background:#11151c;color:#fff;padding:9px 12px;font:600 9px "DM Mono";text-transform:uppercase;letter-spacing:.08em;pointer-events:none;transition:.2s}.float-action:hover .float-label{opacity:1;transform:translateX(0)}.whatsapp{background:#27c76f;color:#fff}.phone{background:#f2f2ed;color:#0a0b0e}.mail{background:#5ca7ff;color:#07101b}
@media(max-width:900px){.world-panel{inset:5% 0 7%}.process-head{grid-template-columns:1fr}.process-grid{grid-template-columns:1fr 1fr}.process-grid>div:nth-child(2){border-right:0}.process-grid>div:nth-child(3),.process-grid>div:nth-child(4){border-top:1px solid #0002}.floating-mini{transform:scale(.85)}.m1{left:-4%}.m2{right:-4%}}
@media(max-width:520px){.hero-art{height:390px}.world-panel{inset:4% -5% 8%}.floating-mini{transform:scale(.72)}.m1{left:-8%}.m2{right:-8%}.m3{left:0;bottom:0}.process{padding:90px 6vw}.process-grid{grid-template-columns:1fr}.process-grid>div{border-right:0;border-bottom:1px solid #0002;min-height:160px}.process-grid>div:nth-child(3){border-top:0}.process-grid>div:last-child{border-bottom:0}.process-grid b{margin-top:35px}.float-actions{right:13px;bottom:13px}.float-action{width:48px;height:48px}.float-label{display:none}}

/* ULTRA PREMIUM V4 */
body{cursor:auto}.preloader{position:fixed;inset:0;z-index:9999;background:#08090c;display:grid;place-content:center;justify-items:center;transition:opacity .8s,visibility .8s}.preloader.done{opacity:0;visibility:hidden;pointer-events:none}.preloader-mark{width:72px;height:72px;margin-bottom:28px}.preloader-mark img{width:100%;height:100%}.preloader-line{width:240px;height:1px;background:#fff1;overflow:hidden}.preloader-line i{display:block;height:100%;width:35%;background:#5ca7ff;animation:load 1.2s infinite}@keyframes load{to{transform:translateX(700%)}}.preloader-meta{width:240px;margin-top:11px;display:flex;justify-content:space-between;font:500 7px "DM Mono";letter-spacing:.12em;color:#666}.scroll-progress{position:fixed;z-index:100;top:0;left:0;width:0;height:2px;background:#6baeff;box-shadow:0 0 18px #5ca7ff}.nav{height:88px;transition:.35s}.nav.is-scrolled{background:#07080ae8;box-shadow:0 18px 60px #0005}.nav-status{display:flex;align-items:center;gap:8px;margin-left:auto;margin-right:28px;font:500 7px "DM Mono";letter-spacing:.14em;color:#6e747d}.nav-status i{width:5px;height:5px;border-radius:50%;background:#67c88a;box-shadow:0 0 12px #67c88a}.hero{min-height:100svh;padding-top:145px;background:radial-gradient(circle at 74% 45%,#1b2946 0,#0b0d14 27%,#08090c 59%)}.hero h1{font-size:clamp(76px,8.8vw,150px);line-height:.82}.hero h1 span{position:relative}.hero h1 span:after{content:"";position:absolute;left:2px;right:-5px;bottom:-8px;height:1px;background:linear-gradient(90deg,#62a9ff,transparent)}.hero-trust{display:flex;gap:12px;margin-top:55px;font:500 8px "DM Mono";letter-spacing:.13em;color:#656b75}.hero-trust b{width:3px;height:3px;border-radius:50%;background:#4f8fd8}.world-panel{box-shadow:0 50px 130px #0009,inset 0 1px #fff2;transform:rotateY(-5deg) rotateX(2deg)}.world-panel:after{content:"";position:absolute;inset:0;background:linear-gradient(120deg,transparent 25%,#fff1 42%,transparent 58%);transform:translateX(-120%);animation:sweep 7s infinite;pointer-events:none}@keyframes sweep{55%,100%{transform:translateX(120%)}}.center-orb{width:128px;height:128px}.floating-mini{border-radius:2px}.manifesto,.capabilities,.media,.languages,.about,.contact{padding-top:170px;padding-bottom:170px}.manifesto h2,.section-head h2,.media-title h2,.process-head h2{font-size:clamp(55px,6.4vw,98px)}.service-grid{grid-template-columns:repeat(2,1fr)}.service{min-height:420px}.service:nth-child(n+3){min-height:330px}.service:before{content:"";position:absolute;inset:0;border:1px solid transparent;transition:.35s;pointer-events:none}.service:hover:before{border-color:#5ca7ff55}.signal-strip{display:grid;grid-template-columns:repeat(3,1fr);background:#0a0b0f;border-block:1px solid #fff1}.signal-strip>div{padding:32px 5vw;border-right:1px solid #fff1}.signal-strip>div:last-child{border:0}.signal-strip span{display:block;font:500 8px "DM Mono";letter-spacing:.15em;color:#555b65;margin-bottom:12px}.signal-strip strong{font:600 14px Manrope;color:#d9dce0}.screen{height:590px;border-radius:3px}.screen:hover .play{transform:scale(1.08);background:#fff1}.languages{padding-top:165px;padding-bottom:165px}.language-big span{transition:.25s}.language-big span:hover{transform:translateY(-4px);color:#fff}.about h2,.contact h2{font-size:clamp(60px,7.5vw,118px)}.contact-end{margin-top:90px;padding-top:26px;border-top:1px solid #fff1;display:grid;grid-template-columns:1fr 1.5fr auto;align-items:center;gap:25px}.contact-end span,.contact-end a{font:500 8px "DM Mono";letter-spacing:.13em;color:#626872;text-decoration:none}.contact-end b{font:700 15px Manrope}.contact-end a{color:#dfe1e4;text-align:right}
@media(max-width:1000px){.nav-status{display:none}.hero{grid-template-columns:1fr}.hero-art{grid-row:2}.service-grid{grid-template-columns:1fr}.service:nth-child(n){grid-column:auto}.signal-strip{grid-template-columns:1fr}.signal-strip>div{border-right:0;border-bottom:1px solid #fff1}.signal-strip>div:last-child{border-bottom:0}}
@media(max-width:700px){.nav{height:76px}.nav nav,.nav-cta{display:none}.hero{padding-top:120px}.hero h1{font-size:17vw}.hero-art{height:450px}.hero-trust{flex-wrap:wrap}.manifesto,.capabilities,.media,.languages,.about,.contact{padding-left:6vw;padding-right:6vw}.process-grid{grid-template-columns:1fr 1fr}.contact-end{grid-template-columns:1fr}.contact-end a{text-align:left}}
@media(max-width:520px){.hero h1{font-size:18.5vw}.hero-art{height:385px}.world-panel{inset:3% -8% 7%}.center-orb{width:105px;height:105px}.floating-mini{transform:scale(.68)}.m1{left:-10%}.m2{right:-10%}.process-grid{grid-template-columns:1fr}.screen{height:320px}.contact-end{margin-top:65px}}

/* =========================================================
   eSenceDesk V5 — ART-DIRECTED LUXURY LAYER
   ========================================================= */
:root{
  --ink:#07080a;
  --paper:#f1efe9;
  --muted:#737984;
  --line:rgba(255,255,255,.095);
  --blue:#68aef8;
  --blue2:#9acbff;
}
body{background:var(--ink);overflow-x:hidden}
.luxury-grain{position:fixed;inset:-50%;z-index:9998;pointer-events:none;opacity:.035;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.55'/%3E%3C/svg%3E");animation:grain .25s steps(2) infinite}
@keyframes grain{0%{transform:translate(0,0)}25%{transform:translate(2%,-1%)}50%{transform:translate(-1%,2%)}75%{transform:translate(1%,1%)}100%{transform:translate(-2%,-1%)}}
.eyebrow{display:flex;align-items:center;gap:10px;margin-bottom:30px;font:500 8px "DM Mono";letter-spacing:.18em;color:#6f7680}.eyebrow span{width:26px;height:1px;background:var(--blue);box-shadow:0 0 14px #68aef8}
.hero{position:relative;isolation:isolate}
.hero:before{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,transparent 0,transparent 57%,rgba(104,174,248,.035) 75%,transparent 100%);pointer-events:none}
.hero-side-note{position:absolute;right:5vw;top:145px;z-index:3;width:125px;text-align:right;color:#616772}.hero-side-note span{display:block;font:500 8px "DM Mono";letter-spacing:.12em;margin-bottom:28px;color:#8c929a}.hero-side-note strong{display:block;font:600 19px Manrope;line-height:1.05;color:#dfe3e8;letter-spacing:-.04em}.hero-side-note em{display:block;margin-top:18px;font:400 8px "DM Mono";line-height:1.6;letter-spacing:.04em;color:#626974;font-style:normal}
.hero h1{letter-spacing:-.075em}
.hero h1 span{color:transparent;background:linear-gradient(110deg,#fff 0%,#7bb8ff 48%,#b8dcff 100%);-webkit-background-clip:text;background-clip:text}
.hero-lead{line-height:1.75}
.hero-art{filter:drop-shadow(0 35px 90px rgba(0,0,0,.35))}
.world-panel{border:1px solid rgba(255,255,255,.1);background:linear-gradient(145deg,#10131a,#090b10);overflow:hidden}
.world-panel:before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(90deg,transparent 0,transparent 79px,rgba(255,255,255,.018) 80px),repeating-linear-gradient(0deg,transparent 0,transparent 79px,rgba(255,255,255,.018) 80px);mask-image:linear-gradient(90deg,transparent,#000 15%,#000 85%,transparent)}
.floating-mini{box-shadow:0 20px 50px rgba(0,0,0,.45);backdrop-filter:blur(12px);border-color:rgba(255,255,255,.12)}
.mini-num{font-size:22px!important}
.manifesto{background:linear-gradient(180deg,#08090c,#0a0b0e)}
.manifesto h2{letter-spacing:-.06em;line-height:.98}
.stats{border-top:1px solid var(--line);padding-top:28px}
.stats>div{position:relative}.stats>div:before{content:"";position:absolute;left:0;top:-29px;width:18px;height:1px;background:var(--blue)}
.stats strong{letter-spacing:-.05em}.stats span{font-size:8px;letter-spacing:.14em}
.marquee{box-shadow:0 15px 70px rgba(92,167,255,.08);transform:rotate(-1deg) scale(1.02)}
.marquee span{letter-spacing:-.02em}
.section-head h2,.media-title h2,.process-head h2,.about h2,.contact h2{letter-spacing:-.065em;line-height:.92}
.section-head p{max-width:390px;line-height:1.8}
.service-grid{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.08);box-shadow:0 30px 100px rgba(0,0,0,.2)}
.service{background:linear-gradient(145deg,#0d0f13,#090a0d);transition:transform .45s cubic-bezier(.2,.8,.2,1),background .45s}
.service:hover{transform:translateY(-6px);background:linear-gradient(145deg,#11151b,#090a0d);z-index:2}
.service-number{color:#606772}
.service h3{letter-spacing:-.045em}
.service p{line-height:1.75}
.service-list li{border-color:rgba(255,255,255,.08)}
.service-list li:before{background:var(--blue)}
.signal-strip{margin-top:0}
.signal-strip>div{position:relative;overflow:hidden}
.signal-strip>div:after{content:"↗";position:absolute;right:28px;bottom:28px;font:400 15px "DM Mono";color:#3d4651;transition:.3s}.signal-strip>div:hover:after{color:var(--blue);transform:translate(3px,-3px)}
.media{position:relative}.media-kicker{display:flex;justify-content:space-between;align-items:center;margin-bottom:45px;font:500 8px "DM Mono";letter-spacing:.14em;color:#5d6570}.media-kicker b{color:#d9dde2;font-weight:500}.media-kicker i{font-style:normal}
.screen{border:1px solid rgba(255,255,255,.1);box-shadow:0 45px 100px rgba(0,0,0,.35);overflow:hidden}
.screen .play{border:1px solid rgba(255,255,255,.22);box-shadow:0 15px 45px rgba(0,0,0,.4)}
.media-list li{transition:.25s}.media-list li:hover{color:#fff;transform:translateX(4px)}
.language-big{letter-spacing:-.07em}
.language-big span{display:inline-block}
.language-big span:after{content:"";display:block;width:0;height:1px;background:var(--blue);transition:.35s}.language-big span:hover:after{width:100%}
.about-grid{position:relative}.about-grid:before{content:"ES";position:absolute;right:0;top:-90px;font:700 260px/1 Manrope;color:#fff008;opacity:.025;pointer-events:none}
.about p{line-height:1.85}
.partner-row span{border:1px solid rgba(255,255,255,.08);padding:15px 18px;min-width:140px;text-align:center;transition:.3s}.partner-row span:hover{border-color:#5ca7ff55;color:#fff;transform:translateY(-2px)}
.process-grid>div{background:linear-gradient(145deg,#0c0e12,#090a0d);border-color:rgba(255,255,255,.08);transition:.35s}.process-grid>div:hover{transform:translateY(-5px);border-color:#5ca7ff44}
.process-grid strong{letter-spacing:-.04em}.process-grid p{line-height:1.7}
.contact{background:radial-gradient(circle at 80% 20%,rgba(92,167,255,.08),transparent 30%)}
.contact-grid{border-top:1px solid var(--line);padding-top:55px}
.contact-item{transition:.3s}.contact-item:hover{transform:translateX(4px)}
.contact h2 span{color:#78b8ff}
.contact-end b{letter-spacing:-.03em}
.float-actions{z-index:80}
.float-action{box-shadow:0 16px 40px rgba(0,0,0,.3);transition:transform .25s,box-shadow .25s}.float-action:hover{transform:translateY(-4px) scale(1.04);box-shadow:0 22px 55px rgba(0,0,0,.42)}
.final-quote{padding:100px 5vw 115px;border-top:1px solid var(--line);display:grid;grid-template-columns:.5fr 2fr 1fr;gap:40px;align-items:end;background:#08090c}.quote-index{font:500 8px "DM Mono";letter-spacing:.15em;color:#545b65}.quote-main{font:600 clamp(52px,7vw,108px)/.86 Manrope;letter-spacing:-.075em;color:#e9ebee}.quote-main span{color:#6baeff}.quote-side{font:400 11px/1.7 Manrope;color:#777e88;max-width:250px}
footer{border-top:0}
@media(max-width:1000px){.hero-side-note{display:none}.final-quote{grid-template-columns:1fr 2fr}.quote-side{grid-column:2}}
@media(max-width:700px){.eyebrow{margin-bottom:24px}.media-kicker{gap:12px;flex-wrap:wrap}.media-kicker i{display:none}.final-quote{grid-template-columns:1fr;padding-top:80px}.quote-side{grid-column:auto}.quote-main{font-size:16vw}.partner-row span{min-width:120px}}

/* =========================================================
   CINEMATIC SHOWREEL UI
   ========================================================= */
.screen{background:#050608!important}
.showreel-video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;background:#050608;display:block}
.screen-vignette{position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(180deg,rgba(0,0,0,.58) 0%,transparent 28%,transparent 55%,rgba(0,0,0,.72) 100%),radial-gradient(circle at center,transparent 38%,rgba(0,0,0,.34) 100%)}
.screen-bar{z-index:3}
.screen-bar b{color:#b8d8ff;font-weight:500}
.screen-content{z-index:2}
.play{position:relative;z-index:4;color:#fff;cursor:pointer;transition:transform .25s,background .25s,border-color .25s}
.play:hover{transform:scale(1.08);background:#ffffff18;border-color:#ffffff88}
.subtitle{z-index:3;bottom:74px}
.subtitle span{font-size:clamp(16px,2vw,24px);font-weight:600;letter-spacing:-.025em}
.subtitle strong{margin-top:8px;font:500 8px "DM Mono";letter-spacing:.16em;text-transform:uppercase;color:#c6cbd2}
.caption-in{animation:captionIn .55s cubic-bezier(.2,.8,.2,1) both}
@keyframes captionIn{from{opacity:0;transform:translate(-50%,8px)}to{opacity:1;transform:translate(-50%,0)}}
.timeline{z-index:4;cursor:pointer}
.timeline i{position:relative;height:2px;transition:background .3s,transform .3s}
.timeline i:after{content:"";position:absolute;left:0;top:-5px;bottom:-5px;right:0}
.timeline i.active{background:#70b5ff;box-shadow:0 0 10px #5ca7ff66}
.timeline i:hover{transform:scaleY(2);background:#b9dcff}
@media(max-width:700px){
 .screen{height:min(72vw,420px)}
 .screen-bar{padding:14px 15px;font-size:7px}
 .subtitle{bottom:60px}
 .subtitle strong{font-size:7px;letter-spacing:.1em}
 .play{width:58px;height:58px}
}

/* =========================================================
   V6 — CINEMATIC VIDEO BACKGROUND CARD
   ========================================================= */
.media-bg-card{
  position:relative;
  min-height:680px;
  margin:0 5vw;
  overflow:hidden;
  border:1px solid rgba(255,255,255,.12);
  background:#08090b;
  box-shadow:0 50px 130px rgba(0,0,0,.42);
  isolation:isolate;
}
.media-bg-video{
  position:absolute;
  inset:0;
  z-index:-3;
  overflow:hidden;
  background:#08090b;
}
.media-bg-video video{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center;
  opacity:.78;
  filter:saturate(.82) contrast(1.06) brightness(.72);
  transform:scale(1.015);
}
.media-bg-overlay{
  position:absolute;
  inset:0;
  background:
    linear-gradient(90deg,rgba(5,7,10,.96) 0%,rgba(5,7,10,.79) 35%,rgba(5,7,10,.34) 66%,rgba(5,7,10,.58) 100%),
    linear-gradient(0deg,rgba(4,5,7,.8) 0%,transparent 45%,rgba(4,5,7,.32) 100%);
}
.media-bg-vignette{
  position:absolute;
  inset:0;
  box-shadow:inset 0 0 180px rgba(0,0,0,.7);
}
.media-card-content{
  position:relative;
  z-index:2;
  min-height:680px;
  padding:42px 48px 44px;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
}
.media-card-top{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:30px;
}
.media-bg-card .media-kicker{
  margin:0;
  display:flex;
  gap:18px;
  align-items:center;
  flex-wrap:wrap;
  font:500 8px "DM Mono";
  letter-spacing:.14em;
  color:rgba(255,255,255,.58);
}
.media-bg-card .media-kicker b{color:#fff;font-weight:500}
.media-bg-card .media-kicker i{font-style:normal;color:rgba(255,255,255,.38)}
.media-card-index{
  font:500 9px "DM Mono";
  letter-spacing:.14em;
  color:rgba(255,255,255,.5);
  white-space:nowrap;
}
.media-card-index span{color:#fff}
.media-card-main{
  display:flex;
  align-items:flex-end;
  justify-content:space-between;
  gap:60px;
}
.media-card-copy{max-width:720px}
.media-label{
  display:inline-flex;
  align-items:center;
  gap:10px;
  margin-bottom:24px;
  font:500 8px "DM Mono";
  letter-spacing:.18em;
  color:#9acbff;
}
.media-label:before{
  content:"";
  width:28px;
  height:1px;
  background:#70b3ff;
  box-shadow:0 0 15px rgba(112,179,255,.6);
}
.media-card-copy h2{
  margin:0;
  font:600 clamp(58px,7.5vw,112px)/.84 Manrope,sans-serif;
  letter-spacing:-.075em;
  color:#fff;
}
.media-card-copy h2 span{
  color:#79b8ff;
}
.media-card-copy p{
  max-width:500px;
  margin:30px 0 0;
  font:400 13px/1.8 Manrope,sans-serif;
  color:rgba(255,255,255,.62);
}
.media-card-actions{
  display:flex;
  align-items:center;
  gap:28px;
  margin-top:38px;
}
.media-play{
  border:1px solid rgba(255,255,255,.22);
  background:rgba(7,9,12,.36);
  color:#fff;
  backdrop-filter:blur(12px);
  padding:13px 17px 13px 13px;
  display:flex;
  align-items:center;
  gap:12px;
  font:500 8px "DM Mono";
  letter-spacing:.13em;
  cursor:pointer;
  transition:.3s;
}
.media-play:hover{
  background:rgba(255,255,255,.09);
  border-color:rgba(255,255,255,.4);
  transform:translateY(-2px);
}
.media-play-icon{
  width:32px;height:32px;
  display:grid;place-items:center;
  border:1px solid rgba(255,255,255,.22);
  font-size:9px;
}
.media-progress{
  width:150px;
  height:1px;
  background:rgba(255,255,255,.18);
  overflow:hidden;
}
.media-progress div{
  width:0;
  height:100%;
  background:#82bdff;
  box-shadow:0 0 12px rgba(130,189,255,.7);
  transition:width .1s linear;
}
.media-card-meta{
  width:185px;
  flex:none;
  border-left:1px solid rgba(255,255,255,.15);
  padding-left:22px;
  display:grid;
  gap:15px;
  font:500 8px/1.3 "DM Mono";
  letter-spacing:.08em;
  color:rgba(255,255,255,.4);
}
.media-card-meta div{transition:.25s}
.media-card-meta div:hover{color:#fff}
.media-card-meta span{color:#8dbfff;margin-right:8px}
@media(max-width:800px){
  .media-bg-card{margin:0 4vw;min-height:610px}
  .media-card-content{min-height:610px;padding:28px 24px 28px}
  .media-card-main{display:block}
  .media-card-meta{display:none}
  .media-card-copy h2{font-size:clamp(50px,14vw,82px)}
  .media-card-actions{margin-top:28px}
  .media-progress{width:90px}
  .media-bg-card .media-kicker i{display:none}
}

/* V7 — contrast + clean underline correction */
a, a:hover, a:focus, a:visited {
  text-decoration: none !important;
}
.media-bg-card a,
.media-bg-card a:hover {
  text-decoration: none !important;
}
.language-big span:after {
  display:none !important;
}
.hero a:after,
.section-head a:after,
.service a:after,
.about a:after,
.contact a:after,
.media a:after {
  display:none !important;
}

/* Stronger readability over unpredictable video frames */
.media-bg-video video {
  opacity:.62 !important;
  filter:saturate(.72) contrast(1.08) brightness(.48) !important;
}
.media-bg-overlay {
  background:
    linear-gradient(90deg,
      rgba(3,5,8,.985) 0%,
      rgba(3,5,8,.91) 32%,
      rgba(3,5,8,.67) 62%,
      rgba(3,5,8,.78) 100%),
    linear-gradient(0deg,
      rgba(3,5,8,.93) 0%,
      rgba(3,5,8,.18) 50%,
      rgba(3,5,8,.58) 100%) !important;
}
.media-bg-vignette {
  box-shadow:inset 0 0 190px rgba(0,0,0,.82) !important;
}

/* Keep the premium blue only where it has a semantic purpose */
.media-label {
  color:#b9d8f8 !important;
}
.media-label:before {
  background:rgba(170,210,248,.75) !important;
  box-shadow:none !important;
}
.media-card-copy h2 span {
  color:#b8d8f6 !important;
}
.media-card-index span {
  color:#dcecff !important;
}
.media-progress div {
  background:#b8d8f6 !important;
  box-shadow:none !important;
}

/* Cleaner global typography */
h1,h2,h3,h4,p,span,a,button { text-decoration-thickness:0 !important; }


/* =========================================================
   V8 — FINAL CLEAN HERO / NO DECORATIVE UNDERLINES
   ========================================================= */
.hero-copy{opacity:1!important;visibility:visible!important;filter:none!important}
.hero h1{
  color:#f7f7f4!important;
  text-shadow:0 2px 22px rgba(0,0,0,.28);
}
.hero h1 span{
  color:#9bcaff!important;
  background:none!important;
  -webkit-text-fill-color:#9bcaff!important;
  -webkit-background-clip:initial!important;
  background-clip:initial!important;
  position:static!important;
}
.hero h1 span:after{content:none!important;display:none!important}
.hero h1:after,.hero-copy:after{content:none!important;display:none!important}
.eyebrow{display:none!important}
.hero-lead{color:#c3c6cc!important;text-shadow:0 1px 10px rgba(0,0,0,.3)}
.hero-trust{color:#8f959e!important}
.hero-trust b{background:#8f959e!important;box-shadow:none!important}
.text-link span{color:#d7dde5!important}
/* Remove decorative blue hover underlines and small pseudo rules. */
.language-big span:after,
.hero h1 span:after,
.eyebrow span,
.stats>div:before,
.media-label:before,
.hero a:after,
.section-head a:after,
.service a:after,
.about a:after,
.media a:after{content:none!important;display:none!important;width:0!important}
.language-big span:hover:after{width:0!important}
.under{border-bottom:0!important;padding-bottom:0!important}
/* Keep the interface sophisticated: borders remain only where they structure UI. */
.service:before{display:none!important}
.world-panel:after{display:none!important}
/* Slightly brighter hero environment so the main message never disappears. */
.hero{background:radial-gradient(circle at 76% 43%,#1a2942 0,#0d1119 32%,#090b0f 66%,#08090c 100%)!important}
.hero-grid{opacity:.11!important}

/* =========================================================
   V9 — READABILITY RESTORE
   Fix: dark manifesto text disappearing on dark background.
   Fix: video/showreel becoming too dark.
   Fix: all decorative blue underline/pseudo-line artifacts.
   ========================================================= */

/* The manifesto was switched to a dark luxury background but its
   original dark typography remained. Restore proper contrast. */
.manifesto,
.manifesto .section-tag,
.manifesto .section-tag *,
.manifesto .manifesto-text,
.manifesto .manifesto-text *,
.manifesto h2,
.manifesto h2 *,
.manifesto .muted,
.manifesto .kicker,
.manifesto .stats,
.manifesto .stats *,
.manifesto .stats small {
  color:#f2f3f1 !important;
}
.manifesto .section-tag,
.manifesto .muted,
.manifesto .kicker,
.manifesto .stats small {
  color:#9ca2aa !important;
}
.manifesto h2 i {
  color:#8e959e !important;
}
.manifesto .stats div {
  border-top-color:rgba(255,255,255,.12) !important;
}
.manifesto .stats strong {
  color:#f7f7f4 !important;
}
.manifesto .stats strong span {
  color:#a9cfff !important;
}

/* Make the actual hero impossible to lose against the background. */
.hero-copy,
.hero h1,
.hero-lead,
.hero-actions,
.hero-trust,
.hero-side-note {
  opacity:1 !important;
  visibility:visible !important;
}
.hero h1 {
  color:#ffffff !important;
  text-shadow:0 3px 28px rgba(0,0,0,.42) !important;
}
.hero h1 span {
  color:#a9d0ff !important;
  -webkit-text-fill-color:#a9d0ff !important;
}
.hero-lead {
  color:#d4d7dc !important;
}
.hero-side-note strong {
  color:#f0f2f5 !important;
}

/* Restore video visibility. The footage should look like footage,
   not like a black texture. */
.media-bg-video video,
.showreel-video {
  opacity:.94 !important;
  filter:saturate(.9) contrast(1.03) brightness(.9) !important;
}
.media-bg-overlay {
  background:
    linear-gradient(90deg,
      rgba(4,6,9,.82) 0%,
      rgba(4,6,9,.54) 35%,
      rgba(4,6,9,.18) 66%,
      rgba(4,6,9,.38) 100%),
    linear-gradient(0deg,
      rgba(4,6,9,.62) 0%,
      rgba(4,6,9,.06) 48%,
      rgba(4,6,9,.24) 100%) !important;
}
.media-bg-vignette {
  box-shadow:inset 0 0 130px rgba(0,0,0,.38) !important;
}

/* Kill decorative line artifacts everywhere except structural borders. */
.hero *,
.language-big span:after,
.language-big span:hover:after,
.hero h1:after,
.hero h1 span:after,
.hero-copy:after,
.hero-copy:before,
.eyebrow:before,
.eyebrow:after,
.eyebrow span,
.stats>div:before,
.service:before,
.world-panel:after,
.media-label:before,
.media-card-copy:before,
.media-card-copy:after {
  box-shadow:none !important;
}
.language-big span:after,
.hero h1:after,
.hero h1 span:after,
.hero-copy:after,
.hero-copy:before,
.eyebrow:before,
.eyebrow:after,
.eyebrow span,
.stats>div:before,
.service:before,
.world-panel:after,
.media-label:before,
.media-card-copy:before,
.media-card-copy:after {
  content:none !important;
  display:none !important;
  width:0 !important;
  height:0 !important;
  border:0 !important;
  background:none !important;
}

/* No accidental text underlines anywhere. */
a, a:hover, a:focus, a:visited,
button, button:hover,
.language-big span,
.hero h1 span,
.under {
  text-decoration:none !important;
}
.under {
  border:0 !important;
  box-shadow:none !important;
}

/* Keep the dark luxury palette, but never at the expense of text. */
.manifesto {
  background:
    radial-gradient(circle at 72% 35%, rgba(70,105,145,.08), transparent 34%),
    linear-gradient(180deg,#0a0c10,#090a0e) !important;
}


/* =========================================================
   FINAL SERVICE GRID CONTRAST FIX
   Never hide service cards/content during reveal animation.
   ========================================================= */
.service,
.service.featured,
.service.dark {
  opacity: 1 !important;
  visibility: visible !important;
  filter: none !important;
  color: #f5f7fa !important;
}

/* One consistent premium visual system — no accidental light/dark
   text collision from the old featured card. */
.service,
.service.featured,
.service.dark {
  background:
    radial-gradient(circle at 88% 15%, rgba(92,167,255,.09), transparent 34%),
    linear-gradient(145deg, #12161d 0%, #0b0e13 100%) !important;
  border: 0 !important;
}

.service.featured {
  background:
    radial-gradient(circle at 82% 18%, rgba(105,177,255,.16), transparent 38%),
    linear-gradient(145deg, #172130 0%, #0d1117 100%) !important;
}

.service:hover,
.service.featured:hover,
.service.dark:hover {
  background:
    radial-gradient(circle at 82% 18%, rgba(105,177,255,.20), transparent 40%),
    linear-gradient(145deg, #1a2432 0%, #0d1117 100%) !important;
}

.service .num {
  color: #7f8b99 !important;
  opacity: 1 !important;
}
.service .icon {
  color: #eaf3ff !important;
  opacity: 1 !important;
}
.service .arrow {
  color: #dcecff !important;
  opacity: 1 !important;
}
.service h3 {
  color: #ffffff !important;
  opacity: 1 !important;
  text-shadow: 0 2px 18px rgba(0,0,0,.28);
}
.service p {
  color: #aeb8c5 !important;
  opacity: 1 !important;
}
.service .chips b {
  color: #d8e3ef !important;
  border-color: rgba(255,255,255,.14) !important;
  background: rgba(255,255,255,.025) !important;
  opacity: 1 !important;
}
.service-grid {
  background: rgba(255,255,255,.09) !important;
  border-color: rgba(255,255,255,.10) !important;
}

/* PHOTO SERVICE CARDS — final contrast-safe treatment */
.service-grid-photo{grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:#252a32;border:1px solid #252a32}
.service-photo{min-height:430px!important;padding:32px!important;overflow:hidden;background:#0b1017!important;color:#fff!important;position:relative;isolation:isolate;display:flex;flex-direction:column;justify-content:flex-start}
.service-photo::before{content:"";position:absolute;inset:0;background-image:var(--service-img);background-size:cover;background-position:center;z-index:0;transform:scale(1.015);transition:transform .7s cubic-bezier(.2,.7,.2,1),filter .7s;filter:saturate(.8) contrast(1.02)}
.service-photo::after{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(5,9,14,.46) 0%,rgba(5,9,14,.38) 32%,rgba(5,9,14,.78) 72%,rgba(5,9,14,.94) 100%)}
.service-photo:hover::before{transform:scale(1.07);filter:saturate(1) contrast(1.05)}
.service-photo .num{color:#b8c8da!important;position:relative;z-index:2}
.service-photo .service-top{margin:42px 0 0!important;position:relative;z-index:2}
.service-photo .icon{color:#fff!important;text-shadow:0 2px 18px #000;font-size:28px}
.service-photo .arrow{color:#fff!important;text-shadow:0 2px 12px #000}
.service-photo .service-content{margin-top:auto;position:relative;z-index:2;max-width:610px}
.service-photo h3{color:#fff!important;text-shadow:0 2px 18px #000;margin-bottom:14px}
.service-photo p{color:#d2d9e2!important;text-shadow:0 1px 10px #000;max-width:570px}
.service-photo .chips{margin-top:20px}
.service-photo .chips b{color:#f4f7fb!important;border-color:#ffffff38!important;background:#05080c55;backdrop-filter:blur(5px)}
.service-explore{position:absolute;right:32px;bottom:30px;z-index:3;color:#fff;text-decoration:none!important;font:500 9px "DM Mono";letter-spacing:.08em;opacity:.8;transition:opacity .25s,transform .25s}
.service-explore span{font-size:16px;margin-left:7px;vertical-align:-1px}
.service-photo:hover .service-explore{opacity:1;transform:translateX(3px)}
.service-photo a,.service-photo a:visited,.service-photo a:hover,.service-photo a:active{text-decoration:none!important}
@media(max-width:900px){.service-grid-photo{grid-template-columns:1fr}.service-photo{min-height:390px!important}}

.service-photo > *{position:relative;z-index:2}
.service-photo:hover::before{transform:scale(1.06);filter:saturate(1) contrast(1.05)}

/* FINAL SAFE OVERRIDES — preserve the photo treatment and prevent light-theme collisions */
html, body { background:#08090c !important; color:#f6f7f8 !important; }
.manifesto, .capabilities, .media, .languages, .about, .partners, .contact { color:#f6f7f8 !important; }
.manifesto { background:radial-gradient(circle at 72% 35%, rgba(70,105,145,.08), transparent 34%), linear-gradient(180deg,#0a0c10,#090a0e) !important; }
.manifesto .section-tag, .manifesto-text .kicker { color:#8d98a6 !important; }
.manifesto h2 { color:#f5f7fa !important; }
.manifesto h2 i { color:#9aa3ae !important; }
.manifesto .muted { color:#aeb7c2 !important; }
.stats div { border-top-color:rgba(255,255,255,.10) !important; }
.stats strong { color:#fff !important; }
.stats small { color:#8d98a6 !important; }

/* Service photos must remain actual image backgrounds. */
.service-grid-photo .service-photo { background:#0b1017 !important; }

.service-grid-photo .service-photo::after {
  content:"" !important;
  display:block !important;
  position:absolute !important;
  inset:0 !important;
  z-index:1 !important;
  background:linear-gradient(180deg,rgba(5,9,14,.28) 0%,rgba(5,9,14,.20) 28%,rgba(5,9,14,.70) 70%,rgba(5,9,14,.94) 100%) !important;
}
.service-grid-photo .service-photo > * { position:relative !important; z-index:2 !important; }

/* Remove decorative blue text underlines; keep normal links clean. */
a, a:hover, a:focus, a:visited { text-decoration:none !important; }
.language-big span::after, .language-big span:hover::after { display:none !important; content:none !important; }

/* Keep circular logo treatment. */
.brand img { border-radius:50% !important; }

/* =========================================================
   FINAL PHOTO VISIBILITY FIX
   Keep the existing layout/design — only restore the visuals.
   ========================================================= */

/* Never let the manifesto accidentally become a white panel. */
section.manifesto {
  background: radial-gradient(circle at 72% 35%, rgba(70,105,145,.10), transparent 34%),
              linear-gradient(180deg, #0a0c10 0%, #090b0f 100%) !important;
  color: #f5f7fa !important;
}
section.manifesto h2,
section.manifesto h2 i { color: #f5f7fa !important; }
section.manifesto h2 i { color: #aeb7c2 !important; }
section.manifesto .muted { color: #b6bec9 !important; }
section.manifesto .stats strong { color: #fff !important; }
section.manifesto .stats small { color: #8d98a6 !important; }

/* Service cards: use real files directly, not CSS custom-property URLs. */
.service-grid-photo .service-photo {
  position: relative !important;
  isolation: isolate !important;
  overflow: hidden !important;
  min-height: 430px !important;
  background-color: #0b1017 !important;
  color: #fff !important;
}

.service-grid-photo .service-photo::before {
  content: "" !important;
  position: absolute !important;
  inset: 0 !important;
  z-index: -2 !important;
  display: block !important;
  background-repeat: no-repeat !important;
  background-size: cover !important;
  background-position: center !important;
  opacity: 1 !important;
  filter: saturate(.95) contrast(1.03) brightness(1.08) !important;
  transform: scale(1.01) !important;
  transition: transform .7s cubic-bezier(.2,.7,.2,1), filter .7s ease !important;
}

.service-grid-photo .service-photo:nth-child(1)::before { background-image: url('./images/1.png') !important; }
.service-grid-photo .service-photo:nth-child(2)::before { background-image: url('./images/2.png') !important; }
.service-grid-photo .service-photo:nth-child(3)::before { background-image: url('./images/3.png') !important; }
.service-grid-photo .service-photo:nth-child(4)::before { background-image: url('./images/4.png') !important; }
.service-grid-photo .service-photo:nth-child(5)::before { background-image: url('./images/5.png') !important; }
.service-grid-photo .service-photo:nth-child(6)::before { background-image: url('./images/6.png') !important; }
.service-grid-photo .service-photo:nth-child(7)::before { background-image: url('./images/7.png') !important; }
.service-grid-photo .service-photo:nth-child(8)::before { background-image: url('./images/8.png') !important; }

/* Readable, but deliberately light overlay so the photography remains visible. */
.service-grid-photo .service-photo::after {
  content: "" !important;
  position: absolute !important;
  inset: 0 !important;
  z-index: -1 !important;
  display: block !important;
  background: linear-gradient(
    180deg,
    rgba(5,9,14,.10) 0%,
    rgba(5,9,14,.08) 34%,
    rgba(5,9,14,.42) 68%,
    rgba(5,9,14,.78) 100%
  ) !important;
  pointer-events: none !important;
}

.service-grid-photo .service-photo:hover::before {
  transform: scale(1.055) !important;
  filter: saturate(1.05) contrast(1.04) brightness(1.12) !important;
}

.service-grid-photo .service-photo > * {
  position: relative !important;
  z-index: 3 !important;
}
.service-grid-photo .service-photo h3 {
  color: #fff !important;
  text-shadow: 0 2px 18px rgba(0,0,0,.65) !important;
}
.service-grid-photo .service-photo p {
  color: rgba(245,248,252,.90) !important;
  text-shadow: 0 2px 12px rgba(0,0,0,.65) !important;
}
.service-grid-photo .service-photo .num,
.service-grid-photo .service-photo .icon,
.service-grid-photo .service-photo .arrow {
  color: #fff !important;
  text-shadow: 0 2px 14px rgba(0,0,0,.65) !important;
}
.service-grid-photo .service-photo .chips b {
  color: #fff !important;
  background: rgba(4,7,11,.34) !important;
  border-color: rgba(255,255,255,.30) !important;
  backdrop-filter: blur(7px) !important;
  -webkit-backdrop-filter: blur(7px) !important;
}

/* Keep links clean — no accidental browser/old-theme underlines. */
a,
a:hover,
a:focus,
a:active,
a:visited { text-decoration: none !important; }
.language-big span::after,
.language-big span:hover::after { display: none !important; }

/* Circular logo + circular favicon-style treatment. */
.brand img,
.preloader-mark img { border-radius: 50% !important; }
/* =========================================================
   FINAL PHOTO FIX — CSS ONLY
   HTML KO TOUCH NAHI KARNA
   ========================================================= */

/* All service cards: remove accidental white card */
.service-grid-photo .service,
.service-grid-photo .service-photo,
.service.featured,
.service.dark {
    position: relative !important;
    overflow: hidden !important;
    background: #0b1017 !important;
    color: #fff !important;
    opacity: 1 !important;
    visibility: visible !important;
    filter: none !important;
}

/* PHOTO LAYER */
.service-grid-photo .service-photo::before {
    content: "" !important;
    position: absolute !important;
    inset: 0 !important;
    display: block !important;

    background-size: cover !important;
    background-position: center !important;
    background-repeat: no-repeat !important;

    opacity: 1 !important;
    z-index: 0 !important;

    transform: scale(1.01) !important;
    filter: brightness(.95) saturate(1.05) contrast(1.02) !important;

    transition:
        transform .7s cubic-bezier(.2,.7,.2,1),
        filter .7s ease !important;
}

/* YOUR 8 PHOTOS */
.service-grid-photo .service-photo:nth-child(1)::before {
    background-image: url("./images/1.png") !important;
}

.service-grid-photo .service-photo:nth-child(2)::before {
    background-image: url("./images/2.png") !important;
}

.service-grid-photo .service-photo:nth-child(3)::before {
    background-image: url("./images/3.png") !important;
}

.service-grid-photo .service-photo:nth-child(4)::before {
    background-image: url("./images/4.png") !important;
}

.service-grid-photo .service-photo:nth-child(5)::before {
    background-image: url("./images/5.png") !important;
}

.service-grid-photo .service-photo:nth-child(6)::before {
    background-image: url("./images/6.png") !important;
}

.service-grid-photo .service-photo:nth-child(7)::before {
    background-image: url("./images/7.png") !important;
}

.service-grid-photo .service-photo:nth-child(8)::before {
    background-image: url("./images/8.png") !important;
}


/* LIGHT PREMIUM OVERLAY
   photo visible rahegi, text bhi readable rahega */
.service-grid-photo .service-photo::after {
    content: "" !important;
    position: absolute !important;
    inset: 0 !important;
    display: block !important;
    z-index: 1 !important;
    pointer-events: none !important;

    background:
        linear-gradient(
            180deg,
            rgba(5,8,12,.12) 0%,
            rgba(5,8,12,.05) 30%,
            rgba(5,8,12,.32) 62%,
            rgba(5,8,12,.88) 100%
        ) !important;
}


/* KEEP ALL CARD CONTENT ABOVE PHOTO */
.service-grid-photo .service-photo > * {
    position: relative !important;
    z-index: 2 !important;
}


/* TEXT */
.service-grid-photo .service-photo .num {
    color: #b8c7d8 !important;
}

.service-grid-photo .service-photo .icon {
    color: #fff !important;
    text-shadow: 0 2px 15px rgba(0,0,0,.8) !important;
}

.service-grid-photo .service-photo .arrow {
    color: #fff !important;
    text-shadow: 0 2px 15px rgba(0,0,0,.8) !important;
}

.service-grid-photo .service-photo h3 {
    color: #fff !important;
    text-shadow: 0 3px 20px rgba(0,0,0,.85) !important;
}

.service-grid-photo .service-photo p {
    color: #e0e7ef !important;
    text-shadow: 0 2px 12px rgba(0,0,0,.9) !important;
}

