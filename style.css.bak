}

/* MOBILE */
@media (max-width: 800px) {

    .process-grid,
    .workflow-grid,
    .steps-grid {
        grid-template-columns: 1fr !important;
        gap: 70px !important;
    }

    .process-grid::before,
    .workflow-grid::before,
    .steps-grid::before {
        top: 20px;
        bottom: 20px;
        left: 50%;
        right: auto;

        width: 1px;
        height: auto;

        background: linear-gradient(
            180deg,
            transparent,
            rgba(120,170,255,.5),
            transparent
        );
    }
