.services-hero * {
  opacity: 1 !important;
}

.services-hero .hero-side,
.services-hero .hero-side * {
  color: #17324d !important;
}

.services-hero .hero-side .stat-number {
  color: #2563eb !important;
}

.services-hero .hero-side .stat-label {
  color: #52708f !important;
}
.services-hero .hero-side {
  color: #17324d !important;
}

.services-hero .hero-side .stat-number,
.services-hero .hero-side strong {
  color: #2563eb !important;
  opacity: 1 !important;
}

.services-hero .hero-side .stat-label,
.services-hero .hero-side small {
  color: #52708f !important;
  opacity: 1 !important;
}
.services-hero .hero-side {
  color: #17324d !important;
}

.services-hero .hero-side .stat-number,
.services-hero .hero-side strong {
  color: #2563eb !important;
  opacity: 1 !important;
}

.services-hero .hero-side .stat-label,
.services-hero .hero-side small {
  color: #52708f !important;
  opacity: 1 !important;
}


/* =========================================================
   SERVICES PAGE — FINAL LIGHT/READABILITY OVERRIDES
   Keep this block last so older dark-theme rules cannot win.
   ========================================================= */
body:has(.services) {
  background: #ffffff !important;
  color: #13263a !important;
}

.services.hero,
.hero {
  background: linear-gradient(115deg, #ffffff 0%, #ffffff 52%, #eef6ff 100%) !important;
  color: #102338 !important;
  border-bottom: 1px solid #dce6ef !important;
}

.hero .kicker,
.hero .eyebrow {
  color: #365b7e !important;
  opacity: 1 !important;
}

.hero h1 {
  color: #0c2034 !important;
  text-shadow: none !important;
}

.hero h1 em {
  color: #1769e0 !important;
  -webkit-text-fill-color: #1769e0 !important;
  background: none !important;
}

.hero > div:first-child > p,
.hero .hero-lead {
  color: #526b83 !important;
  opacity: 1 !important;
  font-size: 17px !important;
  line-height: 1.8 !important;
}

.hero-meta {
  border-left: 1px solid #d7e2ec !important;
  color: #18344d !important;
  opacity: 1 !important;
}

.hero-meta .eyebrow {
  color: #55728c !important;
}

.hero-meta strong {
  color: #1769e0 !important;
  -webkit-text-fill-color: #1769e0 !important;
  opacity: 1 !important;
  text-shadow: none !important;
}

.hero-meta span {
  color: #5f7890 !important;
  opacity: 1 !important;
}

.services {
  background: #ffffff !important;
  color: #13263a !important;
  padding-top: 105px !important;
  padding-bottom: 105px !important;
}

.section-title h2 {
  color: #102338 !important;
}

.section-title h2 em {
  color: #1769e0 !important;
}

.section-title > p {
  color: #5a7085 !important;
  font-size: 16px !important;
  line-height: 1.75 !important;
  opacity: 1 !important;
}

.service {
  background: #ffffff !important;
  color: #13263a !important;
  border-color: #d9e3ec !important;
  min-height: 0 !important;
  box-shadow: none !important;
}

.service:hover {
  background: #f8fbff !important;
}

.service .number {
  color: #1769e0 !important;
  opacity: 1 !important;
}

.service h3 {
  color: #0e2135 !important;
  font-size: 32px !important;
}

.service h3 span {
  color: #1769e0 !important;
}

.service p {
  color: #526b83 !important;
  font-size: 16px !important;
  line-height: 1.8 !important;
  opacity: 1 !important;
}

.service .scope,
.service .scope strong,
.service .scope li {
  color: #4f687e !important;
  opacity: 1 !important;
}

.service .scope strong {
