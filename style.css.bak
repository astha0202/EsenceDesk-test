}

.scope li:before {
  color: #1769e0 !important;
}

.pill {
  color: #496278 !important;
  background: #f4f8fc !important;
  border-color: #d6e2ec !important;
  opacity: 1 !important;
}

.partners {
  background: #f7fafd !important;
  color: #13263a !important;
  border-top: 1px solid #dce6ef !important;
}

.partner-head h2,
.partner-head .kicker {
  color: #102338 !important;
}

.partner-head p {
  color: #5a7085 !important;
}

.partner {
  background: #ffffff !important;
