}

/* Remove accidental dark pseudo overlays from old hero versions. */
.hero:before,
.hero:after,
.hero-copy:before,
.hero-copy:after {
  background: none !important;
  box-shadow: none !important;
}

@media (max-width: 900px) {
  .hero-meta {
    border-left: 0 !important;
    border-top: 1px solid #d7e2ec !important;
  }
}
/* WORK WITH ESCENCEDESK - FIX HOVER */
.work-with-btn,
.work-with-btn a,
.work-with-escencedesk,
.work-with-escencedesk a {
    color: #0b1728 !important;
    background: transparent !important;
}

/* Hover */
.work-with-btn:hover,
.work-with-btn:hover a,
.work-with-escencedesk:hover,
.work-with-escencedesk:hover a {
    color: #0b1728 !important;
    background: transparent !important;
}

/* Arrow bhi visible rahe */
.work-with-btn:hover *,
.work-with-escencedesk:hover * {
    color: #0b1728 !important;
}

/* Agar pseudo-element se hover effect aa raha hai */
.work-with-btn::before,
.work-with-btn::after,
.work-with-escencedesk::before,
.work-with-escencedesk::after {
    background: #0b1728 !important;
}
/* Google Reviews Card */
.google-review-card {
    background: #fff !important;
    border: 1px solid #d9e1ec !important;
    border-radius: 20px !important;
    padding: 28px 26px !important;
    box-shadow: 0 12px 35px rgba(15, 35, 60, 0.06) !important;
    color: #10233b !important;
}

/* Rating number */
.google-review-card .rating,
.google-review-card .rating-score,
.google-review-card .rating-value {
    color: #071a2f !important;
    opacity: 1 !important;
    font-size: 38px !important;
    font-weight: 700 !important;
}

/* Stars */
.google-review-card .stars {
    color: #f5b400 !important;
    opacity: 1 !important;
    font-size: 17px !important;
    letter-spacing: 2px;
}

/* Google Reviews text */
.google-review-card .review-count,
.google-review-card .google-reviews {
    color: #64748b !important;
    opacity: 1 !important;
}

/* Google Maps link */
.google-review-card a {
    color: #1769e8 !important;
    font-weight: 600 !important;
    opacity: 1 !important;
}

.google-review-card a:hover {
    color: #0b56c7 !important;
}

/* Make sure nothing becomes white */
.google-review-card *,
.google-review-card span,
.google-review-card p {
    opacity: 1 !important;
}
/* ================================
   GOOGLE REVIEWS RATING CARD FIX
   ================================ */

.reviews-rating-large {
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    align-items: flex-start !important;

    background: #ffffff !important;
    color: #0b1b2f !important;

    border: 1px solid #d8e1ec !important;
    border-radius: 20px !important;

    padding: 28px 28px !important;
    min-width: 250px !important;
    min-height: 150px !important;

    text-decoration: none !important;
    box-shadow: 0 12px 35px rgba(20, 45, 75, 0.06) !important;

    opacity: 1 !important;
}

/* 5.0 */
.reviews-rating-large strong {
    display: block !important;
    color: #071a2f !important;
    font-size: 38px !important;
    line-height: 1 !important;
    font-weight: 700 !important;
    opacity: 1 !important;
}

/* Stars */
.reviews-rating-large .review-stars {
    display: block !important;
    margin-top: 8px !important;

    color: #f5b400 !important;
    font-size: 17px !important;
    line-height: 1 !important;
    letter-spacing: 2px !important;
    opacity: 1 !important;
}

/* Google Reviews · 9 reviews */
.reviews-rating-large small {
    display: block !important;
    margin-top: 7px !important;

    color: #64748b !important;
    font-size: 13px !important;
    line-height: 1.4 !important;
    opacity: 1 !important;
}

/* View on Google Maps */
.reviews-rating-large b {
    display: block !important;
    margin-top: 12px !important;

    color: #1769e8 !important;
    font-size: 13px !important;
    font-weight: 600 !important;
    opacity: 1 !important;
}

/* Hover — NOTHING becomes white */
.reviews-rating-large:hover {
    background: #ffffff !important;
    color: #0b1b2f !important;
    border-color: #c8d6e6 !important;
}

.reviews-rating-large:hover strong {
    color: #071a2f !important;
}

.reviews-rating-large:hover .review-stars {
    color: #f5b400 !important;
}

.reviews-rating-large:hover small {
    color: #64748b !important;
}

.reviews-rating-large:hover b {
    color: #1769e8 !important;
}
.review-avatar {
    width: 46px !important;
    height: 46px !important;
    min-width: 46px !important;
    border-radius: 50% !important;
    overflow: hidden !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    background: #e8eef7 !important;
    color: #1769e8 !important;
    font-weight: 700 !important;
}

.review-avatar img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block !important;
}
/* Fix Work With eSenceDesk hover */
.work-with-esencedesk,
.work-with-esencedesk a,
.work-with-esencedesk:hover,
.work-with-esencedesk a:hover,
.reviews-page-actions .text-link,
.reviews-page-actions .text-link:hover {
    color: #071426 !important;
    opacity: 1 !important;
    visibility: visible !important;
    text-shadow: none !important;
}

/* Arrow bhi visible rahe */
.work-with-esencedesk:hover a,
.reviews-page-actions .text-link:hover {
    color: #071426 !important;
}
/* Footer logo visibility fix */
footer img,
.footer img,
.footer-logo img,
.logo img {
    opacity: 1 !important;
    visibility: visible !important;
    display: block !important;
    filter: none !important;
}

/* Footer logo container */
footer .logo,
.footer .logo,
.footer-logo {
    opacity: 1 !important;
    visibility: visible !important;
}

/* Don't make logo white on hover */
footer a:hover img,
.footer a:hover img,
.footer-logo:hover img {
    opacity: 1 !important;
    visibility: visible !important;
    filter: none !important;
}
/* ===== BRING BACK THE GLOBAL GLOBE ===== */

.hero-art .world-map {
    position: relative !important;
    overflow: hidden !important;
    background:
        radial-gradient(
            circle at 50% 50%,
            rgba(40, 120, 220, 0.16) 0%,
            rgba(40, 120, 220, 0.08) 35%,
            rgba(255, 255, 255, 0) 70%
        ) !important;
}

/* Globe sphere */
.hero-art .world-map::before {
    content: "";
    position: absolute;
    width: 72%;
    aspect-ratio: 1;
    left: 14%;
    top: 5%;
    border-radius: 50%;

    background:
        radial-gradient(
            circle at 38% 32%,
            rgba(255,255,255,.95) 0%,
            rgba(220,239,255,.75) 35%,
            rgba(160,205,245,.35) 58%,
            rgba(70,140,220,.10) 75%,
            transparent 76%
        );

    border: 1px solid rgba(80,145,220,.22);

    box-shadow:
        inset -25px -20px 50px rgba(30,100,180,.12),
        inset 15px 10px 35px rgba(255,255,255,.9),
        0 0 45px rgba(50,130,220,.12);

    z-index: 1;
}

/* Longitude / latitude globe lines */
.hero-art .world-map::after {
    content: "";
    position: absolute;
    width: 72%;
    aspect-ratio: 1;
    left: 14%;
    top: 5%;
    border-radius: 50%;

    background:
        repeating-radial-gradient(
            ellipse at center,
            transparent 0 22px,
            rgba(55,125,210,.12) 23px 24px
        );

    opacity: .75;
    z-index: 2;
    pointer-events: none;
}

/* Network routes stay ABOVE globe */
.hero-art .map-lines,
.hero-art .routes,
.hero-art .city,
.hero-art .node,
.hero-art .center-orb {
    position: relative;
    z-index: 5 !important;
}

/* Routes */
.hero-art .routes {
    opacity: 1 !important;
}

.hero-art .routes path {
    stroke: rgba(40,115,210,.22) !important;
    stroke-width: 1.2 !important;
    fill: none !important;
}

/* Nodes */
.hero-art .node {
    background: #2776d8 !important;
    box-shadow:
        0 0 0 5px rgba(39,118,216,.10),
        0 0 15px rgba(39,118,216,.25);
}

/* City labels */
.hero-art .city {
    color: #2776d8 !important;
    z-index: 10 !important;
}

/* Center logo ABOVE globe */
.hero-art .center-orb {
    z-index: 20 !important;
}

/* Keep globe behind bottom labels */
.hero-art .world-bottom {
    position: relative;
    z-index: 30 !important;
}
/* ===== GLOBAL DESK / VISUAL FIX ===== */

.global-desk,
.global-desk *,
.desk-visual,
.desk-visual * {
    opacity: 1 !important;
    visibility: visible !important;
}

/* Main visual */
.global-desk img,
.desk-visual img {
    opacity: 1 !important;
    visibility: visible !important;
    filter: none !important;
}

/* Logo */
.global-desk .logo,
.global-desk .desk-logo,
.global-desk .center-logo,
.desk-visual .logo {
    opacity: 1 !important;
    visibility: visible !important;
    filter: none !important;
}

/* Text/cards */
.global-desk .desk-label,
.global-desk .desk-card,
.global-desk .desk-stat,
.global-desk .desk-tag,
.global-desk .desk-info,
.desk-visual .desk-label,
.desk-visual .desk-card {
    opacity: 1 !important;
    visibility: visible !important;
}

/* Don't fade anything on hover */
.global-desk:hover *,
.desk-visual:hover * {
    opacity: 1 !important;
}
/* ===== HERO ART VISIBILITY FIX ===== */

.hero-art {
  position: relative;
  z-index: 5;
}

/* Main world panel */
.hero-art .world-panel {
  position: relative;
  z-index: 10;
  color: #0b1b2d !important;
}

/* Top labels */
.hero-art .world-top,
.hero-art .world-top span {
  color: #183a60 !important;
  opacity: 1 !important;
}

/* GLOBAL DESK */
.hero-art .world-top span:first-child {
  color: #183a60 !important;
}

/* LIVE */
.hero-art .world-top .live {
  color: #1769e0 !important;
}

/* Map labels */
.hero-art .city {
  color: #1769e0 !important;
  opacity: 1 !important;
}

/* Bottom LANGUAGE / MEDIA / DIGITAL */
.hero-art .world-bottom {
  position: relative;
  z-index: 20;
  color: #173b63 !important;
  opacity: 1 !important;
}

.hero-art .world-bottom span {
  color: #173b63 !important;
  opacity: 1 !important;
}

.hero-art .world-bottom strong {
  color: #1769e0 !important;
  opacity: 1 !important;
}


/* ===== CENTER LOGO ===== */

.hero-art .center-orb {
  position: absolute;
  z-index: 30;
  opacity: 1 !important;
  visibility: visible !important;
}

.hero-art .center-orb img {
  display: block !important;
  width: 110px !important;
  height: 110px !important;
  object-fit: contain !important;
  opacity: 1 !important;
  visibility: visible !important;
  filter: none !important;
}


/* ===== FLOATING CARDS ===== */

.hero-art .floating-mini {
  position: absolute;
  z-index: 50;
  background: #ffffff !important;
  color: #0b1b2d !important;
  opacity: 1 !important;
  visibility: visible !important;
  border: 1px solid #d9e1eb !important;
  box-shadow: 0 12px 30px rgba(11,27,45,.08);
}

/* ALL / BEST / 15+ */
.hero-art .floating-mini b {
  display: block;
  color: #1769e0 !important;
  opacity: 1 !important;
  visibility: visible !important;
}

.hero-art .floating-mini b span {
  color: #1769e0 !important;
}

.hero-art .floating-mini > span {
  display: block;
  color: #50657d !important;
  opacity: 1 !important;
  visibility: visible !important;
}


/* ===== PREVENT GLOBAL FADE/WHITE OVERLAY ===== */

.hero-art .world-panel *,
.hero-art .floating-mini *,
.hero-art .center-orb *,
.hero-art .world-map {
  opacity: 1 !important;
  visibility: visible !important;
}


/* Keep decorative glow behind everything */
.hero-art .glow {
  z-index: 0 !important;
}

.hero-art .world-panel {
  z-index: 10 !important;
}

.hero-art .floating-mini {
  z-index: 50 !important;
}


/* ===== MOBILE ===== */

@media (max-width: 900px) {

  .hero-art .center-orb img {
    width: 80px !important;
    height: 80px !important;
  }

  .hero-art .floating-mini {
    transform: scale(.85);
  }

}
/* =========================================================
   PREMIUM GLOBAL DESK VISUAL
   ========================================================= */

.hero-art .world-map {
    position: relative !important;
    overflow: hidden !important;

    /* clean glassy dashboard */
    background:
        radial-gradient(
            circle at 50% 52%,
            rgba(42, 121, 220, 0.12) 0%,
            rgba(42, 121, 220, 0.055) 30%,
            rgba(255,255,255,0) 67%
        ),
        linear-gradient(
            135deg,
            rgba(255,255,255,.96),
            rgba(239,246,253,.88)
        ) !important;
}


/* ---------------- GLOBE ---------------- */

.hero-art .world-map::before {
    content: "";
    position: absolute;

    width: 58%;
    aspect-ratio: 1;

    left: 21%;
    top: 13%;

    border-radius: 50%;

    background:
        /* soft sphere lighting */
        radial-gradient(
            circle at 34% 28%,
            rgba(255,255,255,.98) 0%,
            rgba(224,241,255,.90) 32%,
            rgba(180,215,246,.48) 57%,
            rgba(76,142,213,.16) 76%,
            rgba(45,110,190,.04) 100%
        );

    border: 1px solid rgba(67,137,210,.20);

    box-shadow:
        inset -24px -18px 45px rgba(35,103,180,.13),
        inset 18px 14px 30px rgba(255,255,255,.9),
        0 12px 45px rgba(31,102,174,.12);

    z-index: 1;
}


/* ---------------- GLOBE GRID ---------------- */

.hero-art .world-map::after {
    content: "";

    position: absolute;

    width: 58%;
    aspect-ratio: 1;

    left: 21%;
    top: 13%;

    border-radius: 50%;

    background:

        /* latitude lines */
        repeating-radial-gradient(
            ellipse at 50% 50%,
            transparent 0,
            transparent 15px,
            rgba(43,119,202,.075) 16px,
            transparent 17px
        ),

        /* longitude feel */
        repeating-linear-gradient(
            90deg,
            transparent 0,
            transparent 42px,
            rgba(43,119,202,.045) 43px,
            transparent 44px
        );

    opacity: .75;

    z-index: 2;
    pointer-events: none;
}


/* ---------------- NETWORK ROUTES ---------------- */

.hero-art .map-lines,
.hero-art .routes {
    position: absolute !important;
    inset: 0 !important;
    z-index: 6 !important;
}

.hero-art .routes path {
    stroke: rgba(35,112,205,.20) !important;
    stroke-width: 1 !important;
    fill: none !important;
}


/* ---------------- NODES ---------------- */

.hero-art .node {
    z-index: 10 !important;

    width: 5px !important;
    height: 5px !important;

    background: #2776d8 !important;

    border-radius: 50%;

    box-shadow:
        0 0 0 4px rgba(39,118,216,.08),
        0 0 12px rgba(39,118,216,.25);
}


/* ---------------- CITY LABELS ---------------- */

.hero-art .city {
    z-index: 12 !important;

    color: #3979b8 !important;

    font-size: 7px !important;
    letter-spacing: .08em;

    opacity: .72 !important;
}


/* ---------------- CENTER LOGO ---------------- */

.hero-art .center-orb {
    z-index: 20 !important;

    width: 112px !important;
    height: 112px !important;

    border-radius: 50% !important;

    background: rgba(255,255,255,.94) !important;

    border: 1px solid rgba(50,125,205,.20) !important;

    box-shadow:
        0 8px 25px rgba(22,76,130,.14),
        0 0 0 7px rgba(255,255,255,.45),
        0 0 0 8px rgba(45,125,210,.08) !important;

    backdrop-filter: blur(8px);
}


/* logo itself */
.hero-art .center-orb img {
    width: 78px !important;
    height: 78px !important;
    object-fit: contain !important;
}


/* ---------------- SOFT EDGE / VIGNETTE ---------------- */

.hero-art .world-map {
    isolation: isolate;
}

.hero-art .world-map > * {
    position: relative;
}

.hero-art .world-map::marker {
    display: none;
}


/* subtle blue atmosphere behind globe */
.hero-art .world-map {
    box-shadow:
        inset 0 0 70px rgba(40,110,190,.055);
}


/* ---------------- BOTTOM INFO ---------------- */

.hero-art .world-bottom {
    position: relative !important;
    z-index: 30 !important;
}
/* ===== GLOBAL DESK VISUAL — CLEAN FIX ===== */

.global-desk-visual {
  position: relative;
  width: min(760px, 90vw);
  height: 520px;
  margin: 0 auto;
  overflow: visible;
  background: #061426;
  border-radius: 2px;
  box-shadow: 0 30px 70px rgba(5, 25, 50, .16);
}

/* remove the huge washed-out overlays */
.global-desk-visual::before,
.global-desk-visual::after {
  display: none !important;
}

/* main image / globe area */
.global-desk-visual img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
}

/* if you have an inner screen/panel */
.global-desk-visual .desk-screen {
  position: absolute;
  left: 6%;
  right: 6%;
  top: 7%;
  bottom: 7%;
  z-index: 2;
  background: rgba(244, 248, 252, .90);
  border: 1px solid rgba(255,255,255,.65);
  overflow: hidden;
}

/* DON'T let screen become a giant white block */
.global-desk-visual .desk-screen::before,
.global-desk-visual .desk-screen::after {
  display: none !important;
}

/* globe */
.global-desk-visual .globe {
  position: absolute;
  width: 420px;
  height: 420px;
  left: 50%;
  top: 52%;
  transform: translate(-50%, -50%);
  z-index: 3;
  opacity: 1;
}

/* logo stays clearly visible */
.global-desk-visual .desk-logo,
.global-desk-visual .logo {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 5;
  width: 115px;
  height: 115px;
  object-fit: contain;
  opacity: 1 !important;
}

/* top desk strip */
.global-desk-visual .desk-header {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 64px;
  z-index: 6;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28px;
  background: rgba(235,240,245,.86);
  border-bottom: 1px solid rgba(20,60,100,.08);
}

/* bottom strip */
.global-desk-visual .desk-footer {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 58px;
  z-index: 6;
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(235,240,245,.82);
  border-top: 1px solid rgba(20,60,100,.08);
}

/* floating cards */
.global-desk-visual .float-card {
  position: absolute;
  z-index: 10;
  background: #fff;
  border: 1px solid #d9e1ea;
  box-shadow: 0 18px 40px rgba(20,50,80,.10);
  padding: 20px 24px;
}

/* left */
.global-desk-visual .float-card.left {
  left: -38px;
  top: 105px;
}

/* right */
.global-desk-visual .float-card.right {
  right: -38px;
  top: 185px;
}

/* bottom */
.global-desk-visual .float-card.bottom {
  left: 0;
  bottom: -25px;
}

/* blue numbers */
.global-desk-visual .float-card strong {
  color: #1769e8;
  font-size: 21px;
}

/* responsive */
@media (max-width: 800px) {
  .global-desk-visual {
    width: 92vw;
    height: 430px;
  }

  .global-desk-visual .globe {
    width: 320px;
    height: 320px;
  }

  .global-desk-visual .float-card.left {
    left: -10px;
  }

  .global-desk-visual .float-card.right {
    right: -10px;
  }
}
/* ===== SERVICES VISUAL — FIX FULL CARD ===== */

.services-visual,
.services-card,
.services-visual-card {
    position: relative;
    overflow: visible !important;
}

/* Main white dashboard/card */
.services-visual .visual-panel,
.services-card .visual-panel,
.services-visual-card .visual-panel {
    position: relative;
    height: 100% !important;
    min-height: 420px;
    overflow: hidden !important;
}

/* Globe + logo ko poora card ke andar rakho */
.services-visual .globe,
.services-card .globe,
.services-visual-card .globe {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 520px;
    height: 520px;
    z-index: 2;
}

/* Logo */
.services-visual .logo,
.services-card .logo,
.services-visual-card .logo {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 125px;
    height: 125px;
    object-fit: contain;
    z-index: 5;
}

/* Agar globe image hai */
.services-visual img,
.services-card img,
.services-visual-card img {
    max-width: 100%;
}

/* Top strip */
.services-visual .visual-top,
.services-card .visual-top {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
}

/* Bottom strip */
.services-visual .visual-bottom,
.services-card .visual-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 10;
}

/* Floating boxes */
.services-visual .visual-badge,
.services-card .visual-badge {
    z-index: 30;
}

/* Prevent random sections from covering the card */
.services-visual > *,
.services-card > * {
    box-sizing: border-box;
}
.services-visual {
    position: relative;
    width: 100%;
    min-height: 520px;
    overflow: visible;
}

.visual-card {
    position: relative;
    width: 100%;
    height: 460px;
    overflow: hidden;
}

.visual-card .globe,
.visual-card .globe-image {
    position: absolute;
    width: 520px;
    height: 520px;
    max-width: none;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
}

.visual-card .logo,
.visual-card .center-logo {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 5;
}

/* =========================================================
   FINAL GLOBAL DESK VISUAL — FULL, CLEAN, BALANCED
   ========================================================= */

.hero-art{
  position:relative !important;
  height:620px !important;
  min-height:620px !important;
  perspective:1400px !important;
  overflow:visible !important;
  isolation:isolate !important;
}

.hero-art .glow{
  z-index:0 !important;
  width:620px !important;
  height:620px !important;
  opacity:.75 !important;
}

.hero-art .world-panel{
  position:absolute !important;
  z-index:10 !important;
  left:3% !important;
  right:3% !important;
  top:6% !important;
  bottom:8% !important;
  inset:auto 3% 8% 3% !important;
  height:auto !important;
  min-height:0 !important;
  overflow:hidden !important;
  border:1px solid #d5e1ec !important;
  border-radius:2px !important;
  background:linear-gradient(145deg,#f9fcff 0%,#edf4fa 100%) !important;
  box-shadow:0 35px 90px rgba(15,55,90,.14), inset 0 1px rgba(255,255,255,.95) !important;
  transform:rotateY(-3deg) rotateX(1deg) !important;
  transform-origin:center center !important;
  backdrop-filter:none !important;
}

.hero-art .world-panel:before{
  opacity:.45 !important;
  z-index:1 !important;
}

.hero-art .world-panel:after{
  pointer-events:none !important;
  z-index:40 !important;
  opacity:.18 !important;
}

/* Header/footer remain compact and never cover the globe */
.hero-art .world-top,
.hero-art .world-bottom{
  position:absolute !important;
  left:0 !important;
  right:0 !important;
  height:48px !important;
  z-index:50 !important;
  box-sizing:border-box !important;
  background:rgba(244,248,252,.88) !important;
  color:#173b63 !important;
  border-color:#d8e3ed !important;
}

.hero-art .world-top{
  top:0 !important;
  bottom:auto !important;
}

.hero-art .world-bottom{
  bottom:0 !important;
  top:auto !important;
  border-top:1px solid #d8e3ed !important;
  border-bottom:0 !important;
}

.hero-art .world-top span,
.hero-art .world-bottom span{
  color:#315676 !important;
  opacity:1 !important;
}

.hero-art .world-bottom strong{
  color:#1769e0 !important;
  opacity:1 !important;
}

/* Globe area fills ALL available space between strips */
.hero-art .world-map{
  position:absolute !important;
  left:0 !important;
  right:0 !important;
  top:48px !important;
  bottom:48px !important;
  width:auto !important;
  height:auto !important;
  min-height:0 !important;
  overflow:hidden !important;
  opacity:1 !important;
  isolation:isolate !important;
  background:
    radial-gradient(circle at 50% 52%,rgba(38,120,220,.13),transparent 46%),
    linear-gradient(145deg,#f9fcff,#edf5fb) !important;
  box-shadow:inset 0 0 90px rgba(40,110,190,.045) !important;
}

/* Make the globe genuinely centered in the available map area */
.hero-art .world-map:before,
.hero-art .world-map:after{
  width:min(62%,430px) !important;
  height:min(82%,430px) !important;
  aspect-ratio:1 / 1 !important;
  left:50% !important;
  top:50% !important;
  transform:translate(-50%,-50%) !important;
  border-radius:50% !important;
  box-sizing:border-box !important;
}

.hero-art .world-map:before{
  background:
    radial-gradient(circle at 34% 28%,rgba(255,255,255,.98) 0%,rgba(224,241,255,.92) 34%,rgba(181,216,247,.5) 58%,rgba(76,142,213,.16) 77%,rgba(45,110,190,.03) 100%) !important;
  border:1px solid rgba(67,137,210,.20) !important;
  box-shadow:
    inset -24px -18px 45px rgba(35,103,180,.13),
    inset 18px 14px 30px rgba(255,255,255,.9),
    0 12px 45px rgba(31,102,174,.12) !important;
  z-index:1 !important;
}

.hero-art .world-map:after{
  background:
    repeating-radial-gradient(ellipse at 50% 50%,transparent 0,transparent 15px,rgba(43,119,202,.075) 16px,transparent 17px),
    repeating-linear-gradient(90deg,transparent 0,transparent 42px,rgba(43,119,202,.045) 43px,transparent 44px) !important;
  opacity:.75 !important;
  z-index:2 !important;
  pointer-events:none !important;
}

/* Routes, cities and nodes sit on top of globe */
.hero-art .map-lines,
.hero-art .routes{
  position:absolute !important;
  inset:0 !important;
  width:100% !important;
  height:100% !important;
  z-index:8 !important;
}

.hero-art .map-lines{
  background-image:
    linear-gradient(rgba(55,125,210,.045) 1px,transparent 1px),
    linear-gradient(90deg,rgba(55,125,210,.045) 1px,transparent 1px) !important;
  background-size:42px 42px !important;
  opacity:.45 !important;
}

.hero-art .routes path{
  stroke:rgba(23,105,224,.24) !important;
  stroke-width:1.1 !important;
  fill:none !important;
}

.hero-art .city{
  z-index:12 !important;
  color:#3979b8 !important;
  opacity:.85 !important;
}

.hero-art .node{
  z-index:13 !important;
  width:6px !important;
  height:6px !important;
  background:#2776d8 !important;
  box-shadow:0 0 0 5px rgba(39,118,216,.09),0 0 14px rgba(39,118,216,.25) !important;
}

/* Center logo is always fully visible */
.hero-art .center-orb{
  position:absolute !important;
  left:50% !important;
  top:50% !important;
  transform:translate(-50%,-50%) !important;
  width:122px !important;
  height:122px !important;
  z-index:25 !important;
  display:grid !important;
  place-items:center !important;
  overflow:visible !important;
  background:#fff !important;
  border:1px solid #cbdceb !important;
  border-radius:50% !important;
  box-shadow:0 12px 32px rgba(21,94,159,.16),0 0 0 7px rgba(255,255,255,.65),0 0 0 8px rgba(45,125,210,.08) !important;
}

.hero-art .center-orb img{
  display:block !important;
  width:88px !important;
  height:88px !important;
  object-fit:contain !important;
  opacity:1 !important;
  visibility:visible !important;
  filter:none !important;
}

/* Floating cards — premium, lighter and correctly positioned */
.hero-art .floating-mini{
  position:absolute !important;
  z-index:80 !important;
  min-width:112px !important;
  padding:15px 16px !important;
  box-sizing:border-box !important;
  background:rgba(255,255,255,.98) !important;
  color:#0b1b2b !important;
  border:1px solid #d5e0eb !important;
  border-radius:2px !important;
  box-shadow:0 18px 40px rgba(11,42,70,.10) !important;
  backdrop-filter:none !important;
  opacity:1 !important;
  visibility:visible !important;
}

.hero-art .floating-mini b{
  display:block !important;
  color:#1769e0 !important;
  font:700 22px/1 Manrope,sans-serif !important;
  letter-spacing:-.04em !important;
}

.hero-art .floating-mini b span{
  color:#1769e0 !important;
  font-size:9px !important;
}

.hero-art .floating-mini > span{
  display:block !important;
  margin-top:5px !important;
  color:#526b83 !important;
  font:500 7px/1.35 "DM Mono",monospace !important;
  letter-spacing:.1em !important;
}

.hero-art .m1{left:-1% !important;top:17% !important}
.hero-art .m2{right:-1% !important;top:34% !important}
.hero-art .m3{left:4% !important;bottom:4% !important}

/* No invisible/white overlays inside the visual */
.hero-art .world-panel *,
.hero-art .floating-mini *{
  visibility:visible !important;
}

@media(max-width:1100px){
  .hero-art{height:560px !important;min-height:560px !important}
  .hero-art .world-panel{left:4% !important;right:4% !important}
  .hero-art .world-map:before,
  .hero-art .world-map:after{
    width:58% !important;
    height:auto !important;
    aspect-ratio:1 !important;
  }
}

@media(max-width:700px){
  .hero-art{
    height:470px !important;
    min-height:470px !important;
  }
