/* =========================
   PROCESS / WORK FLOW
========================= */

.process-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    margin-top: 70px;
    background: transparent !important;
    border: none !important;
}

/* connecting flow line */
.process-grid::before {
    content: "";
    position: absolute;
    top: 34px;
    left: 8%;
    right: 8%;
    height: 1px;
    background: rgba(255, 255, 255, 0.18);
    z-index: 0;
}

/* each step */
.process-card {
    position: relative;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 35px 20px;
    min-height: 180px;
    z-index: 1;
}

/* remove all hover boxes */
.process-card:hover {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    transform: none !important;
}

/* circle */
.process-card::before {
    content: "";
    display: flex;
    align-items: center;
    justify-content: center;

    width: 68px;
    height: 68px;
    margin: 0 auto 30px;

    border-radius: 50%;
    background: #080d13;
    border: 1px solid rgba(120, 180, 255, 0.5);

    box-shadow:
        0 0 0 8px rgba(80, 150, 255, 0.04),
        0 0 25px rgba(80, 150, 255, 0.08);

    position: relative;
    z-index: 2;
}

/* number */
.process-card .step-number {
    position: absolute;
    top: 24px;
    left: 50%;
    transform: translateX(-50%);

    font-size: 11px;
    letter-spacing: 2px;
    color: #7eb7ff;
    z-index: 3;
}

/* content */
.process-card h3,
.process-card h4 {
    text-align: center;
    margin: 0 0 12px;
    color: #f5f7fa;
}

.process-card p {
    max-width: 210px;
    margin: 0 auto;
    text-align: center;
    color: rgba(220, 230, 240, 0.58);
    line-height: 1.7;
}

/* no random small dots / decorations */
.process-card span:not(.step-number),
.process-card .dot,
.process-card .circle,
.process-card .step-dot {
    display: none !important;
}

/* remove borders from children */
.process-card *,
.process-card:hover * {
    border-color: transparent;
}

/* =========================
   MOBILE
========================= */

@media (max-width: 900px) {

    .process-grid {
        grid-template-columns: 1fr;
        gap: 45px;
    }

    .process-grid::before {
        top: 0;
        bottom: 0;
        left: 50%;
        right: auto;
        width: 1px;
        height: auto;
    }

    .process-card {
        min-height: auto;
        padding-bottom: 10px;
    }

    .process-card::before {
        margin-bottom: 20px;
    }
}
/* ================================
   PROCESS / WORKFLOW - FINAL
================================ */

.process,
.process-section,
.workflow,
.workflow-section {
    background: #f4f2ed !important;
    color: #111 !important;
}

/* Main row */
.process-grid,
.process-list,
.workflow-grid,
.workflow-list {
    display: flex !important;
    align-items: flex-start !important;
    justify-content: space-between !important;
    gap: 0 !important;
    position: relative !important;
    background: transparent !important;
    border: 0 !important;
}

/* Connecting flow line */
.process-grid::before,
.process-list::before,
.workflow-grid::before,
.workflow-list::before {
    content: "";
    position: absolute;
    top: 34px;
    left: 8%;
    right: 8%;
    height: 1px;
    background: rgba(15, 25, 40, 0.18);
    z-index: 0;
}

/* Each step */
.process-item,
.process-card,
.process-step,
.workflow-item,
.workflow-card,
.workflow-step {
    flex: 1 !important;
    position: relative !important;
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
    padding: 0 28px 30px !important;
    min-height: 220px !important;
    transition: none !important;
}

/* REMOVE ALL HOVER BOX EFFECT */
.process-item:hover,
.process-card:hover,
.process-step:hover,
.workflow-item:hover,
.workflow-card:hover,
.workflow-step:hover {
    background: transparent !important;
    box-shadow: none !important;
    transform: none !important;
}

/* Number */
.process-number,
.step-number,
.workflow-number {
    position: relative !important;
    z-index: 2 !important;

    width: 58px !important;
    height: 58px !important;
    border-radius: 50% !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    background: #f4f2ed !important;
    border: 1px solid rgba(15,25,40,.28) !important;

    color: #111 !important;
    font-size: 12px !important;
    font-weight: 500 !important;

    box-shadow: 0 0 0 8px #f4f2ed !important;

    transition: all .3s ease !important;
}



/* Titles */
.process-item h3,
.process-card h3,
.process-step h3,
.workflow-item h3,
.workflow-card h3,
.workflow-step h3 {
    margin-top: 28px !important;
    color: #111 !important;
    font-size: 20px !important;
    font-weight: 500 !important;
}

/* Description */
.process-item p,
.process-card p,
.process-step p,
.workflow-item p,
.workflow-card p,
.workflow-step p {
    margin-top: 14px !important;
    color: #5d6470 !important;
    opacity: 1 !important;
    visibility: visible !important;
    font-size: 14px !important;
    line-height: 1.7 !important;
    max-width: 230px !important;
}

/* Kill weird dark hover backgrounds */
.process-item::before,
.process-item::after,
.process-card::before,
.process-card::after,
.process-step::before,
.process-step::after,
.workflow-item::before,
.workflow-item::after,
.workflow-card::before,
.workflow-card::after,
.workflow-step::before,
.workflow-step::after {
    background: transparent !important;
    box-shadow: none !important;
}

/* Mobile */
@media (max-width: 768px) {

    .process-grid,
    .process-list,
    .workflow-grid,
    .workflow-list {
        display: block !important;
    }

    .process-grid::before,
    .process-list::before,
    .workflow-grid::before,
    .workflow-list::before {
        left: 29px;
        right: auto;
        top: 30px;
        bottom: 30px;
        width: 1px;
        height: auto;
    }

    .process-item,
    .process-card,
    .process-step,
    .workflow-item,
    .workflow-card,
    .workflow-step {
        min-height: 170px !important;
        padding-left: 90px !important;
    }
}
/* Clean hover - ONLY circle */
.process-item:hover .process-number,
.process-card:hover .process-number,
.process-step:hover .process-number,
.workflow-item:hover .workflow-number,
.workflow-card:hover .workflow-number,
.workflow-step:hover .workflow-number {
    background: #111827 !important;
    color: #fff !important;
    border-color: #111827 !important;
    transform: scale(1.08) !important;
}
/* =========================================
   PROCESS FLOW - CLEAN FINAL OVERRIDE
   ========================================= */

/* REMOVE CARD / HOVER BACKGROUNDS */
.process-item,
.process-card,
.process-step,
.workflow-item,
.workflow-card,
.workflow-step,
.process-grid > div,
.workflow-grid > div {
    background: transparent !important;
    background-image: none !important;
    border: 0 !important;
    box-shadow: none !important;
    transform: none !important;
}

/* HOVER = NO BOX */
.process-item:hover,
.process-card:hover,
.process-step:hover,
.workflow-item:hover,
.workflow-card:hover,
.workflow-step:hover,
.process-grid > div:hover,
.workflow-grid > div:hover {
    background: transparent !important;
    background-image: none !important;
    box-shadow: none !important;
    transform: none !important;
}

/* REMOVE DARK OVERLAY / GLOW */
.process-item::before,
.process-item::after,
.process-card::before,
.process-card::after,
.process-step::before,
.process-step::after,
.workflow-item::before,
.workflow-item::after,
.workflow-step::before,
.workflow-step::after {
    content: none !important;
    display: none !important;
}

/* =========================================
   DESCRIPTION - DARK + VISIBLE
   ========================================= */

.process-item p,
.process-card p,
.process-step p,
.workflow-item p,
.workflow-card p,
.workflow-step p,
.process-grid p,
.workflow-grid p {
    color: #4d5663 !important;
    opacity: 1 !important;
    visibility: visible !important;
    text-shadow: none !important;
}

/* =========================================
   TITLES
   ========================================= */

.process-item h3,
.process-card h3,
.process-step h3,
.workflow-item h3,
.workflow-card h3,
.workflow-step h3 {
    color: #111827 !important;
    opacity: 1 !important;
    text-shadow: none !important;
}

/* =========================================
   SMALL STEP NUMBERS
   ========================================= */

.process-item > span,
.process-card > span,
.process-step > span,
.workflow-item > span,
.workflow-card > span,
.workflow-step > span {
    color: #667080 !important;
}

/* =========================================
   CIRCLES - SIMPLE PREMIUM STYLE
   ========================================= */

.process-number,
.step-number,
.workflow-number,
.process-item .number,
.process-card .number,
.process-step .number,
.workflow-item .number,
.workflow-card .number,
.workflow-step .number {
    background: #f4f2ed !important;
    background-image: none !important;

    border: 1px solid #b9c0c8 !important;
    border-radius: 50% !important;

    color: #27313d !important;

    box-shadow:
        0 0 0 7px #f4f2ed !important;

    text-shadow: none !important;

    transition:
        background .25s ease,
        color .25s ease,
        border-color .25s ease,
        transform .25s ease !important;
}

/* CIRCLE HOVER ONLY */
.process-item:hover .process-number,
.process-card:hover .process-number,
.process-step:hover .process-number,
.workflow-item:hover .workflow-number,
.workflow-card:hover .workflow-number,
.workflow-step:hover .workflow-number {
    background: #111827 !important;
    color: #fff !important;
    border-color: #111827 !important;
    transform: scale(1.06) !important;

    box-shadow:
        0 0 0 7px #f4f2ed !important;
}

/* =========================================
   IMPORTANT:
   KILL ANY DARK HOVER PANEL
   ========================================= */

[class*="process"] [class*="active"],
[class*="process"] [class*="hover"],
[class*="workflow"] [class*="active"],
[class*="workflow"] [class*="hover"] {
    background: transparent !important;
    background-image: none !important;
}

/* =========================================
   CONNECTING LINE
   ========================================= */

.process-grid,
.process-list,
.workflow-grid,
.workflow-list {
    position: relative !important;
}

/* Don't let line become a box */
.process-grid::before,
.process-list::before,
.workflow-grid::before,
.workflow-list::before {
    background: #c5cad0 !important;
    box-shadow: none !important;
}

/* =========================================
   FORCE NORMAL OPACITY
   ========================================= */

.process-item *,
.process-card *,
.process-step *,
.workflow-item *,
.workflow-card *,
.workflow-step * {
    text-shadow: none !important;
}

/* Description stays visible even on hover */
.process-item:hover p,
.process-card:hover p,
.process-step:hover p,
.workflow-item:hover p,
.workflow-card:hover p,
.workflow-step:hover p {
    color: #4d5663 !important;
    opacity: 1 !important;
    visibility: visible !important;
}
/* ===== PROCESS FLOW - FINAL ===== */

/* remove all card backgrounds */
.process-item,
.process-card,
.process-step,
.workflow-item,
.workflow-card,
.workflow-step {
    background: transparent !important;
    background-image: none !important;
    border: none !important;
    box-shadow: none !important;
    overflow: visible !important;
}

/* no ugly hover box */
.process-item:hover,
.process-card:hover,
.process-step:hover,
.workflow-item:hover,
.workflow-card:hover,
.workflow-step:hover {
    background: transparent !important;
    box-shadow: none !important;
    transform: none !important;
}

/* flow container */
.process-grid,
.process-list,
.workflow-grid,
.workflow-list {
    display: flex !important;
    align-items: flex-start !important;
    position: relative !important;
    gap: 0 !important;
    overflow: visible !important;
}

/* horizontal line */
.process-grid::before,
.process-list::before,
.workflow-grid::before,
.workflow-list::before {
    content: "" !important;
    position: absolute !important;

    top: 177px !important;
    left: 7% !important;
    right: 7% !important;

    height: 1px !important;
    width: auto !important;

    background: #b9bec5 !important;
    opacity: 1 !important;

    z-index: 0 !important;
}

/* every step */
.process-item,
.process-card,
.process-step,
.workflow-item,
.workflow-card,
.workflow-step {
    position: relative !important;
    flex: 1 !important;
    min-width: 0 !important;
    text-align: center !important;
    padding: 0 25px 30px !important;
}

/* numbers above line */
.process-number,
.step-number,
.workflow-number,
.process-item .number,
.process-card .number,
.process-step .number,
.workflow-item .number,
.workflow-card .number,
.workflow-step .number {
    position: relative !important;
    z-index: 3 !important;

    width: 112px !important;
    height: 112px !important;

    margin: 50px auto 0 !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    border-radius: 50% !important;

    background: #f4f2ed !important;
    background-image: none !important;

    border: 1.5px solid #438cff !important;

    color: #111827 !important;

    font-size: 18px !important;
    font-weight: 500 !important;

    box-shadow: 0 0 0 7px #f4f2ed !important;

    text-shadow: none !important;

    transition: all .25s ease !important;
}

/* blue connector dot */
.process-number::after,
.step-number::after,
.workflow-number::after,
.process-item .number::after,
.process-card .number::after,
.process-step .number::after,
.workflow-item .number::after,
.workflow-card .number::after,
.workflow-step .number::after {
    content: "" !important;

    position: absolute !important;
    right: -5px !important;
    top: 50% !important;

    width: 9px !important;
    height: 9px !important;

    transform: translateY(-50%) !important;

    border-radius: 50% !important;

    background: #438cff !important;

    box-shadow: 0 0 0 4px #f4f2ed !important;
}

/* ===== ARROWS BETWEEN STEPS ===== */

.process-item:not(:last-child)::after,
.process-card:not(:last-child)::after,
.process-step:not(:last-child)::after,
.workflow-item:not(:last-child)::after,
.workflow-card:not(:last-child)::after,
.workflow-step:not(:last-child)::after {
    content: "›" !important;

    position: absolute !important;

    top: 159px !important;
    right: -7px !important;

    z-index: 5 !important;

    font-size: 34px !important;
    line-height: 1 !important;

    font-weight: 300 !important;

    color: #777f89 !important;

    background: #f4f2ed !important;

    padding: 0 8px !important;
}

/* titles */
.process-item h3,
.process-card h3,
.process-step h3,
.workflow-item h3,
.workflow-card h3,
.workflow-step h3 {
    margin-top: 32px !important;

    color: #111827 !important;

    font-size: 24px !important;
    font-weight: 600 !important;

    opacity: 1 !important;
}

/* descriptions */
.process-item p,
.process-card p,
.process-step p,
.workflow-item p,
.workflow-card p,
.workflow-step p {
    color: #5c6570 !important;

    opacity: 1 !important;
    visibility: visible !important;

    font-size: 15px !important;
    line-height: 1.7 !important;

    max-width: 220px !important;
    margin: 18px auto 0 !important;

    text-align: center !important;
}

/* hover only changes circle */
.process-item:hover .process-number,
.process-card:hover .process-number,
.process-step:hover .process-number,
.workflow-item:hover .workflow-number,
.workflow-card:hover .workflow-number,
.workflow-step:hover .workflow-number {
    background: #111827 !important;
    color: white !important;

    border-color: #111827 !important;

    transform: scale(1.05) !important;

    box-shadow: 0 0 0 7px #f4f2ed !important;
}

/* keep text visible on hover */
.process-item:hover p,
.process-card:hover p,
.process-step:hover p,
.workflow-item:hover p,
.workflow-card:hover p,
.workflow-step:hover p {
    color: #5c6570 !important;
    opacity: 1 !important;
}

/* mobile */
@media (max-width: 768px) {

    .process-grid,
    .process-list,
    .workflow-grid,
    .workflow-list {
        display: block !important;
    }

    .process-grid::before,
    .process-list::before,
    .workflow-grid::before,
    .workflow-list::before {
        top: 55px !important;
        bottom: 55px !important;
        left: 50% !important;
        right: auto !important;
        width: 1px !important;
        height: auto !important;
    }

    .process-item,
    .process-card,
    .process-step,
    .workflow-item,
    .workflow-card,
    .workflow-step {
        padding: 20px 20px 60px !important;
    }

    .process-item:not(:last-child)::after,
    .process-card:not(:last-child)::after,
    .process-step:not(:last-child)::after,
    .workflow-item:not(:last-child)::after,
    .workflow-card:not(:last-child)::after,
    .workflow-step:not(:last-child)::after {
        display: none !important;
    }
}
:root{
    --bg:#07090d;
    --panel:#0d1118;
    --line:rgba(255,255,255,.11);
    --text:#f4f6fa;
    --muted:#9aa5b5;
    --blue:#74b6ff;
    --green:#39df8b;
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    background:var(--bg);
    color:var(--text);
    font-family:Inter,Arial,sans-serif;
    overflow-x:hidden;
}

body:before{
    content:"";
    position:fixed;
    inset:0;
    pointer-events:none;
    z-index:-1;

    background-image:
        linear-gradient(
            rgba(255,255,255,.025) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(255,255,255,.025) 1px,
            transparent 1px
        );

    background-size:72px 72px;
    opacity:.18;
}

a{
    color:inherit;
    text-decoration:none;
}


/* =========================
   NAVBAR
========================= */

.nav{
    height:88px;

    padding:0 5.2%;

    display:flex;
    align-items:center;

    border-bottom:1px solid var(--line);

    position:sticky;
    top:0;

    background:rgba(7,9,13,.88);

    backdrop-filter:blur(18px);

    z-index:100;
}

.brand{
    display:flex;
    align-items:center;
    gap:12px;

    font-size:21px;
    font-weight:800;
}

.brand img{
    width:42px;
    height:42px;

    border-radius:50%;

    object-fit:cover;
}

.brand span span{
    font-weight:500;
}

.nav-links{
    margin-left:auto;

    display:flex;
    gap:34px;

    margin-right:38px;

    font-family:"DM Mono",monospace;
    font-size:11px;
    letter-spacing:.14em;

    text-transform:uppercase;

    color:#aeb6c2;
}

.nav-links a{
    transition:.25s;
}

.nav-links a:hover{
    color:#fff;
}

.status{
    display:flex;
    align-items:center;
    gap:8px;

    margin-right:28px;

    font-family:"DM Mono",monospace;
    font-size:9px;
    letter-spacing:.12em;

    color:#798392;
}

.status i{
    width:6px;
    height:6px;

    border-radius:50%;

    background:var(--green);

    box-shadow:0 0 12px var(--green);
}

.nav-cta{
    font-size:11px;
    font-weight:700;

    letter-spacing:.1em;

    text-transform:uppercase;
}


/* =========================
   HERO
========================= */

.hero{
    min-height:75vh;

    padding:120px 8% 100px;

    display:grid;

    grid-template-columns:1.15fr .85fr;

    gap:80px;

    align-items:end;

    border-bottom:1px solid var(--line);

    position:relative;

    overflow:hidden;
}

.hero:after{
    content:"";

    position:absolute;

    width:650px;
    height:650px;

    right:-220px;
    top:-220px;

    background:radial-gradient(
        circle,
        rgba(82,150,235,.15),
        transparent 68%
    );

    pointer-events:none;
}

.kicker{
    font-family:"DM Mono",monospace;
    font-size:10px;

    letter-spacing:.16em;

    text-transform:uppercase;

    color:#82a5c9;
}

.hero h1{
    margin-top:24px;

    font-family:Manrope,sans-serif;

    font-size:clamp(60px,8vw,125px);

    line-height:.9;

    letter-spacing:-.065em;

    font-weight:800;

    max-width:900px;

    position:relative;
    z-index:2;
}

.hero h1 em{
    font-weight:400;
    color:var(--blue);
}

.hero-intro{
    margin-top:35px;

    max-width:680px;

    font-size:17px;

    line-height:1.8;

    color:#aeb7c5;
}

.hero-side{
    border-left:1px solid var(--line);

    padding-left:38px;

    position:relative;
    z-index:2;
}

.eyebrow{
    font-family:"DM Mono",monospace;
    font-size:10px;

    letter-spacing:.15em;

    color:#7f8b9b;

    text-transform:uppercase;
}

.hero-side h3{
    margin-top:20px;

    font-family:Manrope;

    font-size:30px;

    line-height:1.2;
}

.hero-side p{
    margin-top:20px;

    color:#8e99aa;

    line-height:1.8;

    font-size:14px;
}


/* =========================
   ABOUT CONTENT
========================= */

.about{
    padding:120px 8%;
}

.about-grid{
    display:grid;

    grid-template-columns:1fr 1fr;

    gap:90px;

    align-items:center;
}

.about-image{
    position:relative;

    min-height:560px;

    overflow:hidden;

    border:1px solid var(--line);

    background:#0b1017;
}

.about-image img{
    width:100%;
    height:100%;

    min-height:560px;

    object-fit:cover;

    display:block;

    filter:
        brightness(.82)
        saturate(.85)
        contrast(1.05);
}

.about-image:after{
    content:"";

    position:absolute;
    inset:0;

    background:
        linear-gradient(
            180deg,
            rgba(5,8,13,.05),
            rgba(5,8,13,.72)
        );
}

.image-label{
    position:absolute;

    left:30px;
    bottom:28px;

    z-index:2;

    font-family:"DM Mono",monospace;

    font-size:10px;

    letter-spacing:.13em;

    text-transform:uppercase;

    color:#d7dee8;
}

.about-content .kicker{
    margin-bottom:18px;
}

.about-content h2{
    font-family:Manrope;

    font-size:clamp(42px,5vw,75px);

    line-height:.98;

    letter-spacing:-.055em;

    margin-bottom:35px;
}

.about-content h2 em{
    color:var(--blue);
    font-weight:400;
}

.about-content p{
    color:#a4adbb;

    line-height:1.9;

    font-size:16px;

    margin-bottom:24px;

    max-width:680px;
}


/* =========================
   VALUES
========================= */

.values{
    padding:0 8% 120px;
}

.values-head{
    margin-bottom:55px;
}

.values-head h2{
    margin-top:15px;

    font-family:Manrope;

    font-size:clamp(42px,5vw,72px);

    letter-spacing:-.05em;

    line-height:1;
}

.values-head h2 em{
    color:var(--blue);
    font-weight:400;
}

.values-grid{
    display:grid;

    grid-template-columns:repeat(3,1fr);

    border-top:1px solid var(--line);

    border-left:1px solid var(--line);
}

.value{
    min-height:260px;

    padding:35px;

    border-right:1px solid var(--line);
    border-bottom:1px solid var(--line);

    transition:.3s;
}

.value:hover{
    background:#0d141d;
    transform:translateY(-4px);
}

.value-number{
    font-family:"DM Mono",monospace;

    font-size:10px;

    color:#6e8ba9;

    letter-spacing:.1em;
}

.value h3{
    margin-top:65px;

    font-family:Manrope;

    font-size:26px;
}

.value p{
    margin-top:15px;

    color:#8e99a9;

    line-height:1.7;

    font-size:14px;
}


/* =========================
   CTA
========================= */

.final-cta{
    margin:0 8% 110px;

    padding:75px;

    border:1px solid var(--line);

    background:
        radial-gradient(
            circle at 80% 20%,
            rgba(75,145,255,.16),
            transparent 45%
        ),
        #0c1118;

    position:relative;

    overflow:hidden;
}

.final-cta h2{
    font-family:Manrope;

    font-size:clamp(40px,5vw,72px);

    line-height:1;

    letter-spacing:-.055em;
}

.final-cta h2 em{
    color:var(--blue);
    font-weight:400;
}

.final-cta p{
    margin-top:20px;

    max-width:620px;

    color:#929dac;

    line-height:1.8;
}

.final-cta a{
    display:inline-flex;

    margin-top:30px;

    padding:14px 20px;

    border:1px solid rgba(255,255,255,.2);

    font-family:"DM Mono",monospace;

    font-size:10px;

    letter-spacing:.1em;

    text-transform:uppercase;

    transition:.25s;
}

.final-cta a:hover{
    background:#fff;
    color:#07090d;
}


/* =========================
   FOOTER
========================= */

.footer{
    padding:50px 8%;

    border-top:1px solid var(--line);

    display:flex;

    justify-content:space-between;

    color:#748092;

    font-family:"DM Mono",monospace;

    font-size:10px;

    letter-spacing:.12em;

    text-transform:uppercase;
}


/* =========================
   FLOATING CONTACT
========================= */

.float{
    position:fixed;

    right:24px;
    bottom:24px;

    display:flex;

    flex-direction:column;

    gap:10px;

    z-index:200;
}

.float a{
    width:54px;
    height:54px;

    border-radius:50%;

    display:grid;

    place-items:center;

    font-size:19px;

    box-shadow:0 8px 28px rgba(0,0,0,.35);

    transition:.25s;
}

.float a:hover{
    transform:translateY(-4px) scale(1.04);
}

.wa{
    background:#20c878;
}

.phone{
    background:#f4f4f2;
    color:#111;
}

.mail{
    background:#55a8ff;
    color:#07101a;
}


/* =========================
   RESPONSIVE
========================= */

@media(max-width:900px){

    .nav-links,
    .status{
        display:none;
    }

    .hero{
        grid-template-columns:1fr;

        padding:85px 7% 70px;
    }

    .hero-side{
        border-left:0;

        border-top:1px solid var(--line);

        padding:30px 0 0;
    }

    .about{
        padding:90px 7%;
    }

    .about-grid{
        grid-template-columns:1fr;

        gap:55px;
    }

    .values{
        padding:0 7% 90px;
    }

    .values-grid{
        grid-template-columns:1fr 1fr;
    }

    .final-cta{
        margin:0 7% 90px;
        padding:50px 35px;
    }

    .footer{
        padding:40px 7%;
    }
}

@media(max-width:600px){

    .hero h1{
        font-size:55px;
    }

    .about-image,
    .about-image img{
        min-height:400px;
    }

    .values-grid{
        grid-template-columns:1fr;
    }

    .footer{
        display:block;
    }

    .footer div+div{
        margin-top:12px;
    }

}
/* =========================
   MOBILE NAVBAR FIX
========================= */

@media (max-width: 768px) {

    .navbar,
    .nav,
    header {
        width: 100%;
    }

    .nav-container,
    .navbar-container {
        padding: 0 20px;
    }

    .nav-menu,
    .nav-links {
        display: none;
    }

    .nav-menu.active,
    .nav-links.active {
        display: flex;
        flex-direction: column;
        position: absolute;
        top: 100%;
        left: 0;
        width: 100%;
        padding: 20px;
        gap: 18px;
        z-index: 999;
    }

    .menu-toggle,
    .hamburger {
        display: flex;
        cursor: pointer;
    }

    .nav-cta,
    .cta {
        width: 100%;
        text-align: center;
    }
}
/* =========================
   MOBILE OVERFLOW FIX
========================= */

html,
body {
    max-width: 100%;
    overflow-x: hidden;
}

img,
video {
    max-width: 100%;
    height: auto;
}

* {
    box-sizing: border-box;
}

@media (max-width: 768px) {
    .container {
        width: 100%;
        max-width: 100%;
        padding-left: 20px;
        padding-right: 20px;
    }

    section {
        max-width: 100%;
    }
}
.media-card-meta {
  display: flex;
  flex-direction: column;
  gap: 16px;
  min-width: 190px;
}

.media-card-meta div {
  cursor: pointer;
  color: rgba(255,255,255,.45);
  font: 500 9px "DM Mono";
  letter-spacing: .12em;
  transition: .25s ease;
  white-space: nowrap;
}

.media-card-meta div:hover {
  color: #fff;
  transform: translateX(-4px);
}

.media-card-meta div span {
  color: #8dbfff;
  margin-right: 8px;
}
/* =========================
   PROJECT ENQUIRY — COMPACT
========================= */

.contact-form-wrap {
    padding: 24px 28px;
}

.form-top {
    margin-bottom: 18px;
}

.form-field {
    margin-bottom: 14px;
}

.form-field label {
    margin-bottom: 6px;
}

.form-field input,
.form-field select,
.form-field textarea {
    padding: 10px 12px;
}

.form-field textarea {
    min-height: 90px;
    height: 90px;
    resize: vertical;
}

.contact-submit {
    margin-top: 4px;
    padding: 12px 16px;
}

/* Give the form more usable space */
.contact-grid {
    align-items: start;
}

.contact-form-wrap {
    max-height: fit-content;
}
@media (min-width: 769px) {
    .contact-form-wrap {
        transform: scale(0.94);
        transform-origin: top center;
        margin-bottom: -3%;
    }
}
/* ===== PROJECT ENQUIRY COMPACT ===== */

.contact-grid {
    align-items: start;
}

.contact-form-wrap {
    padding: 22px 24px;
    max-width: 520px;
    margin-left: auto;
}

.form-top {
    margin-bottom: 14px;
}

.form-field {
    margin-bottom: 11px;
}

.form-field label {
    display: block;
    margin-bottom: 5px;
}

.form-field input,
.form-field select {
    height: 38px;
    padding: 8px 11px;
}

.form-field textarea {
    height: 82px;
    min-height: 82px;
    padding: 9px 11px;
}

.contact-submit {
    padding: 10px 14px;
    margin-top: 2px;
}


/* Desktop — form ko thoda narrower rakho */
@media (min-width: 769px) {
    .contact-grid {
        grid-template-columns: minmax(0, 1.15fr) minmax(420px, 0.85fr);
        gap: 70px;
    }
}


/* Mobile */
@media (max-width: 768px) {
    .contact-form-wrap {
        max-width: 100%;
        padding: 20px;
        margin-left: 0;
    }

    .contact-grid {
        grid-template-columns: 1fr;
        gap: 35px;
    }
}
/* ===== PROJECT ENQUIRY — BALANCED SIZE ===== */

.contact-grid {
    align-items: start;
    gap: 55px;
}

.contact-form-wrap {
    padding: 26px 30px;
    max-width: 560px;
    margin-left: auto;
}

.form-top {
    margin-bottom: 18px;
}

.form-field {
    margin-bottom: 14px;
}

.form-field label {
    display: block;
    margin-bottom: 6px;
}

.form-field input,
.form-field select {
    height: 42px;
    padding: 9px 12px;
}

.form-field textarea {
    height: 105px;
    min-height: 105px;
    padding: 10px 12px;
}

.contact-submit {
    padding: 12px 16px;
    margin-top: 3px;
}


/* LEFT SIDE — give content more room */

.contact-info {
    max-width: 620px;
}

.contact-description {
    max-width: 540px;
    line-height: 1.7;
}


/* DESKTOP */

@media (min-width: 769px) {
    .contact-grid {
        grid-template-columns: minmax(0, 1.15fr) minmax(480px, 0.85fr);
    }
}


/* MOBILE */

@media (max-width: 768px) {
    .contact-grid {
        grid-template-columns: 1fr;
        gap: 35px;
    }

    .contact-form-wrap {
        max-width: 100%;
        margin-left: 0;
        padding: 24px 20px;
    }

    .contact-info {
        max-width: 100%;
    }
}
/* ===== PROJECT ENQUIRY — FINAL BALANCED ===== */

.contact-grid {
    align-items: start;
    gap: 48px;
}

.contact-form-wrap {
    padding: 28px 30px;
    max-width: 580px;
    margin-left: auto;

    /* brighter panel */
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.14);
}

.form-top {
    margin-bottom: 16px;
}

.form-top span {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.72);
}

/* LABELS */
.form-field label {
    display: block;
    margin-bottom: 5px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.78);
}

/* INPUTS */
.form-field {
    margin-bottom: 10px;
}

.form-field input,
.form-field select,
.form-field textarea {
    width: 100%;
    font-size: 14px;
    color: #ffffff;

    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.18);
}

/* INPUT HEIGHT */
.form-field input,
.form-field select {
    height: 43px;
    padding: 9px 12px;
}

/* MESSAGE */
.form-field textarea {
    height: 100px;
    min-height: 100px;
    padding: 10px 12px;
    line-height: 1.45;
}

/* PLACEHOLDER */
.form-field input::placeholder,
.form-field textarea::placeholder {
    color: rgba(255, 255, 255, 0.48);
}

/* DROPDOWN */
.form-field select {
    color: rgba(255, 255, 255, 0.9);
}

/* FOCUS */
.form-field input:focus,
.form-field select:focus,
.form-field textarea:focus {
    outline: none;
    border-color: rgba(150, 200, 255, 0.65);
    background: rgba(255, 255, 255, 0.09);
}

/* BUTTON */
.contact-submit {
    margin-top: 4px;
    padding: 12px 17px;
    font-size: 12px;
}

/* LEFT CONTENT */
.contact-info {
    max-width: 620px;
}

.contact-description {
    max-width: 560px;
    line-height: 1.65;
}

/* DESKTOP */
@media (min-width: 769px) {
    .contact-grid {
        grid-template-columns: minmax(0, 1.15fr) minmax(500px, 0.85fr);
    }
}

/* MOBILE */
@media (max-width: 768px) {

    .contact-grid {
        grid-template-columns: 1fr;
        gap: 32px;
    }

    .contact-form-wrap {
        max-width: 100%;
        margin-left: 0;
        padding: 24px 20px;
    }

    .form-field {
        margin-bottom: 12px;
    }
}
.contact-form-wrap {
    padding: 28px 30px;
    max-width: 620px;
    width: 100%;
    margin-left: auto;
}
.contact-grid {
    grid-template-columns: minmax(0, 1.05fr) minmax(540px, 0.95fr);
}
/* =========================================================
   GLOBAL READABILITY — BRIGHTER TEXT & BETTER CONTRAST
========================================================= */

/* Main body text */
body {
    color: rgba(255, 255, 255, 0.88);
}

/* Paragraphs / descriptions */
p {
    color: rgba(255, 255, 255, 0.78);
}

/* Headings */
h1,
h2,
h3,
h4,
h5,
h6 {
    color: rgba(255, 255, 255, 0.96);
}

/* Navigation */
.nav nav a,
nav a {
    color: rgba(255, 255, 255, 0.78);
}

.nav nav a:hover,
nav a:hover {
    color: #ffffff;
}

/* Small labels / kickers */
.kicker,
.contact-label,
.form-top span,
small {
    color: rgba(255, 255, 255, 0.72);
}

/* Secondary text */
.muted,
.subtitle,
.description,
.section-description {
    color: rgba(255, 255, 255, 0.74);
}

/* Links */
a {
    color: rgba(255, 255, 255, 0.84);
}

a:hover {
    color: #ffffff;
}

/* Buttons */
button,
.cta-button,
.nav-cta {
    color: #ffffff;
}

/* Inputs everywhere */
input,
textarea,
select {
    color: rgba(255, 255, 255, 0.94);
}

input::placeholder,
textarea::placeholder {
    color: rgba(255, 255, 255, 0.48);
}

/* Cards / service content */
.card p,
.service-card p,
.feature-card p,
.media-card p {
    color: rgba(255, 255, 255, 0.76);
}

/* Footer */
.site-footer {
    color: rgba(255, 255, 255, 0.68);
}

.site-footer a {
    color: rgba(255, 255, 255, 0.78);
}

/* Icons / secondary UI */
.icon,
.arrow,
.meta,
.meta-text {
    color: rgba(255, 255, 255, 0.72);
}
/* =========================================================
   FINAL GLOBAL TEXT VISIBILITY FIX
========================================================= */

/* BODY */
body {
    color: #f1f5f9 !important;
}

/* ALL NORMAL TEXT */
p,
li,
span,
label,
small {
    color: rgba(255, 255, 255, 0.82);
}

/* HEADINGS */
h1,
h2,
h3,
h4,
h5,
h6 {
    color: #ffffff !important;
}

/* NAVBAR */
.nav a,
.nav nav a,
nav a,
.brand-word {
    color: rgba(255, 255, 255, 0.88) !important;
}

.nav a:hover,
.nav nav a:hover,
nav a:hover {
    color: #ffffff !important;
}

/* NAV STATUS */
.nav-status,
.nav-status span {
    color: rgba(255, 255, 255, 0.78) !important;
}

/* HERO TEXT */
.hero p,
.hero-description,
.hero-subtitle,
.hero-copy p,
.intro p {
    color: rgba(255, 255, 255, 0.82) !important;
}

/* SECTION TEXT */
.section p,
.section-description,
.section-intro p,
.description {
    color: rgba(255, 255, 255, 0.80) !important;
}

/* KICKERS / LABELS */
.kicker,
.contact-label,
.section-label,
.eyebrow {
    color: rgba(255, 255, 255, 0.78) !important;
}

/* CARDS */
.card,
.card p,
.service-card,
.service-card p,
.feature-card,
.feature-card p,
.media-card,
.media-card p {
    color: rgba(255, 255, 255, 0.82) !important;
}

/* CARD HEADINGS */
.card h3,
.card h4,
.service-card h3,
.service-card h4,
.feature-card h3,
.feature-card h4 {
    color: #ffffff !important;
}

/* CONTACT PAGE */
.contact-info p,
.contact-description,
.contact-item p {
    color: rgba(255, 255, 255, 0.84) !important;
}

.contact-item small {
    color: rgba(255, 255, 255, 0.72) !important;
}

.contact-item a {
    color: rgba(255, 255, 255, 0.92) !important;
}

/* FORM */
.form-field label {
    color: rgba(255, 255, 255, 0.82) !important;
}

.form-field input,
.form-field select,
.form-field textarea {
    color: #ffffff !important;
    background: rgba(255, 255, 255, 0.075) !important;
    border-color: rgba(255, 255, 255, 0.22) !important;
}

.form-field input::placeholder,
.form-field textarea::placeholder {
    color: rgba(255, 255, 255, 0.58) !important;
}

/* FORM TOP */
.form-top span {
    color: rgba(255, 255, 255, 0.78) !important;
}

/* BUTTON TEXT */
button,
button span,
.cta-button,
.cta-button span,
.nav-cta,
.nav-cta span {
    color: #ffffff !important;
}

/* MEDIA / VIDEO TEXT */
.media-card-meta,
.media-card-meta div {
    color: rgba(255, 255, 255, 0.78) !important;
}

.media-card-meta span {
    color: #a8caff !important;
}

/* FOOTER */
.site-footer,
.site-footer div,
.site-footer p {
    color: rgba(255, 255, 255, 0.72) !important;
}

/* LINKS */
a {
    color: rgba(255, 255, 255, 0.86);
}

a:hover {
    color: #ffffff !important;
}

/* ICONS */
svg {
    opacity: 1;
}

/* =========================================================
   BETTER CONTRAST FOR DARK BACKGROUND
========================================================= */

.contact-form-wrap,
.card,
.service-card,
.feature-card {
    border-color: rgba(255, 255, 255, 0.14);
}

/* Don't let text become too dim on hover/normal states */
* {
    text-shadow: none;
}
/* TEXT OVER DARK MEDIA */
.hero-content,
.hero-copy,
.media-card-content,
.overlay-content {
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.75);
}
.media-card::after {
    background: linear-gradient(
        to top,
        rgba(0, 0, 0, 0.72),
        rgba(0, 0, 0, 0.18) 55%,
        transparent
    );
}
.service-grid {
    background: rgba(255,255,255,.07);
    border: 1px solid rgba(255,255,255,.08);
    box-shadow: 0 30px 100px rgba(0,0,0,.2);
}

.service {
    position: relative;
    overflow: hidden;

    background-image:
        linear-gradient(
            to bottom,
            rgba(5,10,18,.08),
            rgba(5,10,18,.78)
        ),
        var(--service-img);

    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;

    transition:
        transform .45s cubic-bezier(.2,.8,.2,1),
        background .45s;
}

.service:hover {
    transform: translateY(-6px);
    z-index: 2;
}

.service-number {
    color: #606772;
}

.service h3 {
    letter-spacing: -.045em;
}

.service p {
    line-height: 1.75;
}

.service-list li {
    border-color: rgba(255,255,255,.08);
}

.service-list li:before {
    background: var(--blue);
}

/* Keep card content above image */
.service > * {
    position: relative;
    z-index: 2;
}
/* ===== SERVICE PHOTOS — FINAL CLEAN ===== */

.service-grid-photo .service-photo {
    position: relative !important;
    overflow: hidden !important;
    isolation: isolate !important;
    background: #0b1017 !important;
}

.service-grid-photo .service-photo::before {
    content: "" !important;
    position: absolute !important;
    inset: 0 !important;
    z-index: 0 !important;

    background-image: var(--service-img) !important;
    background-size: cover !important;
    background-position: center !important;
    background-repeat: no-repeat !important;

    opacity: 1 !important;
    filter: brightness(1.08) saturate(1.05) contrast(1.02) !important;
}

.service-grid-photo .service-photo::after {
    content: "" !important;
    position: absolute !important;
    inset: 0 !important;
    z-index: 1 !important;

    background: linear-gradient(
        180deg,
        rgba(5,9,14,.08) 0%,
        rgba(5,9,14,.08) 35%,
        rgba(5,9,14,.40) 70%,
        rgba(5,9,14,.78) 100%
    ) !important;

    pointer-events: none !important;
}

.service-grid-photo .service-photo > * {
    position: relative !important;
    z-index: 2 !important;
}
/* FINAL SERVICE IMAGE FIX */

.service-grid-photo .service-photo {
    position: relative !important;
    overflow: hidden !important;
    background-size: cover !important;
    background-position: center !important;
    background-repeat: no-repeat !important;
}

/* Remove all old image pseudo-elements */
.service-grid-photo .service-photo::before {
    content: none !important;
}

.service-grid-photo .service-photo::after {
    content: "" !important;
    position: absolute !important;
    inset: 0 !important;
    z-index: 1 !important;
    background: linear-gradient(
        to bottom,
        rgba(5,10,18,.05),
        rgba(5,10,18,.70)
    ) !important;
    pointer-events: none !important;
}

/* Content above image */
.service-grid-photo .service-photo > * {
    position: relative !important;
    z-index: 2 !important;
}
/* Process / workflow section */

.process-step .num,
.process-step .circle {
    width: 48px;
    height: 48px;
    font-size: 13px;
}

.process-step h3 {
    font-size: 18px;
}

.process-step p {
    font-size: 13px;
    line-height: 1.7;
}

.process-step .step-number {
    font-size: 12px;
}
/* ===== PROCESS / HOW WE WORK — SLIGHTLY LARGER ===== */

.process-grid > div > span {
    font-size: 12px !important;
}

.process-grid > div > b {
    font-size: 17px !important;
    letter-spacing: .02em;
}

.process-grid > div > p {
    font-size: 13px !important;
    line-height: 1.7 !important;
}

/* make the circles bigger */
.process-grid > div .process-number,
.process-grid > div .step-number,
.process-grid > div .workflow-number,
.process-grid > div .number {
    width: 50px !important;
    height: 50px !important;
    font-size: 13px !important;
}
.process-grid > div > span {
    font-size: 13px !important;
    transform: scale(1.12);
    transform-origin: center;
}

.process-grid > div > b {
    font-size: 18px !important;
}

.process-grid > div > p {
    font-size: 13px !important;
}
/* ===== PROCESS / HOW WE WORK — LARGER ===== */

.process-grid > div > span {
    font-size: 14px !important;
    transform: scale(1.18);
    transform-origin: center;
}

.process-grid > div > b {
    font-size: 20px !important;
    letter-spacing: .02em;
}

.process-grid > div > p {
    font-size: 14px !important;
    line-height: 1.75 !important;
}
/* =========================================
   GLOBAL DESKTOP SCALE + SPACE BALANCE
   ========================================= */

@media (min-width: 901px) {

    /* Main body text */
    body {
        font-size: 16px;
    }

    /* Section headings */
    h1 {
        font-size: clamp(52px, 5vw, 78px) !important;
        line-height: .98 !important;
    }

    h2 {
        font-size: clamp(38px, 4vw, 58px) !important;
        line-height: 1.05 !important;
    }

    h3 {
        font-size: 22px !important;
        line-height: 1.15 !important;
    }

    /* Paragraphs */
    p {
        font-size: 15px;
        line-height: 1.7;
    }

    /* Small labels */
    .eyebrow,
    .section-label,
    .label,
    .kicker {
        font-size: 12px !important;
        letter-spacing: .12em;
    }

    /* Main content containers */
    .container,
    .wrap,
    .section-inner {
        max-width: 1280px;
    }

    /* Service cards */
    .service h3 {
        font-size: 24px !important;
    }

    .service p {
        font-size: 15px !important;
        line-height: 1.7 !important;
    }

    /* Workflow */
    .process-grid > div > b {
        font-size: 20px !important;
    }

    .process-grid > div > p {
        font-size: 14px !important;
    }

    /* Contact section */
    .contact-grid,
    .contact-section,
    .enquiry-grid {
        column-gap: 64px;
    }

    /* Left contact heading */
    .contact-section h1,
    .contact-section h2,
    .enquiry-section h1,
    .enquiry-section h2 {
        font-size: clamp(48px, 4.5vw, 68px) !important;
    }

    /* Left description */
    .contact-section p,
    .enquiry-section p {
        font-size: 16px !important;
        line-height: 1.75 !important;
    }

    /* Contact details */
    .contact-info,
    .contact-details {
        font-size: 15px;
    }

    .contact-info strong,
    .contact-details strong {
        font-size: 16px;
    }

    /* Form */
    .enquiry-form label,
    .contact-form label {
        font-size: 11px !important;
    }

    .enquiry-form input,
    .enquiry-form textarea,
    .enquiry-form select,
    .contact-form input,
    .contact-form textarea,
    .contact-form select {
        font-size: 14px !important;
        min-height: 48px;
    }

    .enquiry-form textarea,
    .contact-form textarea {
        min-height: 90px;
    }

    /* Buttons */
    button,
    .btn,
    .cta,
    .submit-btn {
        font-size: 13px !important;
    }

    /* Reduce excessive empty vertical space */
    section {
        padding-top: clamp(70px, 7vw, 110px);
        padding-bottom: clamp(70px, 7vw, 110px);
    }
}
/* ===== MOVING GREEN SERVICE LINE ===== */
/* =========================
   LANGUAGE SELECTOR
========================= */

.language-selector {
    position: relative;
    margin-right: 22px;
    z-index: 9999;
}

.language-current {
    height: 50px;
    min-width: 105px;
    padding: 0 16px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;

    border: 1px solid rgba(255,255,255,.35);
    border-radius: 12px;

    background: rgba(10,14,22,.85);
    color: #fff;

    font-family: "DM Mono", monospace;
    font-size: 12px;
    letter-spacing: .08em;

    cursor: pointer;
}

.language-current:hover {
    border-color: rgba(116,182,255,.8);
    background: rgba(116,182,255,.08);
}

.language-current b {
    font-size: 14px;
    font-weight: 400;
}

/* dropdown */

.language-menu {
    position: absolute;
    top: calc(100% + 4px);
    right: 0;

    width: 105px;

    display: none;
    flex-direction: column;

    overflow: hidden;
    border-radius: 12px;

    background: #111722;
    border: 1px solid rgba(255,255,255,.12);

    box-shadow: 0 20px 50px rgba(0,0,0,.45);
}

.language-selector.open .language-menu {
    display: flex;
}

.language-menu button {
    width: 100%;
    height: 48px;

    border: 0;
    border-bottom: 1px solid rgba(255,255,255,.06);

    background: transparent;
    color: #fff;

    text-align: left;
    padding: 0 16px;

    font-family: "DM Mono", monospace;
    font-size: 12px;

    cursor: pointer;
}

.language-menu button:hover {
    background: rgba(116,182,255,.14);
    color: #fff;
}

.language-menu button:last-child {
    border-bottom: 0;
}


/* Google Translate ka original UI hide */
#google_translate_element {
    display: none !important;
}

.goog-te-banner-frame.skiptranslate,
.goog-te-banner-frame {
    display: none !important;
}

body {
    top: 0 !important;
}

.goog-tooltip,
.goog-te-balloon-frame {
    display: none !important;
}
.language-menu button {
    display: flex;
    align-items: center;
    gap: 10px;
}

.language-menu button span,
.language-current .lang-flag {
    font-size: 17px;
    line-height: 1;
}

.language-current {
    display: flex;
    align-items: center;
    gap: 8px;
}
/* ===== REAL CSS FLAGS ===== */

.flag {
    width: 22px;
    height: 15px;
    display: inline-block;
    position: relative;
    flex-shrink: 0;
    border-radius: 2px;
    overflow: hidden;
    box-shadow: 0 0 0 1px rgba(255,255,255,.18);
}

/* USA */
.flag-us {
    background:
        repeating-linear-gradient(
            to bottom,
            #b22234 0 7.7%,
            #fff 7.7% 15.4%
        );
}

.flag-us::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    width: 42%;
    height: 54%;
    background: #3c3b6e;
}

/* France */
.flag-fr {
    background: linear-gradient(
        to right,
        #0055a4 0 33.33%,
        #fff 33.33% 66.66%,
        #ef4135 66.66%
    );
}

/* Germany */
.flag-de {
    background: linear-gradient(
        to bottom,
        #000 0 33.33%,
        #dd0000 33.33% 66.66%,
        #ffce00 66.66%
    );
}

/* Japan */
.flag-jp {
    background: #fff;
}

.flag-jp::before {
    content: "";
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #bc002d;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
}

/* China */
.flag-cn {
    background: #de2910;
}

.flag-cn::before {
    content: "★";
    position: absolute;
    color: #ffde00;
    font-size: 8px;
    left: 3px;
    top: 1px;
}

/* spacing */
.language-current,
.language-menu button {
    display: flex;
    align-items: center;
    gap: 9px;
}
.language-menu {
    max-height: 360px;
    overflow-y: auto;
}
/* ===== LANGUAGE FLAGS ===== */

.flag {
    width: 22px;
    height: 15px;
    display: inline-block;
    position: relative;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 2px;
    box-shadow: 0 0 0 1px rgba(255,255,255,.18);
}

/* USA */
.flag-us {
    background: repeating-linear-gradient(
        to bottom,
        #b22234 0 7.7%,
        #fff 7.7% 15.4%
    );
}
.flag-us::before {
    content: "";
    position: absolute;
    width: 42%;
    height: 54%;
    left: 0;
    top: 0;
    background: #3c3b6e;
}

/* France */
.flag-fr {
    background: linear-gradient(
        to right,
        #0055a4 0 33.33%,
        #fff 33.33% 66.66%,
        #ef4135 66.66%
    );
}

/* Germany */
.flag-de {
    background: linear-gradient(
        to bottom,
        #000 0 33.33%,
        #dd0000 33.33% 66.66%,
        #ffce00 66.66%
    );
}

/* Spain */
.flag-es {
    background: linear-gradient(
        to bottom,
        #aa151b 0 25%,
        #f1bf00 25% 75%,
        #aa151b 75%
    );
}

/* Italy */
.flag-it {
    background: linear-gradient(
        to right,
