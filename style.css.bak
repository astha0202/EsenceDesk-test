        #da291c 40%
    );
}

/* Netherlands */
.flag-nl {
    background: linear-gradient(
        to bottom,
        #ae1c28 0 33.33%,
        #fff 33.33% 66.66%,
        #21468b 66.66%
    );
}

/* Russia */
.flag-ru {
    background: linear-gradient(
        to bottom,
