}

/* China */
.flag-cn {
    background: #de2910;
}
.flag-cn::before {
    content: "★";
    position: absolute;
    color: #ffde00;
    font-size: 8px;
    left: 3px;
    top: 1px;
}

/* Turkey */
.flag-tr {
    background: #e30a17;
}
.flag-tr::before {
    content: "☪";
    position: absolute;
    color: #fff;
    font-size: 9px;
    left: 6px;
