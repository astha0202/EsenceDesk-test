    font-size: 8px;
    left: 3px;
    top: 2px;
}

/* India */
.flag-in {
    background: linear-gradient(
        to bottom,
        #ff9933 0 33.33%,
        #fff 33.33% 66.66%,
        #138808 66.66%
    );
}
.flag-in::before {
    content: "";
    position: absolute;
    width: 5px;
    height: 5px;
    border: 1px solid #000080;
    border-radius: 50%;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
}

/* Bangladesh */
.flag-bd {
    background: #006a4e;
}
.flag-bd::before {
    content: "";
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #f42a41;
    left: 43%;
    top: 50%;
    transform: translate(-50%, -50%);
}

/* Japan */
.flag-jp {
    background: #fff;
}
.flag-jp::before {
    content: "";
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
